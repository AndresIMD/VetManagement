<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VetManagement.Staff.UI</RootNamespace>
    <AssemblyName>VetManagement.Staff.UI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Pages\**\*.css">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <Content Update="Pages\**\*.css">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VetManagement.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VetManagement.Contracts\VetManagement.Contracts.csproj" />
    <ProjectReference Include="..\VetManagement.Domain\VetManagement.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.14" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The day of the build: with the commit, the version in the user menu (Services/App/AppVersion.cs). -->
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd'))" />
  </ItemGroup>

</Project>

@using System.Security.Claims
@using VetManagement.Staff.UI.Services.Api
@inject AccountApiService AccountService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ThemeService ThemeService
@inject VetManagement.Staff.UI.Models.Configuration.AppBranding Branding

<AuthorizeView>
    <Authorized>
        <MudAppBar Elevation="4" Class="mud-appbar-fixed appbar-elevated">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width:100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="ml-2">
                    <MudHidden Breakpoint="Breakpoint.LgAndUp">
                        <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Color="Color.Inherit" Dense="true">
                            <ActivatorContent Context="menuContext">
                                @* MudBlazor 9: a custom activator opens its menu itself. *@
                                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" aria-label="@L["Menu"]" OnClick="@(e => menuContext.ToggleAsync(e))" />
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem Href="/">@L["Home"]</MudMenuItem>
                                <MudDivider />
                                @foreach (var item in MenuItems)
                                {
                                    if (item.Visible(UserPerm))
                                    {
                                        if (item.Children != null && item.Children.Any(c => c.Visible(UserPerm)))
                                        {
                                            <MudMenuItem Disabled="true">@L[item.Title]</MudMenuItem>
                                            @foreach (var child in item.Children)
                                            {
                                                if (child.Visible(UserPerm))
                                                {
                                                    <MudMenuItem Href="@child.Href" Class="pl-4">@L[child.Title]</MudMenuItem>
                                                }
                                            }
                                            <MudDivider />
                                        }
                                        else if (!string.IsNullOrEmpty(item.Href))
                                        {
                                            <MudMenuItem Href="@item.Href">@L[item.Title]</MudMenuItem>
                                        }
                                    }
                                }
                            </ChildContent>
                        </MudMenu>
                    </MudHidden>
                    @* On a phone the bar has no room for it: the menu above holds the link home. *@
                    <MudHidden Breakpoint="Breakpoint.Xs">
                        <MudNavLink Href="/" Style="display:inline-block;">
                            @if (Branding.HasLogo)
                            {
                                <img src="@Branding.LogoUrl" alt="@L["Home"]" height="32" style="height:32px; width:auto; margin-right:10px;" />
                            }
                            else
                            {
                                <MudText Typo="Typo.subtitle1" Class="fw-bold" Style="margin-right:10px; white-space:nowrap;">VetManagement</MudText>
                            }
                        </MudNavLink>
                    </MudHidden>
                </MudStack>

                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1">
                        @foreach (var item in MenuItems)
                        {
                            if (item.Visible(UserPerm))
                            {
                                if (item.Children != null && item.Children.Any(c => c.Visible(UserPerm)))
                                {
                                    <NavDropdown Title="@L[item.Title]" Items="@item.Children!.Where(c => c.Visible(UserPerm)).Select(c => ((string)L[c.Title], c.Href))" />
                                }
                                else if (!string.IsNullOrEmpty(item.Href))
                                {
                                    <MudButton Href="@item.Href" Color="Color.Inherit" Variant="Variant.Text" Class="nav-dropdown-btn">@L[item.Title]</MudButton>
                                }
                            }
                        }
                    </MudStack>
                </MudHidden>

                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2" Class="ml-2">
                    <RealtimeConnectionIndicator />
                    <MudTooltip Text="@L["Toggle light/dark theme"]">
                        <MudIconButton Icon="@(_isDark? Icons.Material.Filled.DarkMode : Icons.Material.Filled.WbSunny)" Color="Color.Inherit" aria-label="@L["Toggle light/dark theme"]" OnClick="@(() => OnToggleDarkMode.InvokeAsync())" />
                    </MudTooltip>
                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.BottomRight" Color="Color.Inherit" Dense="true">
                        <ChildContent>
                            <MudMenuItem Disabled="true">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.body2">@user?.Identity?.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L[PrimaryRole]</MudText>
                                </MudStack>
                            </MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Href="profile" Icon="@Icons.Material.Filled.Person">@L["My profile"]</MudMenuItem>
                            <MudMenuItem OnClick="@LogoutAsync" Icon="@Icons.Material.Filled.Logout">@L["Logout"]</MudMenuItem>
                        </ChildContent>
                        <ActivatorContent Context="userMenuContext">
                            <MudIconButton aria-label="@L["My profile"]" Style="padding:0;" OnClick="@(e => userMenuContext.ToggleAsync(e))">
                                <MudAvatar Color="Color.Dark">@UserInitial</MudAvatar>
                            </MudIconButton>
                        </ActivatorContent>
                    </MudMenu>
                </MudStack>
            </MudStack>
        </MudAppBar>
    </Authorized>
    <NotAuthorized>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public EventCallback OnToggleDarkMode { get; set; }

    private ClaimsPrincipal? user;
    private string UserInitial => user?.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "?";
    private bool _isDark;

    private static bool HasPerm(ClaimsPrincipal? u, string perm) => u?.HasClaim("perm", perm) == true;
    private Func<string, bool> UserPerm => (p) => HasPerm(user, p);

    private static IEnumerable<MenuItem> MenuItems => AppNavigation.All;

    private AuthenticationStateChangedHandler? _authStateChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        _authStateChangedHandler = (task) => { _ = OnAuthStateChanged(task); };
        AuthStateProvider.AuthenticationStateChanged += _authStateChangedHandler;
        var initialState = await AuthStateProvider.GetAuthenticationStateAsync();
        user = initialState.User;
        ThemeService.OnChange += OnThemeChanged;
        _isDark = ThemeService.IsDarkMode;
    }

    private void OnThemeChanged() { _isDark = ThemeService.IsDarkMode; InvokeAsync(StateHasChanged); }

    private async Task OnAuthStateChanged(Task<AuthenticationState> task)
    { var authState = await task; user = authState.User; StateHasChanged(); }

    public void Dispose()
    {
        if (_authStateChangedHandler != null)
            AuthStateProvider.AuthenticationStateChanged -= _authStateChangedHandler;
        ThemeService.OnChange -= OnThemeChanged;
    }

    private string PrimaryRole => user?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "User";

    private async Task LogoutAsync()
    {
        await AccountService.LogoutAsync();
        if (AuthStateProvider is JwtAuthenticationStateProvider jwtProvider)
            jwtProvider.NotifyUserLogout();
        Navigation.NavigateTo("/login", true);
    }
}

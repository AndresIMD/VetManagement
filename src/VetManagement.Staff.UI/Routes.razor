<CascadingAuthenticationState>
    <TemporaryPasswordGate>
        <Router AppAssembly="@typeof(Layout.MainLayout).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                    <NotAuthorized>
                        <AuthorizeView>
                            <Authorized Context="authContext">
                                <MudPaper Class="pa-4 mt-6">
                                    <MudText Color="Color.Error" Typo="Typo.h6">
                                        @L["You don't have permission to access this page."]
                                    </MudText>
                                </MudPaper>
                            </Authorized>
                            <NotAuthorized Context="authContext">
                                <VetManagement.Staff.UI.Pages.Auth.Login />
                            </NotAuthorized>
                        </AuthorizeView>
                    </NotAuthorized>
                </AuthorizeRouteView>
            </Found>
        </Router>
    </TemporaryPasswordGate>
</CascadingAuthenticationState>

@page "/agenda/settings"
@using System.Text.Json
@using VetManagement.Contracts.Scheduling
@using VetManagement.Staff.UI.Components.Settings
@inject SchedulingApiService SchedulingApi
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Scheduling.Manage")]

<PageTitle>@L["Agenda Settings"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto px-2 mt-8">
    <PageHeader Title="@L["Agenda Settings"]" Icon="@Icons.Material.Filled.EditCalendar" />

    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
        @L["Every policy of the clinic's agenda lives in this document: services (each one enabled or disabled), vets and rooms with their weekly blocks, holidays and absences, booking, cancellation, refund and notification rules. Set \"enabled\": true when the real values are in place."]
        @L["See {0} for every field.", "docs/modules/SCHEDULING.md"]
    </MudAlert>

    <SettingsJsonEditor Load="LoadAsync" Save="SaveAsync" Saved="OnSaved" SavedMessage="@L["Agenda settings saved."]" />
</MudContainer>

@code {
    private async Task<(int Version, JsonElement Settings)?> LoadAsync()
        => await SchedulingApi.GetSettingsAsync() is { } d ? (d.Version, d.Settings) : null;

    private Task<ApiResult> SaveAsync(int version, JsonElement settings)
        => SchedulingApi.SaveSettingsAsync(new SchedulingSettingsDocument { Version = version, Settings = settings });

    private void OnSaved(ApiResult result)
    {
        var needReschedule = result.Body?.TryGetProperty("appointmentsNeedingReschedule", out var n) == true ? n.GetInt32() : 0;
        if (needReschedule > 0)
            Snackbar.Add(L["{0} appointment(s) fall on a closed day or absence and need rescheduling (see Agenda).", needReschedule], Severity.Warning);
    }
}

@page "/admin/users"
@using System.Security.Claims
@using VetManagement.Contracts.Accounts
@using VetManagement.Staff.UI.Components.Modals.Common
@using VetManagement.Staff.UI.Services.Api
@inject UserManagementApiService UserManagementService
@inject SessionRefresher Session
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize(Policy = "Users.Read")]

<PageTitle>@L["User Administration"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto px-2 mt-8">
    <PageHeader Title="@L["User Administration"]" Subtitle="@L["Staff accounts, their roles and access."]" Icon="@Icons.Material.Filled.People" />

    <MudPaper Class="pa-6 mb-4 elevation-3 rounded-lg app-surface">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["Click a role to assign or remove it. Block the accounts of staff who leave the clinic."]
            </MudText>
            @if (CanCreate)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="ShowCreateUserModal">
                    @L["New user"]
                </MudButton>
            }
        </MudStack>

        <MudTable TItem="UserDto" Items="@users" Loading="@_isLoading" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                  RowStyleFunc="@((u, _) => u.IsBlocked ? "opacity:0.6;" : string.Empty)">
            <HeaderContent>
                <MudTh>@L["User"]</MudTh>
                <MudTh>@L["Email"]</MudTh>
                <MudTh>@L["Status"]</MudTh>
                <MudTh>@L["Roles"]</MudTh>
                <MudTh Style="text-align:right">@L["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate Context="user">
                <MudTd DataLabel="@L["User"]">
                    @user.UserName
                    @if (user.Id == _myId)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-1">(@L["you"])</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="@L["Email"]">@user.Email</MudTd>
                <MudTd DataLabel="@L["Status"]">
                    @if (user.IsBlocked)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Block">@L["Blocked"]</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">@L["Active"]</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="@L["Roles"]">
                    @foreach (var role in allRoles)
                    {
                        <MudChip T="string" Size="Size.Small" Color="@(user.Roles.Contains(role) ? Color.Primary : Color.Default)"
                                 Variant="@(user.Roles.Contains(role) ? Variant.Filled : Variant.Outlined)"
                                 Disabled="@(!CanManageRoles)" OnClick="@(() => ToggleRole(user, role))">
                            @L[role]
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="@L["Actions"]" Style="text-align:right; white-space:nowrap;">
                    @if (CanUpdate)
                    {
                        <MudTooltip Text="@L["Edit"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(user))" />
                        </MudTooltip>
                        <MudTooltip Text="@L["Reset password"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Password" Size="Size.Small" OnClick="@(() => ResetPasswordAsync(user))" />
                        </MudTooltip>
                        @if (user.IsBlocked)
                        {
                            <MudTooltip Text="@L["Unblock"]">
                                <MudIconButton Icon="@Icons.Material.Filled.LockOpen" Size="Size.Small" Color="Color.Success" OnClick="@(() => SetBlockedAsync(user, false))" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="@L["Block"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Warning" Disabled="@(user.Id == _myId)"
                                               OnClick="@(() => SetBlockedAsync(user, true))" />
                            </MudTooltip>
                        }
                    }
                    @if (CanDelete)
                    {
                        <MudTooltip Text="@L["Delete"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" Disabled="@(user.Id == _myId)"
                                           OnClick="@(() => DeleteAsync(user))" />
                        </MudTooltip>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>@L["No users found."]</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudPaper>
</MudContainer>

@code {
    private List<UserDto> users = new();
    private List<string> allRoles = new();
    private bool _isLoading;
    private string? _myId;
    private bool CanCreate;
    private bool CanManageRoles;
    private bool CanUpdate;
    private bool CanDelete;

    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateTask).User;
        _myId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        CanCreate = user.HasClaim("perm", "users.create");
        CanManageRoles = user.HasClaim("perm", "users.roles.manage");
        CanUpdate = user.HasClaim("perm", "users.update");
        CanDelete = user.HasClaim("perm", "users.delete");
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            users = await UserManagementService.GetUsersAsync();
            allRoles = await UserManagementService.GetRolesAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleRole(UserDto user, string role)
    {
        if (!CanManageRoles) return;
        var removing = user.Roles.Contains(role);
        var result = removing
            ? await UserManagementService.RemoveRoleAsync(user.Id, role)
            : await UserManagementService.AssignRoleAsync(user.Id, role);
        if (!result.Ok)
        {
            Snackbar.Add(removing ? L["Could not remove role: {0}", result.Error ?? ""] : L["Could not assign role: {0}", result.Error ?? ""], Severity.Error);
            return;
        }
        if (removing) user.Roles.Remove(role); else user.Roles.Add(role);
        Snackbar.Add(removing ? L["Role '{0}' removed.", L[role]] : L["Role '{0}' assigned.", L[role]], Severity.Success);
        // Your own roles: menus update now instead of at the next refresh.
        if (user.Id == _myId)
            await Session.RefreshAsync();
    }

    private async Task ShowCreateUserModal()
    {
        var parameters = new DialogParameters { ["Roles"] = allRoles };
        var dialog = await DialogService.ShowAsync<CreateUserModal>(L["Create new user"], parameters);
        if (await dialog.Result is { Canceled: false })
            await LoadData();
    }

    private async Task EditAsync(UserDto user)
    {
        var parameters = new DialogParameters<EditUserModal> { { x => x.User, user } };
        var dialog = await DialogService.ShowAsync<EditUserModal>(L["Edit user"], parameters);
        if (await dialog.Result is { Canceled: false })
            await LoadData();
    }

    private async Task ResetPasswordAsync(UserDto user)
    {
        var parameters = new DialogParameters<ResetPasswordModal> { { x => x.User, user } };
        await DialogService.ShowAsync<ResetPasswordModal>(L["Reset password"], parameters);
    }

    private async Task SetBlockedAsync(UserDto user, bool blocked)
    {
        var confirmed = await ConfirmAsync(
            blocked ? L["Block user"] : L["Unblock user"],
            blocked
                ? L["Block '{0}'? They won't be able to sign in and their open sessions end within a minute. You can unblock them later.", user.UserName]
                : L["Unblock '{0}'? They will be able to sign in again with their roles.", user.UserName],
            blocked ? L["Block"] : L["Unblock"],
            blocked ? Color.Warning : Color.Success);
        if (!confirmed) return;

        var result = await UserManagementService.SetBlockedAsync(user.Id, blocked);
        if (result.Ok)
        {
            user.IsBlocked = blocked;
            Snackbar.Add(blocked ? L["User '{0}' blocked.", user.UserName] : L["User '{0}' unblocked.", user.UserName], Severity.Success);
        }
        else
            Snackbar.Add(L["Could not update the user: {0}", result.Error ?? ""], Severity.Error);
    }

    private async Task DeleteAsync(UserDto user)
    {
        var confirmed = await ConfirmAsync(L["Delete user"],
            L["Delete '{0}' permanently? This can't be undone. For staff who left the clinic, blocking the account is usually better.", user.UserName],
            L["Delete"], Color.Error);
        if (!confirmed) return;

        var result = await UserManagementService.DeleteUserAsync(user.Id);
        if (result.Ok)
        {
            users.Remove(user);
            Snackbar.Add(L["User '{0}' deleted.", user.UserName], Severity.Success);
        }
        else
            Snackbar.Add(L["Could not delete the user: {0}", result.Error ?? ""], Severity.Error);
    }

    private async Task<bool> ConfirmAsync(string title, string message, string confirmText, Color color)
    {
        var parameters = new DialogParameters<ConfirmModal>
        {
            { x => x.Title, title },
            { x => x.Message, message },
            { x => x.ButtonConfirmText, confirmText },
            { x => x.TitleIcon, Icons.Material.Filled.Warning },
            { x => x.TitleColor, color }
        };
        var dialog = await DialogService.ShowAsync<ConfirmModal>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small });
        return await dialog.Result is { Canceled: false };
    }
}

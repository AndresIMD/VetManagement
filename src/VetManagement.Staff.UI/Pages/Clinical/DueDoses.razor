@page "/clinical/due"
@using VetManagement.Contracts.Clinical
@inject ClinicalApiService ClinicalApi
@attribute [Authorize(Policy = "Medical.Read")]

<PageTitle>Vaccines Due</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto px-2 mt-8">
    <PageHeader Title="Vaccines and Deworming Due" Icon="@Icons.Material.Filled.Vaccines" />

    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
            <MudSelect T="int" Value="_days" ValueChanged="OnDaysChanged" Label="Due within" Style="max-width: 180px;">
                <MudSelectItem Value="7">7 days</MudSelectItem>
                <MudSelectItem Value="30">30 days</MudSelectItem>
                <MudSelectItem Value="90">90 days</MudSelectItem>
            </MudSelect>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Overdue doses are always listed. Owners with an email get an automatic reminder before the date (Clinical Settings).
            </MudText>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-3" Elevation="1">
        @if (_due is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudTable Items="_due" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Due</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Pet</MudTh>
                    <MudTh>Product</MudTh>
                    <MudTh>Owner</MudTh>
                    <MudTh>Contact</MudTh>
                    <MudTh>Reminder</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Dose.NextDueOn?.ToString("dd MMM yyyy")</MudTd>
                    <MudTd><DoseStatusChip Status="context.Dose.Status" /></MudTd>
                    <MudTd><MudLink Href="@($"clinical/pets/{context.Dose.PetId}")">@context.PetName</MudLink></MudTd>
                    <MudTd>@context.Dose.ProductName</MudTd>
                    <MudTd>@context.OwnerName</MudTd>
                    <MudTd>@context.OwnerPhone @(string.IsNullOrEmpty(context.OwnerEmail) ? "" : $"· {context.OwnerEmail}")</MudTd>
                    <MudTd>@(context.Dose.ReminderSentAtUtc is { } sent ? $"Sent {sent.ToLocalTime():dd MMM}" : "—")</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Typo="Typo.body2" Color="Color.Secondary">Nothing due in this period.</MudText></NoRecordsContent>
            </MudTable>
        }
    </MudPaper>
</MudContainer>

@code {
    private int _days = 30;
    private List<DueDoseDto>? _due;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task OnDaysChanged(int days)
    {
        _days = days;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _due = null;
        _due = await ClinicalApi.GetDueAsync(_days);
    }
}

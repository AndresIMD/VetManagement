@page "/clinical/due"
@using VetManagement.Contracts.Clinical
@inject ClinicalApiService ClinicalApi
@attribute [Authorize(Policy = "Medical.Read")]

<PageTitle>@L["Vaccines Due"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto px-2 mt-8">
    <PageHeader Title="@L["Vaccines and deworming due"]" Icon="@Icons.Material.Filled.Vaccines" />

    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
            <MudSelect T="int" Value="_days" ValueChanged="OnDaysChanged" Label="@L["Due within"]" Style="max-width: 180px;">
                <MudSelectItem Value="7">@L["7 days"]</MudSelectItem>
                <MudSelectItem Value="30">@L["30 days"]</MudSelectItem>
                <MudSelectItem Value="90">@L["90 days"]</MudSelectItem>
            </MudSelect>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @L["Overdue doses are always listed. Owners with an email get an automatic reminder before the date (Clinical Settings)."]
            </MudText>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-3" Elevation="1">
        @if (_due is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <MudTable Items="_due" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>@L["Due"]</MudTh>
                    <MudTh>@L["Status"]</MudTh>
                    <MudTh>@L["Pet"]</MudTh>
                    <MudTh>@L["Product"]</MudTh>
                    <MudTh>@L["Owner"]</MudTh>
                    <MudTh>@L["Contact"]</MudTh>
                    <MudTh>@L["Reminder"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Dose.NextDueOn?.ToString("dd MMM yyyy")</MudTd>
                    <MudTd><DoseStatusChip Status="context.Dose.Status" /></MudTd>
                    <MudTd><MudLink Href="@($"clinical/pets/{context.Dose.PetId}")">@context.PetName</MudLink></MudTd>
                    <MudTd>@context.Dose.ProductName</MudTd>
                    <MudTd>@context.OwnerName</MudTd>
                    <MudTd>@context.OwnerPhone @(string.IsNullOrEmpty(context.OwnerEmail) ? "" : $"· {context.OwnerEmail}")</MudTd>
                    <MudTd>@(context.Dose.ReminderSentAtUtc is { } sent ? L["Sent {0}", sent.ToLocalTime().ToString("dd MMM")].Value : "—")</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Typo="Typo.body2" Color="Color.Secondary">@L["Nothing due in this period."]</MudText></NoRecordsContent>
            </MudTable>
        }
    </MudPaper>
</MudContainer>

@code {
    private int _days = 30;
    private List<DueDoseDto>? _due;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task OnDaysChanged(int days)
    {
        _days = days;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _due = null;
        _due = await ClinicalApi.GetDueAsync(_days);
    }
}

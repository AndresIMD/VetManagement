@page "/login"
@attribute [AllowAnonymous]
@using VetManagement.Staff.UI.Services.Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AccountApiService AccountService
@inject AuthenticationStateProvider AuthStateProvider

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex flex-column align-center justify-center" Style="min-height:80vh;">
    <MudPaper Elevation="6" Class="pa-6" Style="width:100%; max-width:400px;">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">Sign in</MudText>
        <MudForm @ref="_mudForm" Model="_loginModel">
            <MudTextField Immediate="true" OnKeyDown="OnEnterDown" Variant="Variant.Outlined" T="string" @bind-Value="_loginModel.Username" Label="Username" Required="true" RequiredError="Username is required" Class="mb-3" Disabled="@_loading" />
            <MudTextField Immediate="true" OnKeyDown="OnEnterDown" Variant="Variant.Outlined" T="string" @bind-Value="_loginModel.Password" Label="Password" InputType="@_passwordInput" Required="true" RequiredError="Password is required" Class="mb-3" Disabled="@_loading" Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon" OnAdornmentClick="TogglePasswordVisibility" AdornmentAriaLabel="Show/Hide password" />
            <MudCheckBox T="bool" Value="_loginModel.RememberMe" ValueChanged="@((bool value) => { _loginModel.RememberMe = value; StateHasChanged(); })" Label="Remember me" Class="mb-3" Disabled="@_loading" />
            <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                <MudLoadingButton Loading="@_loading" OnClick="OnLogin">
                    Log in
                </MudLoadingButton>
            </MudStack>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private readonly LoginModel _loginModel = new();
    private MudForm? _mudForm;
    private bool _loading = false;
    private bool _isShow = false;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    private async Task OnLogin()
    {
        if (_mudForm != null)
        {
            await _mudForm.ValidateAsync();
            if (!_mudForm.IsValid)
                return;
        }

        _loading = true;
        StateHasChanged();
        string? token;
        try
        {
            token = await AccountService.LoginAsync(_loginModel.Username, _loginModel.Password, _loginModel.RememberMe);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Could not reach the server. Check your connection and try again.", Severity.Error);
            return;
        }
        finally
        {
            _loading = false;
        }

        if (!string.IsNullOrEmpty(token))
        {
            if (AuthStateProvider is JwtAuthenticationStateProvider jwtProvider)
                jwtProvider.NotifyUserAuthentication();
            if (AccountService.MustChangePassword)
            {
                Snackbar.Add("Password change required.", Severity.Info);
                Navigation.NavigateTo("/force-change-password", true);
            }
            else
            {
                Snackbar.Add("Login successful!", Severity.Success);
                Navigation.NavigateTo("/");
            }
        }
        else
        {
            Snackbar.Add("Invalid username or password.", Severity.Error);
        }
    }

    private async Task OnEnterDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await OnLogin();
        }
    }

    private void TogglePasswordVisibility()
    {
        if (_isShow)
        {
            _isShow = false;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _passwordInput = InputType.Password;
        }
        else
        {
            _isShow = true;
            _passwordInputIcon = Icons.Material.Filled.Visibility;
            _passwordInput = InputType.Text;
        }
    }

    public class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
        public bool RememberMe { get; set; }
    }
}

@page "/force-change-password"
@inject AccountApiService AccountApi
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@L["Change password"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center justify-center" Style="min-height:80vh;">
    <MudPaper Elevation="6" Class="pa-6" Style="width:100%; max-width:480px;">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">@L["Change your password"]</MudText>
        <MudForm @ref="_form">
            <MudTextField T="string" Label="@L["Current password"]" InputType="InputType.Password" @bind-Value="_current" Required="true" Class="mb-3" />
            <MudTextField T="string" Label="@L["New password"]" InputType="InputType.Password" @bind-Value="_new" Required="true" Class="mb-3" />
            <MudTextField T="string" Label="@L["Confirm new password"]" InputType="InputType.Password" @bind-Value="_confirm" Required="true" Class="mb-4" />
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnSubmit" Disabled="_busy">@L["Change password"]</MudButton>
            </MudStack>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private string _current = string.Empty;
    private string _new = string.Empty;
    private string _confirm = string.Empty;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        // Only for a session opened with a temporary password (see TemporaryPasswordGate).
        if (!await TemporaryPasswordGate.MustChangeAsync(AuthStateProvider))
            Nav.NavigateTo("/");
    }

    private async Task OnSubmit()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid) return;
        if (string.IsNullOrWhiteSpace(_current) || string.IsNullOrWhiteSpace(_new) || _new != _confirm)
        {
            Snackbar.Add(L["Password mismatch or missing fields"], Severity.Error);
            return;
        }
        _busy = true;
        try
        {
            var result = await AccountApi.ChangePasswordAsync(new VetManagement.Contracts.Accounts.ChangePasswordRequest
            {
                CurrentPassword = _current,
                NewPassword = _new
            });
            if (result.Ok)
            {
                Snackbar.Add(L["Password changed successfully"], Severity.Success);
                // The session goes on with the new token, which no longer asks for a change.
                if (AuthStateProvider is JwtAuthenticationStateProvider jwt)
                    jwt.NotifyUserAuthentication();
                Nav.NavigateTo("/");
            }
            else
                Snackbar.Add(L["Could not change password: {0}", result.Error ?? ""], Severity.Error);
        }
        finally { _busy = false; }
    }
}

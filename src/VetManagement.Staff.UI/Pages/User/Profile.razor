@page "/profile"
@using Microsoft.AspNetCore.Components.Authorization
@using VetManagement.Staff.UI.Services.Api
@using VetManagement.Contracts.Accounts
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject AccountApiService AccountApi

<PageTitle>@L["My profile"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center justify-center" Style="min-height:80vh;">
	<MudPaper Elevation="6" Class="pa-6" Style="width:100%; max-width:500px;">
		<MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">@L["My profile"]</MudText>

		@if (_isLoading)
		{
			<MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mx-auto" />
		}
		else
		{
			<MudForm @ref="_mudForm" Model="_profileModel">
				<MudTextField T="string" @bind-Value="_profileModel.Username" Label="@L["Username"]" Disabled="true" Class="mb-3" />
				<MudTextField T="string" @bind-Value="_profileModel.Email" Label="@L["Email"]" Required="true" RequiredError="@L["Email is required."]" Class="mb-3" />
				<MudStack Row="true" Spacing="2" Class="mb-4">
					<MudLoadingButton OnClick="OnSaveProfile"
									  Loading="@_saving"
									  Color="Color.Primary"
									  Variant="Variant.Filled"
									  LoadingText="@L["Saving..."]">
						@L["Save changes"]
					</MudLoadingButton>
				</MudStack>
			</MudForm>

			<MudDivider Class="my-4" />

			<MudText Typo="Typo.h6" Class="mb-2">@L["Change password"]</MudText>
			<MudForm @ref="_passwordForm" Model="_passwordModel">
				<MudTextField T="string" @bind-Value="_passwordModel.CurrentPassword" Label="@L["Current password"]" InputType="InputType.Password" Required="true" Class="mb-3" />
				<MudTextField T="string" @bind-Value="_passwordModel.NewPassword" Label="@L["New password"]" InputType="InputType.Password" Required="true" Class="mb-3" />
				<MudTextField T="string" @bind-Value="_passwordModel.ConfirmPassword" Label="@L["Confirm new password"]" InputType="InputType.Password" Required="true" Class="mb-3" />
				<MudStack Row="true" Spacing="2">
					<MudLoadingButton OnClick="OnChangePassword"
									  Loading="@_changingPassword"
									  Color="Color.Secondary"
									  Variant="Variant.Filled"
									  LoadingText="@L["Changing..."]">
						@L["Change password"]
					</MudLoadingButton>
				</MudStack>
			</MudForm>
		}
	</MudPaper>
</MudContainer>

@code {
	private MudForm _mudForm = default!;
	private MudForm _passwordForm = default!;
	private bool _isLoading = true;
	private bool _saving = false;
	private bool _changingPassword = false;

	private ProfileModel _profileModel = new();
	private ChangePasswordModel _passwordModel = new();

	protected override async Task OnInitializedAsync()
	{
		await LoadUserInfo();
	}

	private async Task LoadUserInfo()
	{
		_isLoading = true;
		try
		{
			var userInfo = await AccountApi.GetUserInfoAsync();
			if (userInfo != null)
			{
				_profileModel.Username = userInfo.Username;
				_profileModel.Email = userInfo.Email;
			}
			else
			{
				Snackbar.Add(L["Failed to load user information."], Severity.Error);
			}
		}
		catch (Exception ex)
		{
			Snackbar.Add(L["Error loading profile: {0}", ex.Message], Severity.Error);
		}
		finally
		{
			_isLoading = false;
		}
	}

	private async Task OnSaveProfile()
	{
        await _mudForm.ValidateAsync();
		if (!_mudForm.IsValid) return;

		_saving = true;
		try
		{
			var request = new UpdateUserRequest { Email = _profileModel.Email };
			var result = await AccountApi.UpdateUserInfoAsync(request);

			if (result.Ok)
			{
				Snackbar.Add(L["Profile updated successfully!"], Severity.Success);
			}
			else
			{
				Snackbar.Add(L["Failed to update profile: {0}", result.Error ?? ""], Severity.Error);
			}
		}
		catch (Exception ex)
		{
			Snackbar.Add(L["Error updating profile: {0}", ex.Message], Severity.Error);
		}
		finally
		{
			_saving = false;
		}
	}

	private async Task OnChangePassword()
	{
        await _passwordForm.ValidateAsync();
		if (!_passwordForm.IsValid) return;

		if (_passwordModel.NewPassword != _passwordModel.ConfirmPassword)
		{
			Snackbar.Add(L["Passwords do not match."], Severity.Error);
			return;
		}

		_changingPassword = true;
		try
		{
			var request = new ChangePasswordRequest
			{
				CurrentPassword = _passwordModel.CurrentPassword,
				NewPassword = _passwordModel.NewPassword
			};

			var result = await AccountApi.ChangePasswordAsync(request);

			if (result.Ok)
			{
				Snackbar.Add(L["Password changed successfully"], Severity.Success);
				// Clear the password fields
				_passwordModel = new ChangePasswordModel();
			}
			else
			{
				Snackbar.Add(L["Could not change password: {0}", result.Error ?? ""], Severity.Error);
			}
		}
		catch (Exception ex)
		{
			Snackbar.Add(L["Error changing password: {0}", ex.Message], Severity.Error);
		}
		finally
		{
			_changingPassword = false;
		}
	}

	public class ProfileModel
	{
		public string Username { get; set; } = string.Empty;
		public string Email { get; set; } = string.Empty;
	}

	public class ChangePasswordModel
	{
		public string CurrentPassword { get; set; } = string.Empty;
		public string NewPassword { get; set; } = string.Empty;
		public string ConfirmPassword { get; set; } = string.Empty;
	}
}

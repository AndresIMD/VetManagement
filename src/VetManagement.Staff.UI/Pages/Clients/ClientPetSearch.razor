@page "/client-search"
@using MudBlazor
@using VetManagement.Staff.UI.Helpers
@inject ClientPetApiService ClientPetService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@attribute [Authorize(Policy = "ClientsPets.List")]

<PageTitle>@L["Client and Pet Search"]</PageTitle>

<MudStack Spacing="2">
    <MudItem>
        <MudPaper Class="pa-4 mb-2" Elevation="1">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">@L["Filter by client"]</MudText>
                    <MudTextFilterField @bind-Value="FilterOwnerName" Label="@L["Owner first name"]" Class="mb-2" />
                    <MudTextFilterField @bind-Value="FilterOwnerLastName" Label="@L["Owner last name"]" Class="mb-2" />
                    <MudTextFilterField @bind-Value="FilterTaxId" Label="@L["Tax ID"]" Class="mb-2" />
                    <MudNumericField T="int?" Label="@L["Client ID"]" @bind-Value="FilterClientId" Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.subtitle2">@L["Filter by pet"]</MudText>
                    <MudTextFilterField @bind-Value="FilterPetName" Label="@L["Pet name"]" Class="mb-2" />
                    <MudNumericField T="int?" Label="@L["Pet ID"]" @bind-Value="FilterPetId" Immediate="true" />
                    <MudNumericField T="int?" Label="@L["Chip ID"]" @bind-Value="FilterChipId" Immediate="true" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>
</MudStack>

<MudStack Spacing="2">
    <MudItem>
        <MudTable T="ClientWithPetsResult" Items="@_filteredResults" Loading="@_isLoading" Striped="true"
                  Hover="true" Bordered="true" FixedHeader="true" RowsPerPage="25">
            <ToolBarContent>
                <MudSpacer />
                <MudTooltip Text="@L["Add client"]">
                    <MudIconButton Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Success" Size="Size.Medium"
                                   OnClick="ShowAddClientModal" />
                </MudTooltip>
                <MudTooltip Text="@L["Add pet"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Pets" Color="Color.Primary" Size="Size.Medium"
                                   OnClick="ShowAddPetModal" Disabled="@((_allClients?.Count ?? 0) == 0)" />
                </MudTooltip>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>@L["Client ID"]</MudTh>
                <MudTh>@L["Owner first name"]</MudTh>
                <MudTh>@L["Last name"]</MudTh>
                <MudTh>@L["Tax ID"]</MudTh>
                <MudTh>@L["Phone"]</MudTh>
                <MudTh>@L["Email"]</MudTh>
                <MudTh>@L["Pets"]</MudTh>
                <MudTh>@L["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Client ID"]">@context.ClientId</MudTd>
                <MudTd DataLabel="@L["Owner first name"]">@context.OwnerName</MudTd>
                <MudTd DataLabel="@L["Last name"]">@context.OwnerLastName</MudTd>
                <MudTd DataLabel="@L["Tax ID"]">@context.TaxId</MudTd>
                <MudTd DataLabel="@L["Phone"]">@context.PhoneNumber</MudTd>
                <MudTd DataLabel="@L["Email"]">@context.Email</MudTd>
                <MudTd DataLabel="@L["Pets"]">
                    @if (context.Pets.Any())
                    {
                        <ul class="mb-0">
                            @foreach (var pet in context.Pets)
                            {
                                <li>
                                    <b>@pet.Name</b> (@L["ID: {0}", pet.Id], @pet.Species.ToText(), @pet.Breed, @L["Chip: {0}", pet.ChipId])
                                    <MudTooltip Text="@L["Clinical record"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.MedicalInformation" Color="Color.Primary"
                                                       Size="Size.Small" Class="ml-1" Href="@($"clinical/pets/{pet.Id}")" />
                                    </MudTooltip>
                                    <MudTooltip Text="@L["Register exams"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.Biotech" Color="Color.Info"
                                                       Size="Size.Small" Class="ml-1" OnClick="@(() => GoToExamRequest(pet.Id))" />
                                    </MudTooltip>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">@L["No pets"]</span>
                    }
                </MudTd>
                <MudTd DataLabel="@L["Actions"]">
                    <MudTooltip Text="@L["Edit client"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled"
                                       Color="Color.Tertiary" Size="Size.Small" OnClick="@(() => ShowEditClientModal(context))" />
                    </MudTooltip>
                    <MudTooltip Text="@L["Delete client"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Filled" Color="Color.Error"
                                       Size="Size.Small" OnClick="@(() => ShowDeleteClientModal(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudItem>
</MudStack>

@code {
    // Data
    private List<Client>? _allClients = new List<Client>();
    private List<ClientWithPetsResult> _filteredResults = new List<ClientWithPetsResult>();
    private bool _isLoading;

    // Filters
    private string? _filterOwnerName;
    private string? _filterOwnerLastName;
    private string? _filterPetName;
    private string? _filterTaxId;
    private int? _filterClientId;
    private int? _filterPetId;
    private int? _filterChipId;

    // Properties for filters
    private string? FilterOwnerName
    {
        get => _filterOwnerName;
        set { _filterOwnerName = value; ApplyFilters(); }
    }
    private string? FilterOwnerLastName
    {
        get => _filterOwnerLastName;
        set { _filterOwnerLastName = value; ApplyFilters(); }
    }
    private string? FilterPetName
    {
        get => _filterPetName;
        set { _filterPetName = value; ApplyFilters(); }
    }
    private string? FilterTaxId
    {
        get => _filterTaxId;
        set { _filterTaxId = value; ApplyFilters(); }
    }
    private int? FilterClientId
    {
        get => _filterClientId;
        set { _filterClientId = value; ApplyFilters(); }
    }
    private int? FilterPetId
    {
        get => _filterPetId;
        set { _filterPetId = value; ApplyFilters(); }
    }
    private int? FilterChipId
    {
        get => _filterChipId;
        set { _filterChipId = value; ApplyFilters(); }
    }

    #region Initialization
    /// <summary>Opens filtered on one client, e.g. one just registered from an exam report.</summary>
    [SupplyParameterFromQuery(Name = "clientId")] public int? QueryClientId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _filterClientId = QueryClientId;
        await ReloadAndFilter();
    }
    #endregion

    #region Filters
    private async Task ReloadAndFilter(string? toastMessage = null)
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            _allClients = await ClientPetService.GetAllClientsAsync() ?? new List<Client>();
            ApplyFilters();
            if (!string.IsNullOrEmpty(toastMessage)) ShowToast(toastMessage);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        if (_allClients is null || !_allClients.Any())
        {
            _filteredResults = new List<ClientWithPetsResult>();
            return;
        }

        _filteredResults = _allClients
        .Where(client =>
        (string.IsNullOrWhiteSpace(_filterOwnerName) || StringExtensions.ContainsIgnoringAccents(client.Name, _filterOwnerName))
        && (string.IsNullOrWhiteSpace(_filterOwnerLastName) || StringExtensions.ContainsIgnoringAccents(client.LastName, _filterOwnerLastName))
        && (string.IsNullOrWhiteSpace(_filterTaxId) || StringExtensions.ContainsIgnoringAccents(client.TaxId, _filterTaxId))
        && (!_filterClientId.HasValue || client.Id == _filterClientId)
        && (
        string.IsNullOrWhiteSpace(_filterPetName) && !_filterPetId.HasValue && !_filterChipId.HasValue
        || client.Pets.Any(pet =>
        (string.IsNullOrWhiteSpace(_filterPetName) || StringExtensions.ContainsIgnoringAccents(pet.Name, _filterPetName))
        && (!_filterPetId.HasValue || pet.Id == _filterPetId)
        && (!_filterChipId.HasValue || pet.ChipId == _filterChipId)
        )
        )
        )
        .Select(client => new ClientWithPetsResult
        {
            ClientId = client.Id,
            OwnerName = client.Name,
            OwnerLastName = client.LastName,
            TaxId = client.TaxId,
            PhoneNumber = client.PhoneNumber,
            Email = client.Email,
            Pets = client.Pets
        .Where(pet =>
        (string.IsNullOrWhiteSpace(_filterPetName) || StringExtensions.ContainsIgnoringAccents(pet.Name, _filterPetName))
        && (!_filterPetId.HasValue || pet.Id == _filterPetId)
        && (!_filterChipId.HasValue || pet.ChipId == _filterChipId)
        )
        .ToList()
        })
        .ToList();
        StateHasChanged();
    }

    #endregion

    #region CRUD Modals
    private async Task ShowAddClientModal()
    {
        var parameters = new DialogParameters<ClientModal>
{
{ x => x.ClientModel, new Client() },
};
        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ClientModal>(L["Add client"], parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadAndFilter(L["Client added successfully."]);
    }
    private async Task ShowAddPetModal()
    {
        var list = _allClients ?? new List<Client>();
        var parameters = new DialogParameters<PetModal>
{
{ x => x.AllClients, list },
{ x => x.PetModel, new Pet { Name = string.Empty, Breed = string.Empty } }
};
        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<PetModal>(L["Add pet"], parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadAndFilter(L["Pet added successfully."]);
    }
    private async Task ShowEditClientModal(ClientWithPetsResult client)
    {
        var source = _allClients ?? new List<Client>();
        var parameters = new DialogParameters<ClientModal>
{
{ x => x.ClientModel, source.FirstOrDefault(c => c.Id == client.ClientId) ?? new Client() }
};
        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ClientModal>(L["Edit client"], parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadAndFilter(L["Client updated successfully."]);
    }
    private async Task ShowDeleteClientModal(ClientWithPetsResult client)
    {
        var parameters = new DialogParameters<ConfirmModal>
        {
            { x => x.Title, L["Delete client"].Value },
            { x => x.Message, L["Are you sure you want to delete client {0} {1}?", client.OwnerName, client.OwnerLastName].Value },
            { x => x.ButtonConfirmText, L["Delete"].Value },
            { x => x.ButtonCancelText, L["Cancel"].Value },
            { x => x.TitleIcon, Icons.Material.Filled.Delete },
            { x => x.TitleColor, Color.Error }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<ConfirmModal>(L["Delete client"], parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ClientPetService.DeleteClientAsync(client.ClientId);
            await ReloadAndFilter(L["Client deleted successfully."]);
        }
    }
    #endregion

    #region Functions
    private void ShowToast(string message, bool isError = false)
    => Snackbar.Add(message, isError ? Severity.Error : Severity.Success);

    private void GoToExamRequest(int petId)
    => Navigation.NavigateTo($"/exam-requests?petId={petId}&new=true");
    #endregion

    // Internal classes for search results
    private class ClientWithPetsResult
    {
        public int ClientId { get; init; }
        public string OwnerName { get; init; } = string.Empty;
        public string OwnerLastName { get; init; } = string.Empty;
        public string TaxId { get; init; } = string.Empty;
        public int PhoneNumber { get; init; }
        public string Email { get; init; } = string.Empty;
        public List<Pet> Pets { get; init; } = new List<Pet>();
    }
}

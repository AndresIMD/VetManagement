@page "/billing/settings"
@using System.Text.Json
@using VetManagement.Contracts.Billing
@using VetManagement.Staff.UI.Components.Settings
@inject BillingApiService BillingApi
@attribute [Authorize(Policy = "Billing.Manage")]

<PageTitle>Billing Settings</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto px-2 mt-8">
    <PageHeader Title="Billing Settings" Icon="@Icons.Material.Filled.PointOfSale" />

    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
        The clinic's billing policy: payment methods (rename them, turn them on or off, mark the ones counted
        in the cash drawer), the largest discount staff can give without an administrator, and whether selling
        a product takes it out of inventory. Never change a method's <code>code</code> once it was used.
        See <code>docs/architecture/BILLING.md</code>.
    </MudAlert>

    <SettingsJsonEditor Load="LoadAsync" Save="SaveAsync" SavedMessage="Billing settings saved." Lines="24" />
</MudContainer>

@code {
    private async Task<(int Version, JsonElement Settings)?> LoadAsync()
        => await BillingApi.GetSettingsAsync() is { } d ? (d.Version, d.Settings) : null;

    private Task<ApiResult> SaveAsync(int version, JsonElement settings)
        => BillingApi.SaveSettingsAsync(new BillingSettingsDocument { Version = version, Settings = settings });
}

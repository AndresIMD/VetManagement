@page "/billing/settings"
@using System.Text.Json
@using VetManagement.Contracts.Billing
@using VetManagement.Staff.UI.Components.Settings
@inject BillingApiService BillingApi
@attribute [Authorize(Policy = "Billing.Manage")]

<PageTitle>@L["Billing Settings"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto px-2 mt-8">
    <PageHeader Title="@L["Billing Settings"]" Icon="@Icons.Material.Filled.PointOfSale" />

    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
        @L["The clinic's billing policy: payment methods (rename them, turn them on or off, mark the ones counted in the cash drawer), the largest discount staff can give without an administrator, and whether selling a product takes it out of inventory. Never change a method's code once it was used."]
        @L["See {0} for every field.", "docs/modules/BILLING.md"]
    </MudAlert>

    <SettingsJsonEditor Load="LoadAsync" Save="SaveAsync" SavedMessage="@L["Billing settings saved."]" Lines="24" />
</MudContainer>

@code {
    private async Task<(int Version, JsonElement Settings)?> LoadAsync()
        => await BillingApi.GetSettingsAsync() is { } d ? (d.Version, d.Settings) : null;

    private Task<ApiResult> SaveAsync(int version, JsonElement settings)
        => BillingApi.SaveSettingsAsync(new BillingSettingsDocument { Version = version, Settings = settings });
}

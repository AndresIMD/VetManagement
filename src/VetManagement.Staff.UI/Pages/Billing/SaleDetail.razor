@page "/billing/sales/{Id:int}"
@using VetManagement.Contracts.Billing
@inject BillingApiService BillingApi
@inject SchedulingApiService SchedulingApi
@inject ItemsApiService ItemsApi
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize(Policy = "Billing.Read")]

<PageTitle>@L["Sale #{0}", Id]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto px-2 mt-8">
    <PageHeader Title="@L["Sale #{0}", Id]" Icon="@Icons.Material.Filled.Receipt" />
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Href="billing" Class="mb-2">@L["Sales"]</MudButton>

    @if (_sale is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudPaper Class="pa-3 mb-3" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="3">
                <MudText Typo="Typo.h6">@_sale.CustomerName</MudText>
                <SaleStatusChip Status="_sale.Status" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_sale.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm") · @_sale.CreatedBy</MudText>
                <MudSpacer />
                <MudText Typo="Typo.h6">@L["Total {0}", Money.Clp(_sale.Total)]</MudText>
                @if (_sale.TaxableTotal > 0 || _sale.ExemptTotal > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @if (_sale.TaxableTotal > 0)
                        {
                            <span>@L["Taxed {0} (net {1} + VAT {2}% {3})", Money.Clp(_sale.TaxableTotal), Money.Clp(_sale.TaxableNet), _sale.TaxRatePercent, Money.Clp(_sale.Vat)]</span>
                        }
                        @if (_sale.ExemptTotal > 0)
                        {
                            <span> · @L["Exempt {0}", Money.Clp(_sale.ExemptTotal)]</span>
                        }
                    </MudText>
                }
                <MudText Typo="Typo.h6" Color="@(_sale.Balance > 0 ? Color.Warning : Color.Success)">@L["Balance {0}", Money.Clp(_sale.Balance)]</MudText>
            </MudStack>
            @if (_sale.Status == SaleStatus.Voided)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@L["Voided: {0}", _sale.VoidReason ?? ""]</MudAlert>
            }
        </MudPaper>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
        }

        <MudPaper Class="pa-3 mb-3" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">@L["Items"]</MudText>
            <MudTable Items="_sale.Lines" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>@L["Description"]</MudTh>
                    <MudTh>@L["Kind"]</MudTh>
                    <MudTh Style="text-align:right">@L["Qty"]</MudTh>
                    <MudTh Style="text-align:right">@L["Price"]</MudTh>
                    <MudTh Style="text-align:right">@L["Discount"]</MudTh>
                    <MudTh Style="text-align:right">@L["Total"]</MudTh>
                    @if (CanEdit)
                    {
                        <MudTh />
                    }
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        @context.Description
                        @if (context.TaxExempt)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L["VAT exempt"]</MudChip>
                        }
                    </MudTd>
                    <MudTd>@context.Kind.ToText()</MudTd>
                    <MudTd Style="text-align:right">@context.Quantity</MudTd>
                    <MudTd Style="text-align:right">@Money.Clp(context.UnitPrice)</MudTd>
                    <MudTd Style="text-align:right">@(context.Discount > 0 ? Money.Clp(-context.Discount) : "")</MudTd>
                    <MudTd Style="text-align:right">@Money.Clp(context.Total)</MudTd>
                    @if (CanEdit)
                    {
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveLineAsync(context.Id)" />
                        </MudTd>
                    }
                </RowTemplate>
                <NoRecordsContent><MudText Typo="Typo.body2" Color="Color.Secondary">@L["No items yet."]</MudText></NoRecordsContent>
            </MudTable>

            @if (CanEdit)
            {
                <MudDivider Class="my-3" />
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Wrap="Wrap.Wrap">
                    <MudSelect T="SaleLineKind" @bind-Value="_line.Kind" Label="@L["Kind"]" Style="max-width: 130px;">
                        @foreach (var kind in Enum.GetValues<SaleLineKind>())
                        {
                            <MudSelectItem Value="kind">@kind.ToText()</MudSelectItem>
                        }
                    </MudSelect>
                    @switch (_line.Kind)
                    {
                        case SaleLineKind.Service:
                            <MudSelect T="string" @bind-Value="_line.ServiceCode" Label="@L["Service"]" Style="min-width: 220px;">
                                @foreach (var service in _services)
                                {
                                    <MudSelectItem Value="@service.Code">@service.Name</MudSelectItem>
                                }
                            </MudSelect>
                            break;
                        case SaleLineKind.Product:
                            <MudAutocomplete T="InventoryItemDTO" @bind-Value="_product" Label="@L["Product"]" SearchFunc="SearchItemsAsync"
                                             ToStringFunc="@(i => i is null ? "" : i.DailyUseStock <= 0 && i.AskAt.Count > 0 ? L["{0} (ask {1} · {2})", i.Name, string.Join(", ", i.AskAt), Money.Clp(i.SellPrice)].Value : L["{0} ({1} in stock · {2})", i.Name, i.DailyUseStock, Money.Clp(i.SellPrice)].Value)"
                                             DebounceInterval="300" MinCharacters="2" Style="min-width: 300px;" />
                            break;
                        default:
                            <MudTextField T="string" @bind-Value="_line.Description" Label="@L["Description"]" Style="min-width: 220px;" />
                            break;
                    }
                    <MudNumericField T="int" @bind-Value="_line.Quantity" Label="@L["Qty"]" Min="1" Style="max-width: 80px;" />
                    <MudNumericField T="int?" @bind-Value="_line.UnitPrice" Label="@(_line.Kind == SaleLineKind.Other ? L["Price"] : L["Price (catalog)"])" Min="0" Style="max-width: 140px;" />
                    <MudNumericField T="int" @bind-Value="_line.Discount" Label="@L["Discount $"]" Min="0" Style="max-width: 120px;" />
                    <MudSelect T="bool?" @bind-Value="_line.TaxExempt" Label="@L["VAT"]" Style="max-width: 130px;">
                        <MudSelectItem T="bool?" Value="null">@L["Default"]</MudSelectItem>
                        <MudSelectItem T="bool?" Value="false">@L["Taxed"]</MudSelectItem>
                        <MudSelectItem T="bool?" Value="true">@L["Exempt"]</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddLineAsync" Disabled="_busy">@L["Add"]</MudButton>
                </MudStack>
            }
        </MudPaper>

        <MudPaper Class="pa-3 mb-3" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">@L["Payments"]</MudText>
            <MudTable Items="_sale.Payments" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>@L["Method"]</MudTh>
                    <MudTh>@L["Reference"]</MudTh>
                    <MudTh>@L["Received"]</MudTh>
                    <MudTh Style="text-align:right">@L["Amount"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@MethodName(context.Method)</MudTd>
                    <MudTd>@context.Reference</MudTd>
                    <MudTd>@context.ReceivedAtUtc.ToLocalTime().ToString("dd MMM HH:mm") · @context.ReceivedBy</MudTd>
                    <MudTd Style="text-align:right">@Money.Clp(context.Amount)</MudTd>
                </RowTemplate>
                <NoRecordsContent><MudText Typo="Typo.body2" Color="Color.Secondary">@L["No payments yet."]</MudText></NoRecordsContent>
            </MudTable>

            @if (_sale.Status == SaleStatus.Open && _canCharge && _sale.Balance > 0)
            {
                <MudDivider Class="my-3" />
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Wrap="Wrap.Wrap">
                    <MudSelect T="string" @bind-Value="_payment.Method" Label="@L["Method"]" Style="min-width: 200px;">
                        @foreach (var method in _methods.Where(m => m.Enabled))
                        {
                            <MudSelectItem Value="@method.Code">@method.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField T="int" @bind-Value="_payment.Amount" Label="@L["Amount"]" Min="1" Max="_sale.Balance" Style="max-width: 160px;" />
                    <MudTextField T="string" @bind-Value="_payment.Reference" Label="@L["Voucher / reference"]" Style="max-width: 200px;" />
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Payments" OnClick="AddPaymentAsync" Disabled="_busy">@L["Take payment"]</MudButton>
                </MudStack>
            }
        </MudPaper>

        @if (_canManage && _sale.Status != SaleStatus.Voided)
        {
            <MudPaper Class="pa-3" Elevation="1">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                    <MudTextField T="string" @bind-Value="_voidReason" Label="@L["Reason to void"]" Style="min-width: 300px;" Immediate="true" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Block"
                               Disabled="@(string.IsNullOrWhiteSpace(_voidReason) || _busy)" OnClick="VoidAsync">@L["Void sale"]</MudButton>
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Products go back to stock. Days already closed can't be changed."]</MudText>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    private SaleDto? _sale;
    private List<CatalogService> _services = [];
    private List<PaymentMethodOption> _methods = [];
    private bool _canCharge;
    private bool _canManage;
    private bool _busy;
    private string? _error;
    private string? _voidReason;
    private InventoryItemDTO? _product;
    private LineForm _line = new();
    private PaymentForm _payment = new();

    private bool CanEdit => _sale?.Status == SaleStatus.Open && _canCharge;

    private sealed class LineForm
    {
        public SaleLineKind Kind { get; set; } = SaleLineKind.Service;
        public string? ServiceCode { get; set; }
        public string? Description { get; set; }
        public int Quantity { get; set; } = 1;
        public int? UnitPrice { get; set; }
        public int Discount { get; set; }
        public bool? TaxExempt { get; set; }
    }

    private sealed class PaymentForm
    {
        public string? Method { get; set; }
        public int Amount { get; set; }
        public string? Reference { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        _canCharge = user.HasClaim("perm", "billing.charge");
        _canManage = user.HasClaim("perm", "billing.manage");
        _methods = await BillingApi.GetPaymentMethodsAsync();
        _services = (await SchedulingApi.GetCatalogAsync()).Services.ToList(); // all of them: charging does not depend on the agenda module being on
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _sale = await BillingApi.GetSaleAsync(Id);
        _payment = new PaymentForm { Method = _methods.FirstOrDefault(m => m.Enabled)?.Code, Amount = _sale?.Balance ?? 0 };
    }

    private string MethodName(string code) => code == "OnlineDeposit"
        ? L["Online deposit"]
        : _methods.FirstOrDefault(m => string.Equals(m.Code, code, StringComparison.OrdinalIgnoreCase))?.Name ?? code;

    private async Task<IEnumerable<InventoryItemDTO>> SearchItemsAsync(string text, CancellationToken ct)
        => (await ItemsApi.GetItemsPagedAsync(text, ItemType.None, 0, 15, ct))?.Items ?? [];

    private Task AddLineAsync() => RunAsync(() => BillingApi.AddLineAsync(Id, new AddSaleLineRequest
    {
        Kind = _line.Kind,
        ServiceCode = _line.Kind == SaleLineKind.Service ? _line.ServiceCode : null,
        ItemId = _line.Kind == SaleLineKind.Product ? _product?.Id : null,
        Description = _line.Kind == SaleLineKind.Other ? _line.Description : null,
        Quantity = _line.Quantity,
        UnitPrice = _line.UnitPrice,
        Discount = _line.Discount,
        TaxExempt = _line.TaxExempt
    }), () => { _line = new LineForm { Kind = _line.Kind }; _product = null; });

    private Task RemoveLineAsync(int lineId) => RunAsync(() => BillingApi.RemoveLineAsync(Id, lineId));

    private Task AddPaymentAsync() => RunAsync(() => BillingApi.AddPaymentAsync(Id, new AddSalePaymentRequest
    {
        Method = _payment.Method ?? "",
        Amount = _payment.Amount,
        Reference = _payment.Reference
    }), () => Snackbar.Add(L["Payment registered."], Severity.Success));

    private Task VoidAsync() => RunAsync(() => BillingApi.VoidAsync(Id, _voidReason!), () => Snackbar.Add(L["Sale voided."], Severity.Warning));

    private async Task RunAsync(Func<Task<ApiResult>> call, Action? onSuccess = null)
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await call();
            if (!result.Ok)
            {
                _error = result.Error;
                return;
            }
            onSuccess?.Invoke();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}

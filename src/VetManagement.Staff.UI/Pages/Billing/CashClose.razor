@page "/billing/cash"
@using VetManagement.Contracts.Billing
@inject BillingApiService BillingApi
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize(Policy = "Billing.Read")]

<PageTitle>@L["Cash Close"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mx-auto px-2 mt-8">
    <PageHeader Title="@L["Cash Close"]" Icon="@Icons.Material.Filled.Calculate" />

    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudDatePicker Label="@L["Day"]" Date="_date" DateChanged="OnDateChanged" Style="max-width: 180px;" />
    </MudPaper>

    @if (_day is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudPaper Class="pa-3 mb-3" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">@L["Payments received"]</MudText>
            <MudTable Items="_day.Totals" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>@L["Method"]</MudTh>
                    <MudTh Style="text-align:right">@L["Payments"]</MudTh>
                    <MudTh Style="text-align:right">@L["Amount"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        @context.Name
                        @if (context.IsCash)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L["Drawer"]</MudChip>
                        }
                    </MudTd>
                    <MudTd Style="text-align:right">@context.Count</MudTd>
                    <MudTd Style="text-align:right">@Money.Clp(context.Amount)</MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd colspan="2"><b>@L["Total"]</b></MudTd>
                    <MudTd Style="text-align:right"><b>@Money.Clp(_day.Totals.Sum(t => t.Amount))</b></MudTd>
                </FooterContent>
                <NoRecordsContent><MudText Typo="Typo.body2" Color="Color.Secondary">@L["No payments this day."]</MudText></NoRecordsContent>
            </MudTable>
            <MudText Typo="Typo.subtitle1" Class="mt-3">@L["Expected cash in the drawer:"] <b>@Money.Clp(_day.ExpectedCash)</b></MudText>
        </MudPaper>

        @if (_day.IsClosed)
        {
            <MudAlert Severity="@(_day.Difference == 0 ? Severity.Success : Severity.Warning)">
                @L["Closed by {0} on {1}. Counted {2} · difference {3}.", _day.ClosedBy ?? "", _day.ClosedAtUtc?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "", Money.Clp(_day.CountedCash ?? 0), Money.Clp(_day.Difference ?? 0)]
                @if (!string.IsNullOrWhiteSpace(_day.Notes))
                {
                    <br />@_day.Notes
                }
            </MudAlert>
        }
        else if (_canCharge)
        {
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">@L["Close the day"]</MudText>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Wrap="Wrap.Wrap">
                    <MudNumericField T="int" @bind-Value="_counted" Label="@L["Cash counted"]" Min="0" Style="max-width: 180px;" Immediate="true" />
                    <MudText Typo="Typo.body1" Color="@(_counted == _day.ExpectedCash ? Color.Success : Color.Warning)">
                        @L["Difference {0}", Money.Clp(_counted - _day.ExpectedCash)]
                    </MudText>
                </MudStack>
                <MudTextField T="string" @bind-Value="_notes" Label="@L["Notes (explain any difference)"]" Lines="2" Class="mt-2" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Lock" Class="mt-3"
                           Disabled="_busy" OnClick="CloseAsync">@L["Close day"]</MudButton>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                    @L["After closing, this day takes no more payments and its sales can't be voided."]
                </MudText>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    private DateTime? _date = DateTime.Today;
    private DaySummaryDto? _day;
    private int _counted;
    private string? _notes;
    private bool _busy;
    private bool _canCharge;

    protected override async Task OnInitializedAsync()
    {
        _canCharge = (await AuthStateProvider.GetAuthenticationStateAsync()).User.HasClaim("perm", "billing.charge");
        await LoadAsync();
    }

    private async Task OnDateChanged(DateTime? date)
    {
        _date = date ?? DateTime.Today;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _day = null;
        _day = await BillingApi.GetDayAsync(DateOnly.FromDateTime(_date ?? DateTime.Today));
        _counted = _day?.ExpectedCash ?? 0;
        _notes = null;
    }

    private async Task CloseAsync()
    {
        _busy = true;
        var result = await BillingApi.CloseDayAsync(new CloseDayRequest { Date = _day!.Date, CountedCash = _counted, Notes = _notes });
        _busy = false;
        if (result.Ok)
        {
            Snackbar.Add(L["Day closed."], Severity.Success);
            await LoadAsync();
        }
        else
            Snackbar.Add(result.Error ?? L["Could not close the day."], Severity.Error);
    }
}

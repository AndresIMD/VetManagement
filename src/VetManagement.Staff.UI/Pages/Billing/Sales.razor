@page "/billing"
@using VetManagement.Contracts.Billing
@inject BillingApiService BillingApi
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize(Policy = "Billing.Read")]

<PageTitle>Sales</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mx-auto px-2 mt-8">
    <PageHeader Title="Sales" Icon="@Icons.Material.Filled.PointOfSale" />

    <MudPaper Class="pa-3 mb-3" Elevation="1">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudDatePicker Label="Date" Date="_date" DateChanged="OnDateChanged" Style="max-width: 180px;" />
            <MudSelect T="SaleStatus?" Label="Status" Value="_status" ValueChanged="OnStatusChanged" Clearable="true" Style="max-width: 180px;">
                @foreach (var status in Enum.GetValues<SaleStatus>())
                {
                    <MudSelectItem T="SaleStatus?" Value="status">@status</MudSelectItem>
                }
            </MudSelect>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Calculate" Href="billing/cash">Cash close</MudButton>
            @if (_canCharge)
            {
                <MudTextField T="string" @bind-Value="_customerName" Label="Customer name" Style="max-width: 240px;" Immediate="true"
                              OnKeyUp="@(e => e.Key == "Enter" ? CreateAsync() : Task.CompletedTask)" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@(string.IsNullOrWhiteSpace(_customerName) || _creating)" OnClick="CreateAsync">New sale</MudButton>
            }
        </MudStack>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_error</MudAlert>
        }
    </MudPaper>

    <MudPaper Class="pa-3" Elevation="1">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_sales.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No sales on this day. Charge an appointment from the Agenda, or open a counter sale above.</MudText>
        }
        else
        {
            <MudTable Items="_sales" Dense="true" Hover="true" Elevation="0" OnRowClick="@((TableRowClickEventArgs<SaleDto> e) => Navigation.NavigateTo($"billing/sales/{e.Item!.Id}"))" T="SaleDto" Style="cursor: pointer;">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Time</MudTh>
                    <MudTh>Customer</MudTh>
                    <MudTh Style="text-align:right">Total</MudTh>
                    <MudTh Style="text-align:right">Paid</MudTh>
                    <MudTh Style="text-align:right">Balance</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Id</MudTd>
                    <MudTd>@context.CreatedAtUtc.ToLocalTime().ToString("HH:mm")</MudTd>
                    <MudTd>
                        @context.CustomerName
                        @if (context.AppointmentId is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Appointment</MudChip>
                        }
                    </MudTd>
                    <MudTd Style="text-align:right">@Money.Clp(context.Total)</MudTd>
                    <MudTd Style="text-align:right">@Money.Clp(context.PaidAmount)</MudTd>
                    <MudTd Style="text-align:right">@Money.Clp(context.Balance)</MudTd>
                    <MudTd><SaleStatusChip Status="context.Status" /></MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd colspan="3"><b>Total (not voided)</b></MudTd>
                    <MudTd Style="text-align:right"><b>@Money.Clp(_sales.Where(s => s.Status != SaleStatus.Voided).Sum(s => s.Total))</b></MudTd>
                    <MudTd Style="text-align:right"><b>@Money.Clp(_sales.Where(s => s.Status != SaleStatus.Voided).Sum(s => s.PaidAmount))</b></MudTd>
                    <MudTd Style="text-align:right"><b>@Money.Clp(_sales.Where(s => s.Status != SaleStatus.Voided).Sum(s => s.Balance))</b></MudTd>
                    <MudTd />
                </FooterContent>
            </MudTable>
        }
    </MudPaper>
</MudContainer>

@code {
    private DateTime? _date = DateTime.Today;
    private SaleStatus? _status;
    private List<SaleDto> _sales = [];
    private bool _loading = true;
    private bool _canCharge;
    private bool _creating;
    private string? _customerName;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _canCharge = (await AuthStateProvider.GetAuthenticationStateAsync()).User.HasClaim("perm", "billing.charge");
        await LoadAsync();
    }

    private async Task OnDateChanged(DateTime? date)
    {
        _date = date ?? DateTime.Today;
        await LoadAsync();
    }

    private async Task OnStatusChanged(SaleStatus? status)
    {
        _status = status;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var day = DateOnly.FromDateTime(_date ?? DateTime.Today);
        _sales = await BillingApi.GetSalesAsync(day, day, _status);
        _loading = false;
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_customerName) || _creating)
            return;
        _creating = true;
        _error = null;
        var result = await BillingApi.CreateSaleAsync(new CreateSaleRequest { CustomerName = _customerName });
        _creating = false;
        if (result.Ok)
            Navigation.NavigateTo($"billing/sales/{result.Id}");
        else
            _error = result.Error;
    }
}

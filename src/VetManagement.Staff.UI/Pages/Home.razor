@page "/"
@using MudBlazor
@using VetManagement.Staff.UI.Layout
@using VetManagement.Staff.UI.Services.Api
@inject VetManagement.Staff.UI.Services.Api.ItemsApiService ItemsService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@L["Home"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <PageHeader Title="@L["Main panel"]" Icon="@Icons.Material.Filled.Dashboard" />

    @if (_noAccess)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">@L["Your account has no roles yet. Ask an administrator to assign the roles you need."]</MudAlert>
    }

    <MudGrid Spacing="4">
        @foreach (var area in _areas)
        {
            <MudItem xs="6" md="3">
                @* The most used area this user can reach is the page's one accent. *@
                <MudButton Href="@area.MainHref(_can)" Variant="Variant.Outlined" Color="@(area == _areas[0] ? Color.Primary : Color.Default)"
                           StartIcon="@area.Icon" Size="Size.Large" FullWidth="true" Class="home-area">@L[area.Title]</MudButton>
            </MudItem>
        }
    </MudGrid>

    @* Below the links, so they don't move when the alerts arrive. *@
    @if (_canSeeInventory)
    {
        <MudStack Spacing="2" Class="mt-8">
            @if (_loading)
            {
                <MudSkeleton Height="48px" />
            }
            else if (_alertsFailed)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@L["Could not load the inventory alerts."]</MudAlert>
            }
            else if (_outOfStockCount == 0 && _lowStockCount == 0)
            {
                <MudText Typo="Typo.body2">@L["No inventory alerts"]</MudText>
            }
            else
            {
                @if (_outOfStockCount > 0)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-primary);">@L["Out of stock items! ({0})", _outOfStockCount]</MudText>
                            <MudButton Href="inventory-items?alert=zero" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">@L["View details"]</MudButton>
                        </MudStack>
                    </MudAlert>
                }
                @if (_lowStockCount > 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-primary);">@L["Low stock items ({0})", _lowStockCount]</MudText>
                            <MudButton Href="inventory-items?alert=low" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">@L["View details"]</MudButton>
                        </MudStack>
                    </MudAlert>
                }
            }
        </MudStack>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private bool _noAccess;
    private bool _canSeeInventory;
    private bool _alertsFailed;
    private List<MenuItem> _areas = [];
    private Func<string, bool> _can = _ => false;
    private int _lowStockCount;
    private int _outOfStockCount;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        _noAccess = !user.HasClaim(c => c.Type == "perm");
        _can = perm => user.HasClaim("perm", perm);
        _areas = AppNavigation.Areas.Where(area => area.Visible(_can)).ToList();
        _canSeeInventory = _can("inventory.read");
        if (!_canSeeInventory)
        {
            _loading = false;
            return;
        }

        var items = await LoadItemsAsync();
        if (items != null)
        {
            var drugLow = items
                .OfType<Drug>()
                .Where(d => !string.IsNullOrWhiteSpace(d.Compound))
                .GroupBy(d => d.Compound!.Trim(), StringComparer.OrdinalIgnoreCase)
                .Select(g => new
                {
                    Total = g.Sum(d => d.Stock),
                    MinThreshold = g.Select(d => d.LowStockThreshold).Where(t => t > 0).DefaultIfEmpty(0).Min()
                })
                .Count(x => x.MinThreshold > 0 && x.Total > 0 && x.Total <= x.MinThreshold);

            var nonDrugLow = items
                .Where(i => i is not Drug)
                .Count(i => i.LowStockThreshold > 0 && i.Stock > 0 && i.Stock <= i.LowStockThreshold);

            _lowStockCount = drugLow + nonDrugLow;

            var drugZero = items
                .OfType<Drug>()
                .Where(d => !string.IsNullOrWhiteSpace(d.Compound))
                .GroupBy(d => d.Compound!.Trim(), StringComparer.OrdinalIgnoreCase)
                .Count(g => g.Sum(d => d.Stock) == 0);

            var nonDrugZero = items.Count(i => i is not Drug && i.Stock == 0);

            _outOfStockCount = drugZero + nonDrugZero;
        }
        else
        {
            _alertsFailed = true;
        }
        _loading = false;
    }

    // The home page has to work without the alerts: it's the way to everything else.
    private async Task<List<Item>?> LoadItemsAsync()
    {
        try
        {
            return await ItemsService.GetAllItemsAsync();
        }
        catch (HttpRequestException)
        {
            return null;
        }
    }
}

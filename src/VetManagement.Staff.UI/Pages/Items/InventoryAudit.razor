@page "/inventory-audit"
@inject InventoryMovementApiService InventoryService
@inject AuditApiService AuditService
@inject ItemsApiService ItemService
@attribute [Authorize(Policy = "Audit.Read")]

@using VetManagement.Staff.UI.Components.Filters
@using VetManagement.Staff.UI.Components.Audit
@using VetManagement.Staff.UI.Components.Inputs
@using VetManagement.Domain.Enums
@using VetManagement.Staff.UI.Helpers
@using VetManagement.Staff.UI.Models.Audit
@using VetManagement.Staff.UI.Models.DTOs

<PageTitle>@L["Inventory History"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto px-2 mt-8">
    <PageHeader Title="@L["Inventory Audit"]" Icon="@Icons.Material.Filled.HistoryEdu" />
    <FilterPanel ActiveFilterCount="@GetActiveFilterCount()" OnClear="ClearFilters" IsLoading="false">
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="FilterItemName" Label="@L["Search item name..."]" Variant="Variant.Outlined"
                Clearable="true" Immediate="true" DebounceInterval="400" Adornment="Adornment.Start"
                AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudTextField @bind-Value="FilterResponsible" Label="@L["Responsible / User"]" Variant="Variant.Outlined"
                Clearable="true" Immediate="true" DebounceInterval="400" Adornment="Adornment.Start"
                AdornmentIcon="@Icons.Material.Filled.Person" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudEnumMultiSelect TEnum="AuditActionType" SelectedItems="@FilterActions"
                SelectedItemsChanged="@(actions => FilterActions = actions)"
                AllowedValues="@AuditActionHelper.GetInventoryActions()" Label="@L["Type / Action"]"
                Variant="Variant.Outlined" Adornment="Adornment.Start"
                AdornmentIcon="@Icons.Material.Filled.FilterAlt" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <DateRangeFilter @bind-DateRange="FilterDateRange" Label="@L["Date Range"]" />
        </MudItem>
    </FilterPanel>
</MudContainer>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto px-2">
    <MudTable @ref="_table" T="AuditLog" ServerData="LoadServerData" Striped="true" Hover="true" Bordered="true"
        FixedHeader="true" Dense="true">
        <ToolBarContent></ToolBarContent>
        <HeaderContent>
            <MudTh Style="width: 150px;">@L["Date"]</MudTh>
            <MudTh Style="width: 120px;">@L["Action"]</MudTh>
            <MudTh Style="width: 150px;">@L["User"]</MudTh>
            <MudTh Style="width: 150px;">@L["Item"]</MudTh>
            <MudTh>@L["Changes"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["Date"]">@context.Date.ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd DataLabel="@L["Action"]">
                <MudChip T="string" Size="Size.Small" Color="GetActionColor(context.Action)" Variant="Variant.Text">
                    @context.Action.ToText()
                </MudChip>
            </MudTd>
            <MudTd DataLabel="@L["User"]">@context.User</MudTd>
            <MudTd DataLabel="@L["Item"]">@GetItemName(context.EntityId)</MudTd>
            <MudTd DataLabel="@L["Changes"]">
                <AuditChangesDisplay RawChanges="@context.Changes" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-8">
                <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" Color="Color.Secondary"
                    Style="font-size: 4rem;" />
                <MudText Typo="Typo.h6" Color="Color.Secondary">@L["No audit logs found"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Tertiary" Align="Align.Center">
                    @if (GetActiveFilterCount() > 0)
                    {
                        @L["Try adjusting your filters or clear them to see all logs."]
                    }
                    else
                    {
                        @L["No audit records are available for this inventory."]
                    }
                </MudText>
            </MudStack>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    private MudTable<AuditLog>? _table;
    private Dictionary<int, string> _itemNames = new();

    private string _filterItemName = "";
    private string FilterItemName
    {
        get => _filterItemName;
        set
        {
            if (_filterItemName != value)
            {
                _filterItemName = value;
                _ = (_table?.ReloadServerData() ?? Task.CompletedTask);
            }
        }
    }

    private List<AuditActionType> _filterActions = [];
    private List<AuditActionType> FilterActions
    {
        get => _filterActions;
        set
        {
            if (_filterActions != value)
            {
                _filterActions = value;
                _ = (_table?.ReloadServerData() ?? Task.CompletedTask);
            }
        }
    }

    private string _filterResponsible = "";
    private string FilterResponsible
    {
        get => _filterResponsible;
        set
        {
            if (_filterResponsible != value)
            {
                _filterResponsible = value;
                _ = (_table?.ReloadServerData() ?? Task.CompletedTask);
            }
        }
    }

    private DateRange? _filterDateRange;
    private DateRange? FilterDateRange
    {
        get => _filterDateRange;
        set
        {
            if (_filterDateRange != value)
            {
                _filterDateRange = value;
                _ = (_table?.ReloadServerData() ?? Task.CompletedTask);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAllItemsAsync();
    }

    private async Task LoadAllItemsAsync()
    {
        var allItems = await ItemService.GetAllItemsAsync();
        if (allItems != null)
        {
            _itemNames = allItems.ToDictionary(i => i.Id, i => i.Name);
        }
    }

    /// <summary>
    /// One page from the API, which filters and pages the log. The item name is matched here against the item list and
    /// sent as the ids of the matching items.
    /// </summary>
    private async Task<TableData<AuditLog>> LoadServerData(TableState state, CancellationToken ct)
    {
        List<int>? itemIds = null;
        if (!string.IsNullOrWhiteSpace(FilterItemName))
        {
            var name = FilterItemName.Trim();
            itemIds = _itemNames.Where(i => i.Value.Contains(name, StringComparison.OrdinalIgnoreCase)).Select(i => i.Key).ToList();
            if (itemIds.Count == 0)
                return new TableData<AuditLog> { Items = [], TotalItems = 0 };
        }

        var result = await AuditService.GetLogsPagedAsync(
            page: state.Page,
            pageSize: state.PageSize,
            entityName: "Item",
            actions: FilterActions,
            user: string.IsNullOrWhiteSpace(FilterResponsible) ? null : FilterResponsible,
            from: FilterDateRange?.Start?.Date,
            to: FilterDateRange?.End?.Date.AddDays(1).AddTicks(-1),
            entityIds: itemIds,
            ct: ct);

        return new TableData<AuditLog> { Items = result?.Items ?? [], TotalItems = result?.TotalCount ?? 0 };
    }

    private void ClearFilters()
    {
        _filterItemName = "";
        _filterActions = [];
        _filterResponsible = "";
        _filterDateRange = null;
        _ = (_table?.ReloadServerData() ?? Task.CompletedTask);
    }

    private int GetActiveFilterCount()
    {
        int count = 0;
        if (!string.IsNullOrWhiteSpace(FilterItemName)) count++;
        if (!string.IsNullOrWhiteSpace(FilterResponsible)) count++;
        if (FilterActions.Any()) count++;
        if (FilterDateRange != null) count++;
        return count;
    }

    private string GetItemName(int entityId)
    {
        if (_itemNames.TryGetValue(entityId, out var name))
            return name;
        return $"ID {entityId}";
    }

    private Color GetActionColor(AuditActionType action) => action switch
    {
        AuditActionType.Add => Color.Success,
        AuditActionType.Edit => Color.Info,
        AuditActionType.Delete => Color.Error,
        AuditActionType.Ingress or AuditActionType.MassiveStockIngress => Color.Primary,
        AuditActionType.Egress or AuditActionType.MassiveStockEgress => Color.Warning,
        AuditActionType.Adjustment => Color.Secondary,
        AuditActionType.Transfer => Color.Tertiary,
        _ => Color.Default
    };
}
@page "/inventory"
@using MudBlazor
@using VetManagement.Staff.UI.Services.Api
@using System.Linq
@using System.Diagnostics
@inject ItemsApiService ItemsService
@inject NavigationManager Navigation
@attribute [Authorize(Policy = "Inventory.Read")]

<PageTitle>@L["Inventory"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto px-2 mt-8">
    <PageHeader Title="@L["Inventory Control"]" Icon="@Icons.Material.Filled.Inventory" />

    @if (_loading)
    {
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="4"><MudSkeleton Height="100px" Width="100%" Animation="Animation.Wave" /></MudItem>
            <MudItem xs="12" sm="4"><MudSkeleton Height="100px" Width="100%" Animation="Animation.Wave" /></MudItem>
            <MudItem xs="12" sm="4"><MudSkeleton Height="100px" Width="100%" Animation="Animation.Wave" /></MudItem>
        </MudGrid>
        <MudSkeleton Height="240px" Width="100%" Animation="Animation.Wave" />
    }
    else
    {
        #region Inventory Summary Cards
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-4 d-flex align-center app-surface" Elevation="1">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Primary" Size="Size.Large" Class="mr-3" />
                    <MudStack>
                        <MudText Typo="Typo.h5">@_totalItems</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Items in inventory"]</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-4 d-flex align-center app-surface" Elevation="1">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Large" Class="mr-3" />
                    <MudStack>
                        <MudText Typo="Typo.h5">@LowStockItems.Count</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Low stock"]</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Class="pa-4 d-flex align-center app-surface" Elevation="1">
                    <MudIcon Icon="@Icons.Material.Filled.Report" Color="Color.Error" Size="Size.Large" Class="mr-3" />
                    <MudStack>
                        <MudText Typo="Typo.h5">@OutOfStockItems.Count</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Out of stock"]</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
        #endregion

        #region Inventory Alerts
        <MudPaper Class="pa-4 app-surface" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                <MudText Typo="Typo.h6">@L["Low stock"]</MudText>
                <MudButton Href="inventory-items" Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SwapHoriz">@L["View movements"]</MudButton>
            </MudStack>
            @if (LowStockItems.Any())
            {
                <MudTable Items="@LowStockItems" Dense="true" Hover="true" Bordered="true" Striped="true">
                    <HeaderContent>
                        <MudTh>@L["Name / Compound"]</MudTh>
                        <MudTh style="width:140px;">@L["Stock"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@L["Name / Compound"]">
                            @if (string.IsNullOrWhiteSpace(context.Details))
                            {
                                <MudLink Href="@GetMovementsUrl(context.Name)">@context.Name</MudLink>
                            }
                            else
                            {
                                <MudTooltip Text="@context.Details">
                                    <MudLink Href="@GetMovementsUrl(context.Name)">@context.Name</MudLink>
                                </MudTooltip>
                            }
                        </MudTd>
                        <MudTd DataLabel="@L["Stock"]">
                            <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled">@context.Stock</MudChip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudAlert Severity="Severity.Success" Dense="true">@L["No low stock alerts"]</MudAlert>
            }
        </MudPaper>

        <MudPaper Class="pa-4 mt-4 app-surface" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                <MudText Typo="Typo.h6">@L["Out of stock"]</MudText>
                <MudButton Href="inventory-items" Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.SwapHoriz">@L["View movements"]</MudButton>
            </MudStack>
            @if (OutOfStockItems.Any())
            {
                <MudStack Row="true" Spacing="1" Style="flex-wrap:wrap;">
                    @foreach (var item in OutOfStockItems)
                    {
                        @* None where the user looks, but another warehouse has some: where to ask, never how many. *@
                        var color = item.AskAt is null ? Color.Error : Color.Info;
                        var label = item.AskAt is null ? item.Name : L["{0} · ask {1}", item.Name, item.AskAt].Value;
                        @if (string.IsNullOrWhiteSpace(item.Details))
                        {
                            <MudChip T="string" Color="@color" Variant="Variant.Filled" Class="mr-1 mb-1" OnClick="@(() => GoToMovements(item.Name))">@label</MudChip>
                        }
                        else
                        {
                            <MudTooltip Text="@item.Details">
                                <MudChip T="string" Color="@color" Variant="Variant.Filled" Class="mr-1 mb-1" OnClick="@(() => GoToMovements(item.Name))">@label</MudChip>
                            </MudTooltip>
                        }
                    }
                </MudStack>
            }
            else
            {
                <MudAlert Severity="Severity.Success" Dense="true">@L["No out of stock alerts"]</MudAlert>
            }
        </MudPaper>
        #endregion
    }
</MudContainer>

    @code {
    private bool _loading = true;
    private int _totalItems = 0;

    private List<ItemAlert> LowStockItems = new();
    private List<ItemAlert> OutOfStockItems = new();

    private string GetMovementsUrl(string name) => $"inventory-movements?q={Uri.EscapeDataString(name)}";
    private void GoToMovements(string name) => Navigation.NavigateTo(GetMovementsUrl(name));

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        var items = await ItemsService.GetAllItemsAsync();
        if (items != null && items!.Any())
        {
            _totalItems = items.Count;

            #region Inventory Alerts Low Stock
            // Low stock: group Drugs by Compound, sum stock and compare against the lowest positive threshold (>0).
            // If no positive thresholds, do not mark as low stock.
            var drugs = items?.OfType<Drug>() ?? Enumerable.Empty<Drug>();
            var drugLow = drugs
                .Cast<Drug>()
                .Where(d => !string.IsNullOrWhiteSpace(d.Compound))
                .GroupBy(d => d.Compound!.Trim(), StringComparer.OrdinalIgnoreCase)
                .Select(g =>
                {
                    var positiveThresholds = g.Select(d => d.LowStockThreshold).Where(t => t > 0).ToList();
                    var minThreshold = positiveThresholds.Any() ? positiveThresholds.Min() : 0; // 0 => no low-stock alert for this group
                    return new
                    {
                        Compound = g.First().Compound ?? g.Key,
                        TotalStock = g.Sum(d => d.Stock),
                        MinThreshold = minThreshold,
                        Details = string.Join("\n", g.Select(d => $"{d.Name}{(string.IsNullOrWhiteSpace(d.Brand) ? "" : $" ({d.Brand})")} - Stock: {d.Stock}"))
                    };
                })
                .Where(x => x.MinThreshold > 0 && x.TotalStock > 0 && x.TotalStock <= x.MinThreshold)
                .Select(x => new ItemAlert { Name = x.Compound, Stock = x.TotalStock, Details = x.Details });

            // Low stock: non-drug items only when threshold > 0
            var nonDrugLow = items
                .Where(i => i is not Drug)
                .Where(i => i.LowStockThreshold > 0 && i.Stock > 0 && i.Stock <= i.LowStockThreshold)
                .Select(i => new ItemAlert { Name = i.Name, Stock = i.Stock });

            LowStockItems = drugLow
                .Concat(nonDrugLow)
                .OrderBy(x => x.Stock)
                .Take(10)
                .ToList();
            #endregion

            #region Inventory Alerts Out of Stock
            // Out of stock: group Drugs by Compound and include groups with total stock == 0; non-drug keep per-item.
            var drugZeroGroups = items
                .Where(i => i is Drug d && !string.IsNullOrWhiteSpace(d.Compound))
                .Cast<Drug>()
                .GroupBy(d => d.Compound!.Trim(), StringComparer.OrdinalIgnoreCase)
                .Select(g => new { Compound = g.First().Compound ?? g.Key, TotalStock = g.Sum(d => d.Stock), Details = string.Join("\n", g.Select(d => $"{d.Name}{(string.IsNullOrWhiteSpace(d.Brand) ? "" : $" ({d.Brand})")} - Stock: {d.Stock}")), AskAt = AskAtOf(g) })
                .Where(x => x.TotalStock == 0)
                .Select(x => new ItemAlert { Name = x.Compound, Stock = 0, Details = x.Details, AskAt = x.AskAt });

            var nonDrugZero = items
                .Where(i => i is not Drug && i.Stock == 0)
                .Select(i => new ItemAlert { Name = i.Name, Stock = 0, AskAt = AskAtOf([i]) });

            OutOfStockItems = drugZeroGroups
                .Concat(nonDrugZero)
                .OrderBy(x => x.Name)
                .Take(20)
                .ToList();
            #endregion

            Debug.WriteLine($"Low stock items: {LowStockItems.Count}");
            Debug.WriteLine($"Out of stock items: {OutOfStockItems.Count}");
        }
        else
        {
            // Set all to empty
            _totalItems = 0;
            LowStockItems = new();
            OutOfStockItems = new();
        }
        _loading = false;
    }

    /// <summary>The warehouses the user doesn't see that hold some, by name; null when none does.</summary>
    private static string? AskAtOf(IEnumerable<Item> items)
        => items.SelectMany(i => i.AskAt).Distinct().Order().ToList() is { Count: > 0 } names ? string.Join(", ", names) : null;

    public class ItemAlert
    {
        public string Name { get; set; } = string.Empty;
        public int Stock { get; set; }
        public string? Details { get; set; }
        public string? AskAt { get; set; }
    }
}

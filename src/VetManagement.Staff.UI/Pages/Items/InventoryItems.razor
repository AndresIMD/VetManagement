@page "/inventory-items"
@using VetManagement.Staff.UI.Helpers
@using VetManagement.Staff.UI.Models.Core
@using VetManagement.Staff.UI.Services.Api
@using VetManagement.Staff.UI.Services.Realtime
@using VetManagement.Contracts.Inventory
@inject IDialogService DialogService
@inject WarehousesApiService WarehousesApi
@inject ItemsApiService ItemsService
@inject InventoryMovementApiService InventoryMovementService
@inject ISnackbar Snackbar
@inject RealtimeService RealtimeService
@attribute [Authorize(Policy = "Inventory.Read")]
@implements IDisposable


<PageTitle>@L["Current Inventory"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto px-2 mt-8">
    <PageHeader Title="@L["Current Inventory"]" Icon="@Icons.Material.Filled.Inventory2" />
    <MudBreadcrumbs Items="Breadcrumbs" Class="mb-2" />
    <MudPaper Class="pa-6 mb-4 elevation-3 rounded-lg app-surface">
        <MudGrid>
            <MudItem xs="12" sm="6" md="6">
                <MudTextFilterField @bind-Value="FilterNameOrCompound"
                    Label="@L["Search by name, brand, compound or code..."]" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="ItemType" @bind-Value="FilterItemType" Label="@L["Category"]" Variant="Variant.Outlined"
                    AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="ItemType.None">@L["All categories"]</MudSelectItem>
                    <MudSelectItem Value="ItemType.Material">@L["Material"]</MudSelectItem>
                    <MudSelectItem Value="ItemType.Drug">@L["Drug"]</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="12" md="3" Class="d-flex align-center justify-end">
                <MudButton Color="Color.Secondary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Clear"
                    OnClick="ClearFilters">@L["Clear filter"]</MudButton>
            </MudItem>
            <MudItem xs="12" Class="d-flex align-center">
                <ActiveFilterChips Chips="@BuildActiveChips()" Changed="StateHasChanged" />
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto px-2">
    <MudServerTable TItem="InventoryItemDTO" @ref="_table" ServerData="@ServerReload" Striped="true" Hover="true"
        Bordered="true" Dense="false" RowsPerPage="25">
        <ActionButtons>
            <MudItem xs="12" sm="3" Class="d-flex justify-end">
                <MudStack Row="true" Spacing="2">
                    <MudTooltip Text="@L["Create item"]">
                        <MudIconButton Icon="@Icons.Material.Filled.AddBox" Color="Color.Success"
                            Variant="Variant.Filled" Size="Size.Medium" OnClick="ShowCreateModal" />
                    </MudTooltip>
                    <AuthorizeView Policy="Inventory.Update">
                        <MudTooltip Text="@L["Mass ingress"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Upload" Color="Color.Success"
                                Variant="Variant.Filled" Size="Size.Medium" OnClick="ShowMassIngressModal" />
                        </MudTooltip>
                        <MudTooltip Text="@L["Mass egress"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Download" Color="Color.Error"
                                Variant="Variant.Filled" Size="Size.Medium" OnClick="ShowMassEgressModal" />
                        </MudTooltip>
                        @if (_warehouses.Count > 1)
                        {
                            <MudTooltip Text="@L["Transfer between warehouses"]">
                                <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Primary"
                                    Variant="Variant.Filled" Size="Size.Medium" OnClick="ShowMassTransferModal" />
                            </MudTooltip>
                        }
                    </AuthorizeView>
                    <AuthorizeView Policy="Inventory.Warehouses">
                        <MudTooltip Text="@L["Warehouses"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Warehouse" Color="Color.Default"
                                Variant="Variant.Outlined" Size="Size.Medium" Href="inventory/warehouses" />
                        </MudTooltip>
                    </AuthorizeView>
                </MudStack>
            </MudItem>
        </ActionButtons>
        <HeaderContent>
            <MudTh Style="width:25%; min-width:180px;">
                <MudTableSortLabel T="InventoryItemDTO" SortLabel="Name">@L["Name"]</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:20%; min-width:120px;">
                <MudTableSortLabel T="InventoryItemDTO" SortLabel="Brand">@L["Brand"]</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:20%; min-width:120px;">
                <MudTableSortLabel T="InventoryItemDTO" SortLabel="Type">@L["Category"]</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:15%; min-width:80px;">
                <MudTableSortLabel T="InventoryItemDTO" SortLabel="Stock">@L["Stock"]</MudTableSortLabel>
            </MudTh>
            <MudTh Style="width:20%; min-width:180px; text-align: right;">
                @L["Actions"]
            </MudTh>
        </HeaderContent>
        <RowTemplate Context="item">
            <MudTd DataLabel="@L["Name"]">@(!string.IsNullOrWhiteSpace(item.Name) ? item.Name : "-")</MudTd>
            <MudTd DataLabel="@L["Brand"]">@(!string.IsNullOrWhiteSpace(item.Brand) ? item.Brand : "-")</MudTd>
            <MudTd DataLabel="@L["Category"]">@item.Type.ToText()</MudTd>
            <MudTd DataLabel="@L["Stock"]">
                <StockByWarehouse Stock="item.Stock" LowStockThreshold="item.LowStockThreshold" Warehouses="item.Warehouses" AskAt="item.AskAt" />
            </MudTd>
            <MudTd DataLabel="@L["Actions"]" Class="text-end">
                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                    <MudTooltip Text="@L["History"]">
                        <MudIconButton Icon="@Icons.Material.Filled.History" Variant="Variant.Filled" Color="Color.Info"
                            Size="Size.Small" OnClick="@(() => ShowHistoryModal(item))" />
                    </MudTooltip>
                    <AuthorizeView Policy="Inventory.Update" Context="auth">
                        <MudTooltip Text="@L["Adjust stock"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled"
                                Color="Color.Secondary" Size="Size.Small" OnClick="@(() => ShowAdjustStockModal(item))" />
                        </MudTooltip>
                        @if (_warehouses.Count > 1)
                        {
                            <MudTooltip Text="@L["Move to another warehouse"]">
                                <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Variant="Variant.Filled"
                                    Color="Color.Primary" Size="Size.Small" OnClick="@(() => ShowTransferModal(item))" />
                            </MudTooltip>
                        }
                    </AuthorizeView>
                    <AuthorizeView Policy="Inventory.Delete">
                        <Authorized>
                            <MudTooltip Text="@L["Edit"]">
                                <MudIconButton Icon="@Icons.Material.Filled.EditNote" Variant="Variant.Filled"
                                    Color="Color.Tertiary" Size="Size.Small" OnClick="@(() => ShowEditModal(item))" />
                            </MudTooltip>
                            <MudTooltip Text="@L["Delete"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Filled"
                                    Color="Color.Error" Size="Size.Small" OnClick="@(() => ShowDeleteModal(item))" />
                            </MudTooltip>
                        </Authorized>
                    </AuthorizeView>
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudServerTable>
</MudContainer>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? InitialQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "alert")] public string? InitialAlert { get; set; }

    private MudServerTable<InventoryItemDTO>? _table;
    private List<InventoryItemDTO> _pagedItems = [];

    /// <summary>The warehouses the user sees and may move stock in (not archived).</summary>
    private List<WarehouseDto> _warehouses = [];

    private string _filterNameOrCompound = string.Empty;
    private string? _alert;

    private List<BreadcrumbItem> Breadcrumbs =>
    [
        new(L["Home"], "/"),
        new(L["Inventory"], "inventory"),
        new(_alert switch
        {
            "low" => L["Low stock"],
            "zero" => L["Out of stock"],
            _ when !string.IsNullOrWhiteSpace(FilterNameOrCompound) => L["Filter: {0}", FilterNameOrCompound],
            _ => L["Items"]
        }, null, disabled: true)
    ];

    private string FilterNameOrCompound
    {
        get => _filterNameOrCompound;
        set
        {
            if (_filterNameOrCompound == value) return;
            _filterNameOrCompound = value;
            _table?.ReloadServerData();
        }
    }
    private ItemType _filterItemType = ItemType.None;
    private ItemType FilterItemType
    {
        get => _filterItemType;
        set
        {
            if (_filterItemType == value) return;
            _filterItemType = value;
            _table?.ReloadServerData();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(InitialQuery))
            _filterNameOrCompound = InitialQuery;
        if (!string.IsNullOrWhiteSpace(InitialAlert))
            _alert = InitialAlert.ToLowerInvariant();

        // Subscribe to realtime events
        RealtimeService.OnEntityChanged += HandleEntityChanged;
        RealtimeService.OnPropertyChanged += HandlePropertyChanged;
        RealtimeService.OnCollectionChanged += HandleCollectionChanged;

        try
        {
            _warehouses = [.. (await WarehousesApi.GetAsync()).Where(w => !w.IsArchived)];
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Error loading warehouses: {0}", ex.Message], Severity.Error);
        }
    }

    private async Task<TableData<InventoryItemDTO>> ServerReload(TableState state, CancellationToken ct)
    {
        try
        {
            ItemSortField? sortBy = null;
            if (!string.IsNullOrWhiteSpace(state.SortLabel) && Enum.TryParse<ItemSortField>(state.SortLabel, out var parsedSort))
            {
                sortBy = parsedSort;
            }

            var sortDirection = state.SortDirection == MudBlazor.SortDirection.Descending
            ? VetManagement.Domain.Enums.SortDirection.Descending
            : VetManagement.Domain.Enums.SortDirection.Ascending;

            var result = await ItemsService.GetItemsPagedAsync(
            _filterNameOrCompound,
            _filterItemType,
            state.Page,
            state.PageSize,
            ct,
            _alert,
            sortBy,
            sortDirection);

            if (result != null)
            {
                _pagedItems = result.Items;
                return new TableData<InventoryItemDTO> { TotalItems = result.TotalCount, Items = result.Items };
            }
        }
        catch (TaskCanceledException) { }
        catch (Exception ex)
        {
            Snackbar.Add(L["Error loading items: {0}", ex.Message], Severity.Error);
        }

        return new TableData<InventoryItemDTO> { TotalItems = 0, Items = [] };
    }

    // Notices reach every connected user, whoever made the change included, so the list just stays current.
    private void HandleEntityChanged(EntityChangedEventArgs args)
    {
        if (args.EntityType == nameof(Item))
            ReloadSoon();
    }

    // The notice names the item, never the new count (it reaches every user): the page reads the stock it may see again.
    private void HandlePropertyChanged(PropertyChangedEventArgs args)
    {
        if (args.EntityType == nameof(Item) && args.PropertyName == nameof(Item.Stock) && _pagedItems.Any(x => x.Id == args.EntityId))
            ReloadSoon();
    }

    private CancellationTokenSource? _reloadSoon;

    /// <summary>One reload after a burst of notices: a bulk move sends one per item, a new item two.</summary>
    private void ReloadSoon()
    {
        _reloadSoon?.Cancel();
        var wait = _reloadSoon = new CancellationTokenSource();
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(400, wait.Token);
            }
            catch (TaskCanceledException)
            {
                return;
            }
            if (_table is not null)
                await _table.ReloadServerData();
        });
    }

    private void HandleCollectionChanged(CollectionChangedEventArgs args)
    {
        if (args.EntityType == nameof(Item))
            ReloadSoon();
    }

    private void ClearFilters()
    {
        FilterNameOrCompound = string.Empty;
        FilterItemType = ItemType.None;
        _alert = null;
        _table?.ReloadServerData();
    }

    #region Modals
    private async Task ShowCreateModal()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = false
        };
        var parameters = new DialogParameters<CreateItemModal>
        {
        { x => x.Title, L["New product"].Value },
        { x => x.TitleIcon, Icons.Material.Filled.AddBox },
        { x => x.TitleColor, Color.Success }
        };
        var dialog = await DialogService.ShowAsync<CreateItemModal>(null, parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false } && result.Data is Item)
        {
            _table?.ReloadServerData();
            Snackbar.Add(L["Product created."], Severity.Success);
        }
        else
        {
            Snackbar.Add(L["Creation canceled."], Severity.Info);
        }
    }

    private async Task ShowEditModal(InventoryItemDTO dto)
    {
        var parameters = new DialogParameters<EditItemModal>
        {
        { x => x.ItemDTO, dto },
        { x => x.Title, L["Edit item"].Value },
        { x => x.TitleIcon, Icons.Material.Filled.Edit },
        { x => x.TitleColor, Color.Primary }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = false
        };
        var dialog = await DialogService.ShowAsync<EditItemModal>(null, parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            _table?.ReloadServerData();
            Snackbar.Add(L["Item edited."], Severity.Success);
        }
        else
        {
            Snackbar.Add(L["Edit canceled."], Severity.Info);
        }
    }

    private async Task ShowHistoryModal(InventoryItemDTO dto)
    {
        var parameters = new DialogParameters<HistoryModal>
        {
        { x => x.Item, dto },
        { x => x.Title, L["Movement history"].Value },
        { x => x.TitleIcon, Icons.Material.Filled.History },
        { x => x.TitleColor, Color.Info }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };
        var dialog = await DialogService.ShowAsync<HistoryModal>(null, parameters, options);
        await dialog.Result;
    }

    private async Task ShowMassIngressModal()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = false
        };
        var dialog = await DialogService.ShowAsync<MassiveIngressModal>((string?)null, WithWarehouses(), options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: MassiveSelection<InventoryMassUpdateDTO> selection })
        {
            var saved = await InventoryMovementService.MassiveEntryAsync(selection.Items, selection.WarehouseId);
            if (saved.Ok)
            {
                Snackbar.Add(L["Mass ingress applied ({0} items).", selection.Items.Count], Severity.Success);
                _table?.ReloadServerData();
            }
            else
            {
                Snackbar.Add(L["Mass ingress error: {0}", saved.Error ?? ""], Severity.Error);
            }
        }
        else
        {
            Snackbar.Add(L["Mass ingress canceled."], Severity.Info);
        }
    }

    private async Task ShowMassEgressModal()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = false
        };
        var dialog = await DialogService.ShowAsync<MassiveEgressModal>((string?)null, WithWarehouses(), options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: MassiveSelection<InventoryMassUpdateDTO> selection })
        {
            var saved = await InventoryMovementService.MassiveExitAsync(selection.Items, selection.WarehouseId);
            if (saved.Ok)
            {
                Snackbar.Add(L["Mass egress applied ({0} items).", selection.Items.Count], Severity.Success);
                _table?.ReloadServerData();
            }
            else
            {
                Snackbar.Add(L["Mass egress error: {0}", saved.Error ?? ""], Severity.Error);
            }
        }
        else
        {
            Snackbar.Add(L["Mass egress canceled."], Severity.Info);
        }
    }

    private async Task ShowMassTransferModal()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = false
        };
        var dialog = await DialogService.ShowAsync<MassiveTransferModal>((string?)null, WithWarehouses(), options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: MassiveSelection<InventoryMassUpdateDTO> { WarehouseId: int from, ToWarehouseId: int to } selection })
        {
            var saved = await InventoryMovementService.MassTransferAsync(selection.Items, from, to);
            if (saved.Ok)
            {
                Snackbar.Add(L["Transfer applied ({0} items).", selection.Items.Count], Severity.Success);
                _table?.ReloadServerData();
            }
            else
            {
                Snackbar.Add(L["Transfer error: {0}", saved.Error ?? ""], Severity.Error);
            }
        }
    }

    private async Task ShowTransferModal(InventoryItemDTO dto)
    {
        var parameters = new DialogParameters<TransferStockModal>
        {
        { x => x.Item, dto },
        { x => x.Warehouses, _warehouses },
        { x => x.Title, L["Transfer between warehouses"].Value },
        { x => x.TitleIcon, Icons.Material.Filled.SwapHoriz },
        { x => x.TitleColor, Color.Primary }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = false
        };
        var dialog = await DialogService.ShowAsync<TransferStockModal>(null, parameters, options);
        if (await dialog.Result is { Canceled: false })
            _table?.ReloadServerData();
    }

    private DialogParameters WithWarehouses() => new() { [nameof(MassiveIngressModal.Warehouses)] = _warehouses };

    private async Task ShowAdjustStockModal(InventoryItemDTO dto)
    {
        var parameters = new DialogParameters<AdjustStockModal>
        {
        { x => x.Item, dto },
        { x => x.Warehouses, _warehouses },
        { x => x.Title, L["Adjust stock"].Value },
        { x => x.TitleIcon, Icons.Material.Filled.Edit },
        { x => x.TitleColor, Color.Secondary }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true,
            CloseOnEscapeKey = false
        };
        var dialog = await DialogService.ShowAsync<AdjustStockModal>(null, parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            _table?.ReloadServerData();
        }
        else
        {
            Snackbar.Add(L["Stock adjustment canceled."], Severity.Info);
        }
    }

    private async Task ShowDeleteModal(InventoryItemDTO dto)
    {
        var parameters = new DialogParameters<ConfirmModal>
        {
        { x => x.Title, L["Delete item"].Value },
        { x => x.Message, L["Are you sure you want to delete item '{0}'?", dto.Name].Value },
        { x => x.ButtonConfirmText, L["Delete"].Value },
        { x => x.ButtonCancelText, L["Cancel"].Value },
        { x => x.TitleIcon, Icons.Material.Filled.Delete },
        { x => x.TitleColor, Color.Error }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = false
        };
        var dialog = await DialogService.ShowAsync<ConfirmModal>(null, parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            try
            {
                await ItemsService.DeleteItemAsync(dto.Id);
                Snackbar.Add(L["Item deleted."], Severity.Success);
                _table?.ReloadServerData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(L["Error deleting item: {0}", ex.Message], Severity.Error);
            }
        }
        else
        {
            Snackbar.Add(L["Deletion canceled."], Severity.Info);
        }
    }

    #endregion

    private IEnumerable<FilterChipModel> BuildActiveChips()
    {
        var list = new List<FilterChipModel>();
        if (!string.IsNullOrWhiteSpace(FilterNameOrCompound))
            list.Add(new FilterChipModel
            {
                Label = L["Name/Brand/Compound: {0}", FilterNameOrCompound].Value,
                Color = Color.Primary,
                OnClear = () => FilterNameOrCompound = string.Empty
            });
        if (FilterItemType != ItemType.None)
            list.Add(new FilterChipModel
            {
                Label = L["Category: {0}", FilterItemType.ToText()].Value,
                Color = Color.Secondary,
                OnClear = () => FilterItemType = ItemType.None
            });
        if (!string.IsNullOrWhiteSpace(_alert))
            list.Add(new FilterChipModel
            {
                Label = InventoryUiHelpers.GetAlertLabel(_alert),
                Color = InventoryUiHelpers.GetAlertColor(_alert),
                OnClear = () => { _alert = null; _table?.ReloadServerData(); }
            });
        return list;
    }

    public void Dispose()
    {
        RealtimeService.OnEntityChanged -= HandleEntityChanged;
        RealtimeService.OnPropertyChanged -= HandlePropertyChanged;
        _reloadSoon?.Cancel();
        RealtimeService.OnCollectionChanged -= HandleCollectionChanged;
    }
}

@page "/exam-reports/{Id:int}"
@using VetManagement.Contracts.Exams
@using VetManagement.Domain.Exams
@inject ExamReportsApiService ReportsApi
@inject IJSRuntime Js
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@attribute [Authorize(Policy = "ExamsPerformed.Read")]

<PageTitle>@L["Lab report"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto px-2 mt-6">
    @if (_notFound)
    {
        <MudAlert Severity="Severity.Warning">@L["Report #{0} was not found.", Id]</MudAlert>
    }
    else if (_report is null || _settings is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintAsync">@L["Print / Save PDF"]</MudButton>
            <AuthorizeView Policy="ExamsPerformed.Update">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" Href="@($"exam-reports/{Id}/edit")">@L["Correct"]</MudButton>
            </AuthorizeView>
            <AuthorizeView Policy="ExamsPerformed.Create">
                <MudTooltip Text="@L["Another exam for this patient, with its data already filled in"]">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PostAdd" Href="@($"exam-reports/new?fromReport={Id}")">@L["New report for this patient"]</MudButton>
                </MudTooltip>
            </AuthorizeView>
            @if (_report.PetId is int petId)
            {
                @* Typed patients aren't registered, so they have no clinical record. *@
                <AuthorizeView Policy="Medical.Read">
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.MedicalInformation" Href="@($"clinical/pets/{petId}")">@L["Clinical record"]</MudButton>
                </AuthorizeView>
            }
            else if (_report.CanRegisterPatient)
            {
                @* The typed patient is kept as a provisional client, hidden from searches until registered here. Registering
                   leads to the client screen, so it also needs the Clients screens (not Laboratory). *@
                <AuthorizeView Policy="ClientsPets.List" Context="clientsScreens">
                <AuthorizeView Policy="ClientsPets.Create">
                    <MudTooltip Text="@L["Make this patient and owner a client, then complete their details"]">
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.PersonAdd" Disabled="_registering" OnClick="RegisterPatientAsync">@L["Register as client"]</MudButton>
                    </MudTooltip>
                </AuthorizeView>
                </AuthorizeView>
            }
            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["To send it, choose \"Save as PDF\" in the print dialog and attach the file."]</MudText>
        </MudStack>

        @* The exam's inventory product (e.g. its test kit): deducted once from the report, and returned if it was a mistake. *@
        @if (_report.StockDeducted is { } taken)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Inventory2">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <span>@L["Deducted from inventory: {0} × {1} ({2}, {3}).", taken.Quantity, taken.ItemName, taken.AtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "", taken.By ?? ""]</span>
                    <AuthorizeView Policy="ExamsPerformed.Update">
                        <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_stockBusy" OnClick="ReturnStockAsync">@L["Return to inventory"]</MudButton>
                    </AuthorizeView>
                </MudStack>
            </MudAlert>
        }
        else if (_report.StockToDeduct is { } stock)
        {
            <AuthorizeView Policy="ExamsPerformed.Create">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Inventory2">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <span>@L["This exam uses {0} × {1} ({2} in stock).", stock.Quantity, stock.ItemName, stock.InStock ?? 0]</span>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Disabled="_stockBusy" OnClick="DeductStockAsync">@L["Deduct from inventory"]</MudButton>
                    </MudStack>
                </MudAlert>
            </AuthorizeView>
        }

        <div class="d-flex justify-center pb-8" style="overflow-x:auto">
            <div>
                <ExamReportSheet Settings="_settings" Report="_report" LogoUrl="@_logo" BackgroundUrl="@_background" />
            </div>
        </div>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    private ExamReportDto? _report;
    private ExamReportSettings? _settings;
    private string? _logo;
    private string? _background;
    private bool _notFound;

    protected override async Task OnParametersSetAsync()
    {
        _report = await ReportsApi.GetAsync(Id);
        _notFound = _report is null;
        if (_notFound)
            return;
        _settings = (await ReportsApi.GetSettingsAsync()).Settings;
        _logo = await ReportsApi.GetImageDataUrlAsync(ClinicImageKind.ReportLogo);
        _background = await ReportsApi.GetImageDataUrlAsync(ClinicImageKind.ReportBackground);
    }

    private bool _registering;

    private async Task RegisterPatientAsync()
    {
        var parameters = new DialogParameters<ConfirmModal>
        {
            { x => x.Title, L["Register as client"].Value },
            { x => x.Message, L["Add {0} and {1} to the clients? You'll then complete their details (tax ID, phone, email) in the client screen.", _report!.PetName, _report.OwnerName ?? L["its owner"]].Value },
            { x => x.ButtonConfirmText, L["Register"].Value },
            { x => x.ButtonCancelText, L["Cancel"].Value },
            { x => x.TitleIcon, Icons.Material.Filled.PersonAdd }
        };
        var dialog = await DialogService.ShowAsync<ConfirmModal>(L["Register as client"], parameters, new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall });
        if (await dialog.Result is not { Canceled: false })
            return;

        _registering = true;
        var result = await ReportsApi.RegisterPatientAsync(Id);
        _registering = false;
        if (!result.Ok || result.Id is not int clientId)
        {
            Snackbar.Add(result.Error ?? L["The patient could not be registered."], Severity.Error);
            return;
        }
        Snackbar.Add(L["Registered. Complete the client's details."], Severity.Success);
        Navigation.NavigateTo($"client-search?clientId={clientId}");
    }

    private async Task PrintAsync()
        => await Js.InvokeVoidAsync("appPrint.element", ExamReportSheet.ElementId, ExamReportSheet.FileName(_report!),
            ExamReportSheet.PageSize(_settings!));

    private bool _stockBusy;

    private Task DeductStockAsync()
        => ChangeStockAsync(ReportsApi.DeductStockAsync, L["Deducted from inventory."], L["The product could not be deducted."]);

    private Task ReturnStockAsync()
        => ChangeStockAsync(ReportsApi.ReturnStockAsync, L["Returned to inventory."], L["The product could not be returned."]);

    /// <summary>Deducts or returns the exam's product, then reads the report again to show what it took.</summary>
    private async Task ChangeStockAsync(Func<int, Task<ApiResult>> change, string done, string failed)
    {
        _stockBusy = true;
        var result = await change(Id);
        _stockBusy = false;
        if (!result.Ok)
        {
            Snackbar.Add(result.Error ?? failed, Severity.Error);
            return;
        }
        Snackbar.Add(done, Severity.Success);
        _report = await ReportsApi.GetAsync(Id) ?? _report;
    }
}

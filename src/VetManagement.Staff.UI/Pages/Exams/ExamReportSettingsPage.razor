@page "/exam-reports/settings"
@using VetManagement.Contracts.Exams
@using VetManagement.Domain.Exams
@inject ExamReportsApiService ReportsApi
@inject ISnackbar Snackbar
@attribute [Authorize(Policy = "Exams.Update")]

<PageTitle>@L["Report Design"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mx-auto px-2 mt-8">
    <PageHeader Title="@L["Report Design"]"
                Subtitle="@L["How every exam report looks. What each report contains is set per exam in the exam catalog."]"
                Icon="@Icons.Material.Filled.DesignServices" />

    @if (_settings is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null"
                      Style="white-space:pre-line">@_error</MudAlert>
        }

        <MudGrid>
            <MudItem xs="12" lg="5">
                <MudPaper Class="pa-4 mb-3" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-2">@L["Images"]</MudText>
                    <MudStack Spacing="3">
                        <div>
                            <MudText Typo="Typo.subtitle2">@L["Logo"]</MudText>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <label
                                    class="mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-button-outlined-size-small mud-ripple"
                                    style="cursor:pointer">
                                    @L["Upload"]
                                    <InputFile OnChange="e => UploadAsync(e, ClinicImageKind.ReportLogo)"
                                               accept="image/png,image/jpeg,image/webp" style="display:none" />
                                </label>
                                @if (_logo is not null)
                                {
                                    <MudButton Size="Size.Small" Color="Color.Error"
                                               OnClick="() => RemoveAsync(ClinicImageKind.ReportLogo)">@L["Remove"]</MudButton>
                                }
                            </MudStack>
                            <MudCheckBox T="bool" @bind-Value="_settings.LogoKeepRatio" Label="@L["Keep the logo's proportions"]" Dense="true" />
                            <MudSlider T="int" @bind-Value="_settings.LogoHeightMm" Min="10" Max="60" Step="1">
                                @L["Logo height: {0} mm", _settings.LogoHeightMm]
                            </MudSlider>
                            @if (!_settings.LogoKeepRatio)
                            {
                                <MudSlider T="int" @bind-Value="_settings.LogoWidthMm" Min="10" Max="150" Step="1">
                                    @L["Logo width: {0} mm", _settings.LogoWidthMm]
                                </MudSlider>
                            }
                        </div>
                        <div>
                            <MudText Typo="Typo.subtitle2">@L["Background / frame"]</MudText>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <label
                                    class="mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-button-outlined-size-small mud-ripple"
                                    style="cursor:pointer">
                                    @L["Upload"]
                                    <InputFile OnChange="e => UploadAsync(e, ClinicImageKind.ReportBackground)"
                                               accept="image/png,image/jpeg,image/webp" style="display:none" />
                                </label>
                                @if (_background is not null)
                                {
                                    <MudButton Size="Size.Small" Color="Color.Error"
                                               OnClick="() => RemoveAsync(ClinicImageKind.ReportBackground)">@L["Remove"]</MudButton>
                                }
                            </MudStack>
                            <MudSelect T="BackgroundArea" Label="@L["Background covers"]" @bind-Value="_settings.BackgroundArea" Class="mt-2" Dense="true">
                                <MudSelectItem Value="BackgroundArea.Page">@L["The whole page (frame, letterhead)"]</MudSelectItem>
                                <MudSelectItem Value="BackgroundArea.ResultsBox">@L["Only the results box (watermark behind the results)"]</MudSelectItem>
                            </MudSelect>
                            <MudCheckBox T="bool" @bind-Value="_settings.BackgroundKeepRatio" Dense="true"
                                         Label="@L["Keep the image's proportions (otherwise it is stretched to fill the area)"]" />
                            @if (_settings.BackgroundKeepRatio)
                            {
                                <MudStack Row="true" Spacing="2">
                                    <MudSelect T="ImageFit" Label="@L["Fit to"]" @bind-Value="_settings.BackgroundFit" Dense="true">
                                        <MudSelectItem Value="ImageFit.Width">@L["Width"]</MudSelectItem>
                                        <MudSelectItem Value="ImageFit.Height">@L["Height"]</MudSelectItem>
                                    </MudSelect>
                                    <MudSelect T="ImageAlign" Label="@L["Aligned to"]" @bind-Value="_settings.BackgroundAlign" Dense="true">
                                        <MudSelectItem Value="ImageAlign.Start">@(_settings.BackgroundFit == ImageFit.Width ? L["Top"] : L["Left"])</MudSelectItem>
                                        <MudSelectItem Value="ImageAlign.Center">@L["Center"]</MudSelectItem>
                                        <MudSelectItem Value="ImageAlign.End">@(_settings.BackgroundFit == ImageFit.Width ? L["Bottom"] : L["Right"])</MudSelectItem>
                                    </MudSelect>
                                </MudStack>
                            }
                            <MudSlider T="double" @bind-Value="_settings.BackgroundOpacity" Min="0.05" Max="1" Step="0.05"
                                       Class="mt-2">
                                @L["Background strength: {0}% (lower it to turn the image into a watermark)", (_settings.BackgroundOpacity * 100).ToString("0")]
                            </MudSlider>
                        </div>
                        <MudAlert Severity="Severity.Info" Dense="true" NoIcon="true">
                            <b>@L["For your designer"]</b> @L["(images up to 3 MB, PNG, JPEG or WebP):"]
                            <ul class="mt-1 mb-0">
                                <li><b>@L["Logo:"]</b> @L["PNG with a transparent background, about 1200 × 400 px. Printed top left at the height chosen above."]</li>
                                <li><b>@L["Background:"]</b> @L["a full page, portrait, {0} px (300 dpi; half that is fine for a lighter file). It is stretched to the whole sheet (or to the results box, when chosen above). Keep text and strong colours out of the content area: {1} mm from the top, {2} mm from the bottom, {3} mm left and {4} mm right are free for frames or artwork. A watermark should be light: results are printed on top of it.", BackgroundPixels, _settings.MarginsMm.Top, _settings.MarginsMm.Bottom, _settings.MarginsMm.Left, _settings.MarginsMm.Right]</li>
                                <li><b>@L["Colours:"]</b> @L["the two bars below use your brand colours as #RRGGBB."]</li>
                            </ul>
                                </MudAlert>
                            </MudStack>
                        </MudPaper>

                        <MudPaper Class="pa-4 mb-3" Elevation="1">
                            <MudText Typo="Typo.h6" Class="mb-2">@L["Page"]</MudText>
                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="PaperSize" Label="@L["Paper"]" @bind-Value="_settings.Paper">
                                        <MudSelectItem Value="PaperSize.Letter">@L["Letter (21.6 × 27.9 cm)"]</MudSelectItem>
                                        <MudSelectItem Value="PaperSize.A4">A4 (21 × 29.7 cm)</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="string" Label="@L["Font"]" @bind-Value="_settings.FontFamily">
                                        @foreach (var font in ExamReportSettings.Fonts)
                                        {
                                            <MudSelectItem Value="@font"><span style="font-family:'@font'">@font</span></MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudText Typo="Typo.caption">@L["Patient bar"]</MudText>
                                    <input type="color" @bind="_settings.HeaderColor"
                                           style="width:100%;height:36px;border:0;background:none" />
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudText Typo="Typo.caption">@L["Result bar"]</MudText>
                                    <input type="color" @bind="_settings.AccentColor"
                                           style="width:100%;height:36px;border:0;background:none" />
                                </MudItem>
                                <MudItem xs="3">
                                    <MudNumericField T="int" Label="@L["Top (mm)"]" @bind-Value="_settings.MarginsMm.Top" Min="0"
                                                     Max="60" />
                                </MudItem>
                                <MudItem xs="3">
                                    <MudNumericField T="int" Label="@L["Right"]" @bind-Value="_settings.MarginsMm.Right" Min="0"
                                                     Max="60" />
                                </MudItem>
                                <MudItem xs="3">
                                    <MudNumericField T="int" Label="@L["Bottom"]" @bind-Value="_settings.MarginsMm.Bottom" Min="0"
                                                     Max="60" />
                                </MudItem>
                                <MudItem xs="3">
                                    <MudNumericField T="int" Label="@L["Left"]" @bind-Value="_settings.MarginsMm.Left" Min="0" Max="60" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField T="string" Label="@L["Header lines (next to the logo, one per line)"]" Lines="2"
                                                  Value="@string.Join("\n", _settings.HeaderLines)"
                                                  ValueChanged="v => _settings.HeaderLines = Lines(v)" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField T="string" Label="@L["Footer lines (clinic name, tax id, address, phone...)"]" Lines="4"
                                                  Value="@string.Join("\n", _settings.FooterLines)"
                                                  ValueChanged="v => _settings.FooterLines = Lines(v)" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField Label="@L["Note under the footer"]" @bind-Value="_settings.Disclaimer" Lines="2" />
                                </MudItem>
                            </MudGrid>
                            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SaveAsync">
                                    @L["Save"]</MudButton>
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" lg="7">
                            <div style="overflow-x:auto">
                                <div style="width:fit-content;margin:auto">
                                    <ExamReportSheet Settings="_settings" Report="ExamReportSheet.PlaceholderReport()"
                                                     Placeholder="true" LogoUrl="@_logo" BackgroundUrl="@_background" />
                                </div>
                            </div>
                        </MudItem>
                    </MudGrid>
                }
            </MudContainer>

@code {
    private const long MAX_IMAGE_BYTES = 3 * 1024 * 1024;

    private ExamReportSettings? _settings;
    private int _version;
    private string? _logo;
    private string? _background;
    private string? _error;
    private bool _saving;

    private string BackgroundPixels => _settings?.Paper == PaperSize.A4 ? "2480 × 3508" : "2550 × 3300";


    protected override async Task OnInitializedAsync()
    {
        (_settings, _version) = await ReportsApi.GetSettingsAsync();
        _logo = await ReportsApi.GetImageDataUrlAsync(ClinicImageKind.ReportLogo);
        _background = await ReportsApi.GetImageDataUrlAsync(ClinicImageKind.ReportBackground);
    }

    private static List<string> Lines(string? text)
        => (text ?? string.Empty).Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();

    private async Task SaveAsync()
    {
        _saving = true;
        var result = await ReportsApi.SaveSettingsAsync(_settings!, _version);
        _saving = false;
        if (!result.Ok)
        {
            _error = result.Error;
            return;
        }
        _error = null;
        _version = result.Body?.GetProperty("version").GetInt32() ?? _version + 1;
        Snackbar.Add(L["Report design saved."], Severity.Success);
    }

    private async Task UploadAsync(InputFileChangeEventArgs e, ClinicImageKind kind)
    {
        if (e.File.Size > MAX_IMAGE_BYTES)
        {
            _error = L["The image must be 3 MB or smaller."];
            return;
        }
        using var buffer = new MemoryStream();
        await e.File.OpenReadStream(MAX_IMAGE_BYTES).CopyToAsync(buffer);
        var result = await ReportsApi.SetImageAsync(kind, e.File.ContentType, buffer.ToArray());
        if (!result.Ok)
        {
            _error = result.Error;
            return;
        }
        await ReloadImageAsync(kind);
        Snackbar.Add(L["Image saved."], Severity.Success);
    }

    private async Task RemoveAsync(ClinicImageKind kind)
    {
        var result = await ReportsApi.DeleteImageAsync(kind);
        if (!result.Ok)
            _error = result.Error;
        await ReloadImageAsync(kind);
    }

    private async Task ReloadImageAsync(ClinicImageKind kind)
    {
        var url = await ReportsApi.GetImageDataUrlAsync(kind);
        if (kind == ClinicImageKind.ReportLogo) _logo = url; else _background = url;
    }
}

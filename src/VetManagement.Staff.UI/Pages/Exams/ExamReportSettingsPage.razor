@page "/exam-reports/settings"
@using System.Text.Json
@using VetManagement.Contracts.Exams
@using VetManagement.Domain.Exams
@inject ExamReportsApiService ReportsApi
@inject ISnackbar Snackbar
@inject IJSRuntime Js
@inject IDialogService DialogService
@attribute [Authorize(Policy = "Exams.Update")]

<PageTitle>@L["Report Design"]</PageTitle>
<NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" ConfirmExternalNavigation="@HasChanges" />

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mx-auto px-2 mt-8">
    <PageHeader Title="@L["Report Design"]"
                Subtitle="@L["How every exam report looks. What each report contains is set per exam in the exam catalog."]"
                Icon="@Icons.Material.Filled.DesignServices" />

    @if (_settings is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null"
                      Style="white-space:pre-line">@_error</MudAlert>
        }

        <MudGrid>
            <MudItem xs="12" lg="5">
                <MudPaper Class="pa-4 mb-3" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-2">@L["Images"]</MudText>
                    <MudStack Spacing="3">
                        <div>
                            <MudText Typo="Typo.subtitle2">@L["Logo"]</MudText>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <label
                                    class="mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-button-outlined-size-small mud-ripple"
                                    style="cursor:pointer">
                                    @L["Upload"]
                                    <InputFile OnChange="e => UploadAsync(e, ClinicImageKind.ReportLogo)"
                                               accept="image/png,image/jpeg,image/webp" style="display:none" />
                                </label>
                                @if (_logo is not null)
                                {
                                    <MudButton Size="Size.Small" Color="Color.Error"
                                               OnClick="() => RemoveImage(ClinicImageKind.ReportLogo)">@L["Remove"]</MudButton>
                                }
                            </MudStack>
                            <MudCheckBox T="bool" @bind-Value="_settings.LogoKeepRatio" Label="@L["Keep the logo's proportions"]" Dense="true" />
                            <MudSlider T="int" @bind-Value="_settings.LogoHeightMm" Min="10" Max="60" Step="1">
                                @L["Logo height: {0} mm", _settings.LogoHeightMm]
                            </MudSlider>
                            @if (!_settings.LogoKeepRatio)
                            {
                                <MudSlider T="int" @bind-Value="_settings.LogoWidthMm" Min="10" Max="150" Step="1">
                                    @L["Logo width: {0} mm", _settings.LogoWidthMm]
                                </MudSlider>
                            }
                        </div>
                        <div>
                            <MudText Typo="Typo.subtitle2">@L["Background / frame"]</MudText>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <label
                                    class="mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-button-outlined-size-small mud-ripple"
                                    style="cursor:pointer">
                                    @L["Upload"]
                                    <InputFile OnChange="e => UploadAsync(e, ClinicImageKind.ReportBackground)"
                                               accept="image/png,image/jpeg,image/webp" style="display:none" />
                                </label>
                                @if (_background is not null)
                                {
                                    <MudButton Size="Size.Small" Color="Color.Error"
                                               OnClick="() => RemoveImage(ClinicImageKind.ReportBackground)">@L["Remove"]</MudButton>
                                }
                            </MudStack>
                            <MudSelect T="BackgroundArea" Label="@L["Background covers"]" @bind-Value="_settings.BackgroundArea" Class="mt-2" Dense="true">
                                <MudSelectItem Value="BackgroundArea.Page">@L["The whole page (frame, letterhead)"]</MudSelectItem>
                                <MudSelectItem Value="BackgroundArea.ResultsBox">@L["Only the results box (watermark behind the results)"]</MudSelectItem>
                            </MudSelect>
                            <MudCheckBox T="bool" @bind-Value="_settings.BackgroundKeepRatio" Dense="true"
                                         Label="@L["Keep the image's proportions (otherwise it is stretched to fill the area)"]" />
                            @if (_settings.BackgroundKeepRatio)
                            {
                                <MudStack Row="true" Spacing="2">
                                    <MudSelect T="ImageFit" Label="@L["Fit to"]" @bind-Value="_settings.BackgroundFit" Dense="true">
                                        <MudSelectItem Value="ImageFit.Width">@L["Width"]</MudSelectItem>
                                        <MudSelectItem Value="ImageFit.Height">@L["Height"]</MudSelectItem>
                                    </MudSelect>
                                    <MudSelect T="ImageAlign" Label="@L["Aligned to"]" @bind-Value="_settings.BackgroundAlign" Dense="true">
                                        <MudSelectItem Value="ImageAlign.Start">@(_settings.BackgroundFit == ImageFit.Width ? L["Top"] : L["Left"])</MudSelectItem>
                                        <MudSelectItem Value="ImageAlign.Center">@L["Center"]</MudSelectItem>
                                        <MudSelectItem Value="ImageAlign.End">@(_settings.BackgroundFit == ImageFit.Width ? L["Bottom"] : L["Right"])</MudSelectItem>
                                    </MudSelect>
                                </MudStack>
                            }
                            <MudSlider T="double" @bind-Value="_settings.BackgroundOpacity" Min="0.05" Max="1" Step="0.05"
                                       Class="mt-2">
                                @L["Background strength: {0}% (lower it to turn the image into a watermark)", (_settings.BackgroundOpacity * 100).ToString("0")]
                            </MudSlider>
                        </div>
                        @if (_imageChanges.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">@L["The image changes are applied when you press Save."]</MudText>
                        }
                        <MudAlert Severity="Severity.Info" Dense="true" NoIcon="true">
                            <b>@L["Recommended image specifications"]</b> @L["(up to 3 MB; PNG, JPEG or WebP):"]
                            <ul class="mt-1 mb-0">
                                <li><b>@L["Logo:"]</b> @L["PNG with a transparent background, approximately 1200 × 400 px. Printed at the top left, at the height set above."]</li>
                                <li><b>@L["Background:"]</b> @L["full portrait page of {0} px (300 dpi; 150 dpi is enough for a lighter file). It covers the whole sheet, or the results box when that option is selected. The content area should stay free of text and strong colours; the margins ({1} mm top, {2} mm bottom, {3} mm left, {4} mm right) can hold frames or artwork. Watermarks should be light, since results are printed over them.", BackgroundPixels, _settings.MarginsMm.Top, _settings.MarginsMm.Bottom, _settings.MarginsMm.Left, _settings.MarginsMm.Right]</li>
                                <li><b>@L["Colours:"]</b> @L["the two bars below use the clinic's brand colours, in #RRGGBB format."]</li>
                            </ul>
                                </MudAlert>
                            </MudStack>
                        </MudPaper>

                        <MudPaper Class="pa-4 mb-3" Elevation="1">
                            <MudText Typo="Typo.h6" Class="mb-2">@L["Page"]</MudText>
                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="PaperSize" Label="@L["Paper"]" @bind-Value="_settings.Paper">
                                        <MudSelectItem Value="PaperSize.Letter">@L["Letter (21.6 × 27.9 cm)"]</MudSelectItem>
                                        <MudSelectItem Value="PaperSize.A4">A4 (21 × 29.7 cm)</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="string" Label="@L["Font"]" @bind-Value="_settings.FontFamily">
                                        @foreach (var font in ExamReportSettings.Fonts)
                                        {
                                            <MudSelectItem Value="@font"><span style="font-family:'@font'">@font</span></MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudText Typo="Typo.caption">@L["Patient bar"]</MudText>
                                    <input type="color" @bind="_settings.HeaderColor"
                                           style="width:100%;height:36px;border:0;background:none" />
                                </MudItem>
                                <MudItem xs="6" sm="3">
                                    <MudText Typo="Typo.caption">@L["Result bar"]</MudText>
                                    <input type="color" @bind="_settings.AccentColor"
                                           style="width:100%;height:36px;border:0;background:none" />
                                </MudItem>
                                <MudItem xs="3">
                                    <MudNumericField T="int" Label="@L["Top (mm)"]" @bind-Value="_settings.MarginsMm.Top" Min="0"
                                                     Max="60" />
                                </MudItem>
                                <MudItem xs="3">
                                    <MudNumericField T="int" Label="@L["Right"]" @bind-Value="_settings.MarginsMm.Right" Min="0"
                                                     Max="60" />
                                </MudItem>
                                <MudItem xs="3">
                                    <MudNumericField T="int" Label="@L["Bottom"]" @bind-Value="_settings.MarginsMm.Bottom" Min="0"
                                                     Max="60" />
                                </MudItem>
                                <MudItem xs="3">
                                    <MudNumericField T="int" Label="@L["Left"]" @bind-Value="_settings.MarginsMm.Left" Min="0" Max="60" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField T="string" Label="@L["Header lines (next to the logo, one per line)"]" Lines="2"
                                                  Value="@string.Join("\n", _settings.HeaderLines)"
                                                  ValueChanged="v => _settings.HeaderLines = Lines(v)" />
                                </MudItem>
                                <MudItem xs="12">
                                    @* data-bold-markup: Ctrl+B toggles bold in the field (text-format.js). *@
                                    <div id="report-footer" data-bold-markup>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.caption">@L["Footer (clinic name, tax id, address, phone...)"]</MudText>
                                            <MudTooltip Text="@L["Bold (Ctrl+B): select the text first, or place the cursor on a line"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.FormatBold" Size="Size.Small" OnClick="BoldFooterAsync"
                                                               aria-label="@L["Bold"]" />
                                            </MudTooltip>
                                        </MudStack>
                                        <MudTextField @bind-Value="_settings.Footer" Variant="Variant.Outlined" Lines="7" Immediate="true"
                                                      DebounceInterval="250" MaxLength="ExamReportSettings.MaxFooterLength"
                                                      HelperText="@L["Each line prints as written and an empty line leaves a gap. **Text** between double asterisks prints in bold."]" />
                                    </div>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField Label="@L["Note under the footer"]" @bind-Value="_settings.Disclaimer" Lines="2"
                                                  HelperText="@L["Leave it empty if the note is already part of the footer."]" />
                                </MudItem>
                            </MudGrid>
                            <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Class="mt-3">
                                @if (HasChanges)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Warning">@L["Unsaved changes"]</MudText>
                                }
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SaveAsync">
                                    @L["Save"]</MudButton>
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" lg="7">
                            <div style="overflow-x:auto">
                                <div style="width:fit-content;margin:auto">
                                    <ExamReportSheet Settings="_settings" Report="ExamReportSheet.PlaceholderReport()"
                                                     Placeholder="true" LogoUrl="@_logo" BackgroundUrl="@_background" />
                                </div>
                            </div>
                        </MudItem>
                    </MudGrid>
                }
            </MudContainer>

@code {
    private const long MAX_IMAGE_BYTES = 3 * 1024 * 1024;

    private ExamReportSettings? _settings;
    private int _version;
    private string? _logo;
    private string? _background;
    private string? _error;
    private bool _saving;
    private string _savedSettings = string.Empty;

    /// <summary>Images uploaded or removed on screen: they reach the server only on Save (no data = remove it).</summary>
    private readonly Dictionary<ClinicImageKind, ImageChange> _imageChanges = [];
    /// <summary>The images the server has, so removing one it doesn't have needs no call.</summary>
    private readonly HashSet<ClinicImageKind> _storedImages = [];

    private sealed record ImageChange(string? ContentType, byte[]? Data);

    private string BackgroundPixels => _settings?.Paper == PaperSize.A4 ? "2480 × 3508" : "2550 × 3300";

    private bool HasChanges => _settings is not null && (_imageChanges.Count > 0 || Snapshot() != _savedSettings);

    private string Snapshot() => JsonSerializer.Serialize(_settings);

    protected override async Task OnInitializedAsync()
    {
        (_settings, _version) = await ReportsApi.GetSettingsAsync();
        _savedSettings = Snapshot();
        _logo = await ReportsApi.GetImageDataUrlAsync(ClinicImageKind.ReportLogo);
        _background = await ReportsApi.GetImageDataUrlAsync(ClinicImageKind.ReportBackground);
        if (_logo is not null) _storedImages.Add(ClinicImageKind.ReportLogo);
        if (_background is not null) _storedImages.Add(ClinicImageKind.ReportBackground);
    }

    private static List<string> Lines(string? text)
        => (text ?? string.Empty).Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();

    private async Task BoldFooterAsync() => await Js.InvokeVoidAsync("appText.bold", "report-footer");

    /// <summary>Saves the design, then the image changes; an image that fails stays pending to try again.</summary>
    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var result = await ReportsApi.SaveSettingsAsync(_settings!, _version);
            if (!result.Ok)
            {
                _error = result.Error;
                return;
            }
            _error = null;
            _version = result.Body?.GetProperty("version").GetInt32() ?? _version + 1;
            _savedSettings = Snapshot();

            foreach (var (kind, change) in _imageChanges.ToList())
            {
                var imageResult = change.Data is not null ? await ReportsApi.SetImageAsync(kind, change.ContentType!, change.Data)
                    : _storedImages.Contains(kind) ? await ReportsApi.DeleteImageAsync(kind)
                    : null;
                if (imageResult is { Ok: false })
                {
                    _error = imageResult.Error;
                    continue;
                }
                _imageChanges.Remove(kind);
                if (change.Data is null) _storedImages.Remove(kind); else _storedImages.Add(kind);
            }
            if (_error is null)
                Snackbar.Add(L["Report design saved."], Severity.Success);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task UploadAsync(InputFileChangeEventArgs e, ClinicImageKind kind)
    {
        if (e.File.Size > MAX_IMAGE_BYTES)
        {
            _error = L["The image must be 3 MB or smaller."];
            return;
        }
        using var buffer = new MemoryStream();
        await e.File.OpenReadStream(MAX_IMAGE_BYTES).CopyToAsync(buffer);
        var data = buffer.ToArray();
        _imageChanges[kind] = new ImageChange(e.File.ContentType, data);
        ShowImage(kind, $"data:{e.File.ContentType};base64,{Convert.ToBase64String(data)}");
    }

    private void RemoveImage(ClinicImageKind kind)
    {
        _imageChanges[kind] = new ImageChange(null, null);
        ShowImage(kind, null);
    }

    private void ShowImage(ClinicImageKind kind, string? url)
    {
        if (kind == ClinicImageKind.ReportLogo) _logo = url; else _background = url;
    }

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (!HasChanges)
            return;
        var parameters = new DialogParameters<Components.Modals.Common.ConfirmModal>
        {
            { x => x.Title, L["Discard changes"].Value },
            { x => x.Message, L["There are unsaved changes. Do you want to exit without saving?"].Value },
            { x => x.ButtonConfirmText, L["Exit"].Value },
            { x => x.ButtonCancelText, L["Keep editing"].Value },
            { x => x.TitleIcon, Icons.Material.Filled.Warning },
            { x => x.TitleColor, Color.Warning }
        };
        var dialog = await DialogService.ShowAsync<Components.Modals.Common.ConfirmModal>(null, parameters, new DialogOptions { MaxWidth = MaxWidth.Small });
        if (await dialog.Result is not { Canceled: false })
            context.PreventNavigation();
    }
}

@page "/exam-reports/new"
@page "/exam-reports/{Id:int}/edit"
@using VetManagement.Contracts.Exams
@using VetManagement.Domain.Exams
@using ExamModel = VetManagement.Staff.UI.Models.Exams.Exam
@inject ExamReportsApiService ReportsApi
@inject ExamApiService ExamsApi
@inject ClientPetApiService ClientPetApi
@inject NavigationManager Navigation
@attribute [Authorize(Policy = "ExamsPerformed.Create")]

<PageTitle>@(Id is null ? "New Exam Report" : "Correct Exam Report")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mx-auto px-2 mt-8">
    <PageHeader Title="@(Id is null ? "New Exam Report" : "Correct Exam Report")" Icon="@Icons.Material.Filled.Science" />

    @if (_settings is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_exams.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No exam has a report template yet. Open the exam catalog and use "Report template" on an exam to define its parameters.
        </MudAlert>
    }
    else
    {
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
        }

        <MudPaper Class="pa-4 mb-3" Elevation="1">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int?" Label="Pet ID" Value="_petId" ValueChanged="OnPetChangedAsync" Min="1" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" sm="8" Class="d-flex align-center">
                    @if (_pet is not null)
                    {
                        <MudText><b>@_pet.Name</b> · @_pet.Species · @_pet.Breed · Owner: @_pet.OwnerName</MudText>
                    }
                    else if (_petId is not null)
                    {
                        <MudText Color="Color.Warning">Pet #@_petId was not found.</MudText>
                    }
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" Label="Exam" Value="_examId" ValueChanged="OnExamChanged">
                        @foreach (var exam in _exams)
                        {
                            <MudSelectItem Value="@exam.Id">@exam.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Sample received" @bind-Date="_receivedOn" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Referring vet" @bind-Value="_referringVet" MaxLength="200"
                                  HelperText="Vet who requested the exam (printed as 'Médico tratante')." />
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (Template is { } template)
        {
            <MudPaper Class="pa-4 mb-3" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">@template.Title</MudText>
                <MudGrid>
                    @foreach (var parameter in template.Parameters)
                    {
                        var current = parameter;
                        var evaluation = current.Evaluate(Value(current.Code), Species);
                        <MudItem xs="12" sm="5">
                            @if (current.Options.Count > 0)
                            {
                                <MudSelect T="string" Label="@current.Name" Value="@Value(current.Code)" ValueChanged="v => _values[current.Code] = v" Clearable="true">
                                    @foreach (var option in current.Options)
                                    {
                                        <MudSelectItem Value="@option">@option</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                <MudTextField T="string" Label="@current.Name" Value="@Value(current.Code)" ValueChanged="v => _values[current.Code] = v"
                                              Immediate="true" Adornment="Adornment.End" AdornmentText="@current.Unit" />
                            }
                        </MudItem>
                        <MudItem xs="12" sm="7" Class="d-flex align-center gap-2">
                            @if (evaluation.Band is { Label.Length: > 0 } band)
                            {
                                <MudChip T="string" Size="Size.Small" Color="@(evaluation.Abnormal ? Color.Warning : Color.Success)">@band.Label</MudChip>
                            }
                            else if (evaluation.Abnormal)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Out of range</MudChip>
                            }
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@current.ReferenceFor(Species)</MudText>
                        </MudItem>
                    }
                    @if (template.Sections.Interpretation)
                    {
                        <MudItem xs="12">
                            <MudTextField Label="Interpretation" @bind-Value="_interpretation" Lines="3" MaxLength="2000"
                                          Placeholder="@AutomaticInterpretation"
                                          HelperText="@InterpretationHelp" />
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mb-8">
                <MudButton Variant="Variant.Outlined" Href="@CancelHref">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving || _pet is null" OnClick="SaveAsync">Save and view</MudButton>
            </MudStack>
        }
    }
</MudContainer>

@code {
    private const string ReportRoute = "exam-reports/{0}";

    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery(Name = "petId")] public int? QueryPetId { get; set; }
    [SupplyParameterFromQuery(Name = "examId")] public int? QueryExamId { get; set; }

    private ExamReportSettings? _settings;
    private List<ExamModel> _exams = [];
    private int? _petId;
    private PetInfo? _pet;
    private int _examId;
    private DateTime? _receivedOn = DateTime.Today;
    private string? _referringVet;
    private string? _interpretation;
    private Dictionary<string, string?> _values = new(StringComparer.OrdinalIgnoreCase);
    private string? _error;
    private bool _saving;

    private ExamReportTemplate? Template => _settings?.FindTemplate(_examId);
    private Species Species => _pet?.Species ?? Species.Unknown;
    private string? Value(string code) => _values.GetValueOrDefault(code);

    private string CancelHref => Id is null ? "exam-reports" : string.Format(ReportRoute, Id);

    private string InterpretationHelp => AutomaticInterpretation is null
        ? "Write the interpretation, or leave it empty."
        : "Leave empty to print the automatic interpretation shown here.";

    private string? AutomaticInterpretation => Template is { } template
        ? ExamReport.InterpretationFrom(template.Parameters
            .Where(p => !string.IsNullOrWhiteSpace(Value(p.Code)))
            .Select(p => new ExamReportResult { Name = p.Name, Band = p.Evaluate(Value(p.Code), Species).Band?.Label })
            .ToList())
        : null;

    protected override async Task OnInitializedAsync()
    {
        _settings = (await ReportsApi.GetSettingsAsync()).Settings;
        _exams = (await ExamsApi.GetAllExamsAsync() ?? []).Where(e => _settings.FindTemplate(e.Id) is not null).OrderBy(e => e.Name).ToList();

        if (Id is int id)
        {
            var report = await ReportsApi.GetAsync(id);
            if (report is null)
            {
                _error = $"Report #{id} was not found.";
                return;
            }
            _examId = report.ExamId;
            _receivedOn = report.ReceivedOn.ToDateTime(TimeOnly.MinValue);
            _referringVet = report.ReferringVet;
            _values = report.Results.ToDictionary(r => r.Code, r => (string?)r.Value, StringComparer.OrdinalIgnoreCase);
            _interpretation = report.Interpretation == ExamReport.InterpretationFrom(report.Results
                .Select(r => new ExamReportResult { Name = r.Name, Band = r.Band }).ToList()) ? null : report.Interpretation;
            await OnPetChangedAsync(report.PetId);
        }
        else
        {
            _examId = QueryExamId is int examId && _exams.Any(e => e.Id == examId) ? examId : _exams.FirstOrDefault()?.Id ?? 0;
            if (QueryPetId is int petId)
                await OnPetChangedAsync(petId);
        }
    }

    private async Task OnPetChangedAsync(int? petId)
    {
        _petId = petId;
        _pet = petId is int id and > 0 ? await TryGetPetAsync(id) : null;
    }

    private sealed record PetInfo(int Id, string Name, Species Species, string Breed, string? OwnerName);

    private async Task<PetInfo?> TryGetPetAsync(int petId)
    {
        try
        {
            if (await ClientPetApi.GetPetByIdAsync(petId) is not { } pet)
                return null;
            var owner = await ClientPetApi.GetClientByIdAsync(pet.OwnerId);
            return new PetInfo(pet.Id, pet.Name, pet.Species, pet.Breed, owner is null ? null : $"{owner.Name} {owner.LastName}".Trim());
        }
        catch (HttpRequestException)
        {
            return null;
        }
    }

    private void OnExamChanged(int examId)
    {
        _examId = examId;
        _values.Clear();
        _interpretation = null;
    }

    private async Task SaveAsync()
    {
        if (_pet is null || _receivedOn is null)
        {
            _error = "Choose the pet and the reception date.";
            return;
        }
        _saving = true;
        _error = null;
        var request = new ExamReportRequest
        {
            PetId = _pet.Id,
            ExamId = _examId,
            ReceivedOn = DateOnly.FromDateTime(_receivedOn.Value),
            ReferringVet = _referringVet,
            Values = Template!.Parameters.Where(p => !string.IsNullOrWhiteSpace(Value(p.Code))).ToDictionary(p => p.Code, p => Value(p.Code)!),
            Interpretation = _interpretation
        };
        var result = Id is int id ? await ReportsApi.UpdateAsync(id, request) : await ReportsApi.CreateAsync(request);
        _saving = false;
        if (!result.Ok)
        {
            _error = result.Error;
            return;
        }
        Navigation.NavigateTo(string.Format(ReportRoute, Id ?? result.Id));
    }
}

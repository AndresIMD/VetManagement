@page "/exam-reports/new"
@page "/exam-reports/{Id:int}/edit"
@using VetManagement.Contracts.Exams
@using VetManagement.Domain.Exams
@using ExamModel = VetManagement.Staff.UI.Models.Exams.Exam
@inject ExamReportsApiService ReportsApi
@inject ExamApiService ExamsApi
@inject ClientPetApiService ClientPetApi
@inject NavigationManager Navigation
@attribute [Authorize(Policy = "ExamsPerformed.Create")]

<PageTitle>@(Id is null ? L["New lab report"] : L["Correct lab report"])</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mx-auto px-2 mt-8">
    <PageHeader Title="@(Id is null ? L["New lab report"] : L["Correct lab report"])" Icon="@Icons.Material.Filled.Science"
                TourId="new-lab-report" TourSteps="Tour" />

    @if (_settings is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_exams.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            @L["No exam has a report template yet. Open the exam catalog and use \"Report template\" on an exam to define its parameters."]
        </MudAlert>
    }
    else
    {
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
        }

        <MudPaper Class="pa-4 mb-3" Elevation="1">
            <MudGrid>
                <MudItem xs="12" data-tour="patient-kind">
                    <MudRadioGroup T="bool" @bind-Value="_registered">
                        <MudRadio T="bool" Value="false">@L["Patient not registered (typed here, kept only in this report)"]</MudRadio>
                        <MudRadio T="bool" Value="true">@L["Registered pet"]</MudRadio>
                    </MudRadioGroup>
                </MudItem>
                @if (_registered)
                {
                    <MudItem xs="12" sm="4" data-tour="pet-id">
                        <MudNumericField T="int?" Label="@L["Pet ID"]" Value="_petId" ValueChanged="OnPetChangedAsync" Min="1" HideSpinButtons="true" />
                    </MudItem>
                    <MudItem xs="12" sm="8" Class="d-flex align-center">
                        @if (_pet is not null)
                        {
                            <MudText><b>@_pet.Name</b> · @_pet.Species.ToText() · @_pet.Breed · @L["Owner: {0}", _pet.OwnerName ?? ""]</MudText>
                        }
                        else if (_petId is not null)
                        {
                            <MudText Color="Color.Warning">@L["Pet #{0} was not found.", _petId]</MudText>
                        }
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" data-tour="typed-search">
                        <MudAutocomplete T="ExamReportPatientDto" Label="@L["Typed before? Search by patient or owner"]" SearchFunc="SearchTypedPatientsAsync"
                                         ToStringFunc="@(p => p is null ? null : $"{p.Name} · {p.OwnerName} {p.OwnerLastName}".TrimEnd())"
                                         ValueChanged="UseTypedPatient" ResetValueOnEmptyText="true" Clearable="true" DebounceInterval="300"
                                         AdornmentIcon="@Icons.Material.Filled.Search"
                                         HelperText="@L["Fills the fields with the patient's last report, so its reports share a history."]" />
                    </MudItem>
                    <MudItem xs="12" sm="4"><MudTextField Label="@L["Patient name"]" Class="vm-upper" @bind-Value="_patient.Name" MaxLength="100" Required="true" /></MudItem>
                    <MudItem xs="6" sm="4" data-tour="species">
                        <MudSelect T="Species" Label="@L["Species"]" @bind-Value="_patient.Species">
                            @foreach (var species in Enum.GetValues<Species>())
                            {
                                <MudSelectItem Value="species">@species.ToText()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="4"><MudTextField Label="@L["Breed"]" Class="vm-upper" @bind-Value="_patient.Breed" MaxLength="100" /></MudItem>
                    <MudItem xs="6" sm="4">
                        <MudSelect T="Sex" Label="@L["Sex"]" @bind-Value="_patient.Sex">
                            @foreach (var sex in Enum.GetValues<Sex>())
                            {
                                <MudSelectItem Value="sex">@sex.ToText()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="2" data-tour="age">
                        <MudNumericField T="int?" Label="@L["Age: years"]" Value="_ageYears" ValueChanged="y => OnAgeChanged(y, _ageMonths)" Min="0" Max="40" />
                    </MudItem>
                    <MudItem xs="6" sm="2">
                        <MudNumericField T="int?" Label="@L["Months"]" Value="_ageMonths" ValueChanged="m => OnAgeChanged(_ageYears, m)" Min="0" Max="11" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudDatePicker Label="@L["Birth date"]" Date="_birthdate" DateChanged="OnBirthdateChanged" Editable="true" DateFormat="dd/MM/yyyy"
                                       Placeholder="@L["dd/mm/yyyy"]" Clearable="true" MaxDate="_receivedOn"
                                       HelperText="@(_birthdate is null ? L["Or the exact date, if known."] : _exactBirthdate ? L["Exact date."] : L["Worked out from the age."])" />
                    </MudItem>
                    <MudItem xs="6" sm="4"><MudTextField Label="@L["Owner first name"]" Class="vm-upper" @bind-Value="_patient.OwnerName" MaxLength="100" /></MudItem>
                    <MudItem xs="6" sm="4"><MudTextField Label="@L["Owner last name"]" Class="vm-upper" @bind-Value="_patient.OwnerLastName" MaxLength="100" /></MudItem>
                }
                <MudItem xs="12" sm="6" data-tour="exam">
                    <MudSelect T="int" Label="@L["Exam"]" Value="_examId" ValueChanged="OnExamChanged">
                        @foreach (var exam in _exams)
                        {
                            <MudSelectItem Value="@exam.Id">@exam.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="@(AsksLotNumber ? 3 : 6)" data-tour="received">
                    <MudDatePicker Label="@L["Sample received"]" Date="_receivedOn" DateChanged="OnReceivedChanged" Editable="true" DateFormat="dd/MM/yyyy"
                                   Placeholder="@L["dd/mm/yyyy"]" HelperText="@L["Today by default."]" />
                </MudItem>
                @if (AsksLotNumber)
                {
                    <MudItem xs="6" sm="3">
                        <MudTextField Label="@L["Lot number"]" Class="vm-upper" @bind-Value="_lotNumber" MaxLength="50"
                                      HelperText="@L["Test kit or reagent; optional."]" />
                    </MudItem>
                }
                <MudItem xs="12" data-tour="referring-vet">
                    <MudTextField Label="@L["Referring vet"]" Class="vm-upper" @bind-Value="_referringVet" MaxLength="200"
                                  HelperText="@L["Vet who requested the exam (printed as 'Médico tratante')."]" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (Template is { } template)
        {
            <MudPaper Class="pa-4 mb-3" Elevation="1" data-tour="results">
                <MudText Typo="Typo.h6" Class="mb-2">@template.Title</MudText>
                <MudGrid>
                    @foreach (var parameter in template.Parameters)
                    {
                        var current = parameter;
                        if (current.IsPageBreak)
                            continue; // it only changes the printed report's page
                        if (current.IsSection)
                        {
                            <MudItem xs="12" Class="pb-0">
                                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Style="text-transform:uppercase">@current.Name</MudText>
                                <MudDivider />
                            </MudItem>
                            continue;
                        }
                        var evaluation = current.Evaluate(Value(current.Code), Species);
                        <MudItem xs="12" sm="5">
                            @if (current.Options.Count > 0)
                            {
                                <MudSelect T="string" Label="@current.Name" Value="@Value(current.Code)" ValueChanged="v => _values[current.Code] = v" Clearable="true">
                                    @foreach (var option in current.Options)
                                    {
                                        <MudSelectItem Value="@option">@option</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else if (current.Kind == ReportParameterKind.Number)
                            {
                                <div class="d-flex align-center">
                                    <MudTextField T="string" Label="@current.Name" Value="@Value(current.Code)" ValueChanged="v => _values[current.Code] = v"
                                                  Immediate="true" Adornment="Adornment.End" AdornmentText="@current.Unit" Class="flex-grow-1" />
                                    @* What an analyser shows instead of a number: "...", "/" or "-", or a bound like ">1000". *@
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AriaLabel="@L["The analyser gave no number"]"
                                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="mt-3">
                                        <MudMenuItem OnClick="() => _values[current.Code] = L[NotMeasurable]">@L["Not measurable (the analyser shows ..., / or -)"]</MudMenuItem>
                                        <MudMenuItem OnClick="() => SetBound(current.Code, '>')">@L["Above what the analyser measures (>)"]</MudMenuItem>
                                        <MudMenuItem OnClick="() => SetBound(current.Code, '<')">@L["Below what the analyser measures (<)"]</MudMenuItem>
                                    </MudMenu>
                                </div>
                            }
                            else
                            {
                                <MudTextField T="string" Label="@current.Name" Value="@Value(current.Code)" ValueChanged="v => _values[current.Code] = v"
                                              Immediate="true" Adornment="Adornment.End" AdornmentText="@current.Unit" />
                            }
                        </MudItem>
                        <MudItem xs="12" sm="7" Class="d-flex align-center gap-2">
                            @if (evaluation.Band is { Label.Length: > 0 } band)
                            {
                                <MudChip T="string" Size="Size.Small" Color="@(evaluation.Abnormal ? Color.Warning : Color.Success)">@band.Label</MudChip>
                            }
                            else if (evaluation.Abnormal)
                            {
                                // Outside the normal range, or an abnormal answer (e.g. "Positivo") or band without a name.
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@(evaluation.Direction == ResultDirection.None ? L["Altered"] : L["Out of range"])</MudChip>
                            }
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@current.ReferenceFor(Species)</MudText>
                        </MudItem>
                    }
                    @if (template.Sections.Interpretation)
                    {
                        <MudItem xs="12" data-tour="interpretation">
                            <MudTextField Label="@L["Interpretation"]" @bind-Value="_interpretation" Lines="3" MaxLength="2000"
                                          Placeholder="@AutomaticInterpretation"
                                          HelperText="@InterpretationHelp" />
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>

            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mb-8" data-tour="save">
                <MudButton Variant="Variant.Outlined" Href="@CancelHref">@L["Cancel"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving || !HasPatient" OnClick="SaveAsync">@L["Save and view"]</MudButton>
            </MudStack>
        }
    }
</MudContainer>

@code {
    private const string ReportRoute = "exam-reports/{0}";
    /// <summary>Typed for a value the analyser didn't give: printed as is, never flagged, drawn on a bar or used by the rules.</summary>
    private const string NotMeasurable = "Not measurable";

    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery(Name = "petId")] public int? QueryPetId { get; set; }
    [SupplyParameterFromQuery(Name = "examId")] public int? QueryExamId { get; set; }
    /// <summary>Another exam for the same patient: copies this report's patient, referring vet and reception date.</summary>
    [SupplyParameterFromQuery(Name = "fromReport")] public int? FromReportId { get; set; }

    private ExamReportSettings? _settings;
    private List<ExamModel> _exams = [];
    // Patients aren't registered yet, so a typed patient is the default.
    private bool _registered;
    private int? _petId;
    private PetInfo? _pet;
    private ExamReportPatientDto _patient = new();
    // Owners usually give an approximate age; the birth date is then worked out from the reception date.
    // Age and birth date are linked: changing one updates the other, and the last one edited is what's kept.
    private bool _exactBirthdate;
    private DateTime? _birthdate;
    private int? _ageYears;
    private int? _ageMonths;
    private int _examId;
    private DateTime? _receivedOn = DateTime.Today;
    private string? _referringVet;
    private string? _lotNumber;
    private string? _interpretation;
    private Dictionary<string, string?> _values = new(StringComparer.OrdinalIgnoreCase);
    private string? _error;
    private bool _saving;

    private ExamReportTemplate? Template => _settings?.FindTemplate(_examId);
    private Species Species => _registered ? _pet?.Species ?? Species.Unknown : _patient.Species;
    // Only exams whose template asks for it show the lot; a correction keeps a lot already given.
    private bool AsksLotNumber => Template?.Sections.LotNumber == true || !string.IsNullOrEmpty(_lotNumber);
    private bool HasPatient => _registered ? _pet is not null : !string.IsNullOrWhiteSpace(_patient.Name);
    private string? Value(string code) => _values.GetValueOrDefault(code);

    private string CancelHref => Id is null ? "exam-reports" : string.Format(ReportRoute, Id);

    // The tutorial is offered once the form is on screen.
    private Func<IEnumerable<TourStep>>? Tour => _settings is not null && _exams.Count > 0 ? TourSteps : null;

    /// <summary>The tutorial of this form, for staff who type lab reports; steps for fields not on screen are skipped.</summary>
    private IEnumerable<TourStep> TourSteps() =>
    [
        new("patient-kind", L["Patient"], L["Choose a registered pet of the clinic, or type the patient only for this report (the usual case for lab samples)."]),
        new("typed-search", L["Patient seen before?"], L["Search by patient or owner name. Picking one fills in its data and links its reports, so the previous result can be printed next to the new one."]),
        new("pet-id", L["Registered pet"], L["Type the pet's number, shown in the client's record."]),
        new("species", L["Species"], L["The species picks the normal ranges, so choose it before typing the results."]),
        new("age", L["Age"], L["Type the age in years and months when the birth date isn't known; the date is worked out from the reception date."]),
        new("exam", L["Exam"], L["Only exams with a report template are listed. Changing the exam clears the results already typed."]),
        new("received", L["Sample received"], L["The date the sample arrived; today by default."]),
        new("referring-vet", L["Referring vet"], L["The vet who requested the exam. It prints as 'Médico tratante'."]),
        new("results", L["Results"], L["Type each value. Values outside the normal range are marked as you type, and the range for the species is shown next to each one. When the analyser gives no number, use the menu next to the value."]),
        new("interpretation", L["Interpretation"], L["When the exam has interpretation rules, the automatic interpretation shows in grey: leave the field empty to print it, or write your own."]),
        new("save", L["Save and view"], L["Saves the report and opens it, ready to print or save as PDF. A saved report can be corrected later."])
    ];

    private string InterpretationHelp => AutomaticInterpretation is null
        ? L["Write the interpretation, or leave it empty."]
        : L["Leave empty to print the automatic interpretation shown here."];

    private string? AutomaticInterpretation => Template?.Interpret(Template.Parameters
        .Where(p => !string.IsNullOrWhiteSpace(Value(p.Code)))
        .Select(p => p.ToResult(Value(p.Code)!, Species))
        .ToList());

    protected override async Task OnInitializedAsync()
    {
        _settings = (await ReportsApi.GetSettingsAsync()).Settings;
        _exams = (await ExamsApi.GetAllExamsAsync() ?? []).Where(e => _settings.FindTemplate(e.Id) is not null).OrderBy(e => e.Name).ToList();

        if (Id is int id)
        {
            var report = await ReportsApi.GetAsync(id);
            if (report is null)
            {
                _error = L["Report #{0} was not found.", id];
                return;
            }
            _examId = report.ExamId;
            _receivedOn = report.ReceivedOn.ToDateTime(TimeOnly.MinValue);
            _referringVet = report.ReferringVet;
            _lotNumber = report.LotNumber;
            _values = report.Results.ToDictionary(r => r.Code, r => (string?)r.Value, StringComparer.OrdinalIgnoreCase);
            if (report.Patient is { } patient)
            {
                _patient = patient;
                _birthdate = patient.Birthdate?.ToDateTime(TimeOnly.MinValue);
                _exactBirthdate = patient.Birthdate is not null && !patient.BirthdateApproximate;
                (_ageYears, _ageMonths) = AgeAt(_birthdate);
            }
            else
            {
                _registered = true;
                await OnPetChangedAsync(report.PetId);
            }
            // A stored interpretation equal to the automatic one stays automatic, so a correction recomputes it.
            _interpretation = report.Interpretation == AutomaticInterpretation ? null : report.Interpretation;
        }
        else
        {
            _examId = QueryExamId is int examId && _exams.Any(e => e.Id == examId) ? examId : _exams.FirstOrDefault()?.Id ?? 0;
            if (FromReportId is int sourceId && await ReportsApi.GetAsync(sourceId) is { } source)
            {
                // Usually another exam of the same sample: start on a different exam than the source's.
                _examId = _exams.FirstOrDefault(e => e.Id != source.ExamId)?.Id ?? _examId;
                _receivedOn = source.ReceivedOn.ToDateTime(TimeOnly.MinValue);
                _referringVet = source.ReferringVet;
                if (source.Patient is { } typed)
                    UseTypedPatient(typed);
                else
                {
                    _registered = true;
                    await OnPetChangedAsync(source.PetId);
                }
            }
            else if (QueryPetId is int petId)
            {
                _registered = true;
                await OnPetChangedAsync(petId);
            }
        }
    }

    private async Task OnPetChangedAsync(int? petId)
    {
        _petId = petId;
        _pet = petId is int id and > 0 ? await TryGetPetAsync(id) : null;
    }

    private sealed record PetInfo(int Id, string Name, Species Species, string Breed, string? OwnerName);

    private async Task<PetInfo?> TryGetPetAsync(int petId)
    {
        try
        {
            if (await ClientPetApi.GetPetByIdAsync(petId) is not { } pet)
                return null;
            var owner = await ClientPetApi.GetClientByIdAsync(pet.OwnerId);
            return new PetInfo(pet.Id, pet.Name, pet.Species, pet.Breed, owner is null ? null : $"{owner.Name} {owner.LastName}".Trim());
        }
        catch (HttpRequestException)
        {
            return null;
        }
    }

    /// <summary>The analyser's bound: "&gt;" or "&lt;" before the number typed, or alone to type the number after it.</summary>
    private void SetBound(string code, char sign)
    {
        var number = (Value(code) ?? string.Empty).Trim().TrimStart('<', '>', '≤', '≥', '=').Trim();
        _values[code] = ReportNumber.Parse(number) is null ? sign.ToString() : $"{sign}{number}";
    }

    private void OnExamChanged(int examId)
    {
        _examId = examId;
        _values.Clear();
        _interpretation = null;
        if (Template?.Sections.LotNumber != true)
            _lotNumber = null;
    }

    private async Task SaveAsync()
    {
        if (!HasPatient || _receivedOn is null)
        {
            _error = _registered ? L["Choose the pet and the reception date."] : L["Type the patient's name and the reception date."];
            return;
        }
        _saving = true;
        _error = null;
        var request = new ExamReportRequest
        {
            PetId = _registered ? _pet!.Id : null,
            Patient = _registered ? null : WithBirthdate(_patient),
            ExamId = _examId,
            ReceivedOn = DateOnly.FromDateTime(_receivedOn.Value),
            ReferringVet = _referringVet,
            LotNumber = _lotNumber,
            Values = Template!.Parameters.Where(p => !string.IsNullOrWhiteSpace(Value(p.Code))).ToDictionary(p => p.Code, p => Value(p.Code)!),
            Interpretation = _interpretation
        };
        var result = Id is int id ? await ReportsApi.UpdateAsync(id, request) : await ReportsApi.CreateAsync(request);
        _saving = false;
        if (!result.Ok)
        {
            _error = result.Error;
            return;
        }
        Navigation.NavigateTo(string.Format(ReportRoute, Id ?? result.Id));
    }

    private async Task<IEnumerable<ExamReportPatientDto>> SearchTypedPatientsAsync(string? search, CancellationToken token)
        => string.IsNullOrWhiteSpace(search) ? [] : await ReportsApi.ProvisionalPatientsAsync(search);

    /// <summary>The same patient typed again: the server links the report to its earlier ones (name, species and owner).</summary>
    private void UseTypedPatient(ExamReportPatientDto? patient)
    {
        if (patient is null)
            return;
        _patient = new ExamReportPatientDto
        {
            Name = patient.Name, Species = patient.Species, Breed = patient.Breed, Sex = patient.Sex,
            OwnerName = patient.OwnerName, OwnerLastName = patient.OwnerLastName
        };
        _birthdate = patient.Birthdate?.ToDateTime(TimeOnly.MinValue);
        _exactBirthdate = patient.Birthdate is not null && !patient.BirthdateApproximate;
        (_ageYears, _ageMonths) = AgeAt(_birthdate);
    }

    /// <summary>Typing an age makes the birth date approximate: worked out back from the reception date.</summary>
    private void OnAgeChanged(int? years, int? months)
    {
        (_ageYears, _ageMonths) = (years, months);
        _exactBirthdate = false;
        _birthdate = BirthdateFromAge();
    }

    /// <summary>Picking a date makes it exact and shows the age it gives at the reception date.</summary>
    private void OnBirthdateChanged(DateTime? birthdate)
    {
        _birthdate = birthdate;
        _exactBirthdate = birthdate is not null;
        (_ageYears, _ageMonths) = AgeAt(birthdate);
    }

    /// <summary>The reception date moves an approximate birth date with it; an exact one keeps its date and its age changes.</summary>
    private void OnReceivedChanged(DateTime? received)
    {
        _receivedOn = received;
        if (_exactBirthdate)
            (_ageYears, _ageMonths) = AgeAt(_birthdate);
        else
            _birthdate = BirthdateFromAge();
    }

    private DateTime? BirthdateFromAge()
        => (_ageYears is > 0 || _ageMonths is > 0) && _receivedOn is { } received
            ? received.Date.AddYears(-(_ageYears ?? 0)).AddMonths(-(_ageMonths ?? 0))
            : null;

    /// <summary>Whole years and months from <paramref name="birthdate"/> to the reception date; nulls without a date.</summary>
    private (int?, int?) AgeAt(DateTime? birthdate)
    {
        if (birthdate is not { } born || _receivedOn is not { } received || born > received)
            return (null, null);
        var months = (received.Year - born.Year) * 12 + received.Month - born.Month - (received.Day < born.Day ? 1 : 0);
        return (months / 12, months % 12);
    }

    private ExamReportPatientDto WithBirthdate(ExamReportPatientDto patient)
    {
        patient.Birthdate = _birthdate is { } born ? DateOnly.FromDateTime(born) : null;
        patient.BirthdateApproximate = patient.Birthdate is not null && !_exactBirthdate;
        return patient;
    }
}

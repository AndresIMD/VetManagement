@page "/consumption"
@using VetManagement.Contracts.Consumption
@inject ConsumptionApiService Api
@inject ClientPetApiService ClientPetApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IAuthorizationService Authorization
@attribute [Authorize(Policy = "Consumption.Read")]

<PageTitle>@L["Patient consumption"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto px-2 mt-8">
    <PageHeader Title="@L["Patient consumption"]" Icon="@Icons.Material.Filled.Vaccines"
                Subtitle="@L["Supplies used on each patient during a stay, added up for the charge at discharge."]" />

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
    }

    <AuthorizeView Policy="Consumption.Record" Context="auth">
        <MudPaper Class="pa-4 mb-3" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-2">@L["New sheet"]</MudText>
            <MudRadioGroup T="bool" @bind-Value="_registered">
                <MudRadio T="bool" Value="false">@L["Patient typed in"]</MudRadio>
                <MudRadio T="bool" Value="true">@L["Registered patient"]</MudRadio>
            </MudRadioGroup>
            <MudGrid Spacing="2">
                @if (_registered)
                {
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="int?" Label="@L["Patient ID"]" Value="_petId" ValueChanged="OnPetChangedAsync" Min="1" HideSpinButtons="true" />
                    </MudItem>
                    <MudItem xs="12" sm="8" Class="d-flex align-center">
                        @if (_petName is not null)
                        {
                            <MudText><b>@_petName</b></MudText>
                        }
                        else if (_petId is not null)
                        {
                            <MudText Color="Color.Warning">@L["Patient #{0} was not found.", _petId]</MudText>
                        }
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="4">
                        <MudTextField Label="@L["Patient name"]" @bind-Value="_patientName" MaxLength="100" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField Label="@L["Owner's name and last name"]" @bind-Value="_ownerName" MaxLength="200" />
                    </MudItem>
                }
                <MudItem xs="12" sm="@(_registered ? 12 : 4)">
                    <MudTextField Label="@L["Notes (optional)"]" @bind-Value="_notes" MaxLength="500" Placeholder="@L["E.g. hospitalised, box 3"]" />
                </MudItem>
            </MudGrid>
            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@(_busy || !CanOpen)" OnClick="OpenAsync">@L["Open sheet"]</MudButton>
            </MudStack>
        </MudPaper>
    </AuthorizeView>

    <MudPaper Class="pa-4" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2">
            <MudText Typo="Typo.h6">@L["Sheets"]</MudText>
            <MudSpacer />
            <MudToggleGroup T="SheetFilter" Value="_filter" ValueChanged="FilterAsync" Size="Size.Small" Color="Color.Primary"
                            Outlined="true" Delimiters="true" CheckMark="false" aria-label="@L["Which sheets to show"]">
                <MudToggleItem Value="SheetFilter.Active" Text="@L["Active patients"]" />
                <MudToggleItem Value="SheetFilter.Discharged" Text="@L["Discharged"]" />
                <MudToggleItem Value="SheetFilter.All" Text="@L["All"]" />
            </MudToggleGroup>
            <AuthorizeView Policy="Consumption.Manage" Context="auth">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PriceChange" Href="consumption/pricing">@L["How supplies are charged"]</MudButton>
            </AuthorizeView>
        </MudStack>
        @if (_filter != SheetFilter.Active)
        {
            @* Said once, beside the list: older sheets are not in it. *@
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">@L["Discharged: only those of the last {0} days.", CLOSED_DAYS]</MudText>
        }
        @if (_sheets is null)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            @* A click on a row opens its supplies right there, to record a use without leaving the list; the pencil opens the
               whole sheet, for everything else. *@
            <MudTable Items="Shown" Hover="true" Dense="true" T="ConsumptionSheetSummaryDto" OnRowClick="OnRowClickAsync" RowStyle="cursor:pointer">
                <HeaderContent>
                    <MudTh Style="width:1%"></MudTh>
                    <MudTh>@L["Patient"]</MudTh>
                    <MudTh>@L["Owner"]</MudTh>
                    <MudTh>@L["Opened"]</MudTh>
                    <MudTh Style="text-align:right">@L["Uses"]</MudTh>
                    <MudTh Style="text-align:right">@L["Total"]</MudTh>
                    <MudTh>@L["Status"]</MudTh>
                    <MudTh Style="width:1%"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <span @onclick:stopPropagation="true">
                            <MudIconButton Icon="@(_expanded.ContainsKey(context.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                           Size="Size.Small" aria-label="@L["Quick use"]" aria-expanded="@(_expanded.ContainsKey(context.Id) ? "true" : "false")"
                                           OnClick="() => ToggleAsync(context.Id)" />
                        </span>
                    </MudTd>
                    <MudTd><b>@context.PatientName</b></MudTd>
                    <MudTd>@context.OwnerName</MudTd>
                    <MudTd>@context.OpenedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd Style="text-align:right">@context.EntryCount</MudTd>
                    <MudTd Style="text-align:right">@Money.Clp(context.Total)</MudTd>
                    <MudTd>
                        <span class="d-inline-flex align-center" style="gap:4px">
                            @if (context.ClosedAtUtc is { } closed)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0">@L["Discharged {0}", closed.ToLocalTime().ToString("dd/MM HH:mm")]</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="ma-0">@L["Open"]</MudChip>
                            }
                            <StockPendingIndicator Items="context.Pending" Discharged="context.ClosedAtUtc is not null" />
                            <BudgetUsedUpIndicator Items="context.UsedUp" />
                        </span>
                    </MudTd>
                    <MudTd>
                        <span @onclick:stopPropagation="true">
                            <MudTooltip Text="@L["Edit sheet"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Href="@($"consumption/{context.Id}")" aria-label="@L["Edit sheet"]" />
                            </MudTooltip>
                        </span>
                    </MudTd>
                </RowTemplate>
                <ChildRowContent>
                    @if (_expanded.TryGetValue(context.Id, out var sheet))
                    {
                        <tr>
                            <td colspan="8" class="quick-use">
                                @if (sheet is null)
                                {
                                    <MudProgressLinear Indeterminate="true" />
                                }
                                else if (QuickItems(sheet) is not { Count: > 0 } items)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Nothing recorded yet."]</MudText>
                                }
                                else
                                {
                                    <div class="quick-use-lines">
                                        @foreach (var item in items)
                                        {
                                            var key = (sheet.Id, item.ItemId);
                                            <div class="quick-use-line">
                                                <span>@item.ItemName</span>
                                                <span class="mud-text-secondary d-inline-flex align-center" style="gap:4px">
                                                    @State(sheet, item)
                                                    @if (item.Balance is { UsedUp: true })
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Outlined.AssignmentLate" Color="Color.Warning" Size="Size.Small"
                                                                 Title="@L["No budget left: ask the guardian for a new one."]" />
                                                    }
                                                </span>
                                                @if (_canRecord && sheet.ClosedAtUtc is null)
                                                {
                                                    <span class="quick-use-action">
                                                        <QuantityStepper Value="_quantities.GetValueOrDefault(key)" ValueChanged="value => _quantities[key] = value"
                                                                         Steps="@(item.Charge == ConsumptionCharge.Unit)" Unit="@UnitText(item.Charge)"
                                                                         Variant="Variant.Outlined" Margin="Margin.Dense" FieldStyle="width:110px"
                                                                         AriaLabel="@L["Quantity of {0}", item.ItemName]" />
                                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                                   Disabled="@(_quantities.GetValueOrDefault(key) is not > 0 || _saving.Contains(key))"
                                                                   OnClick="() => RecordAsync(sheet, item)">@L["Record"]</MudButton>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </ChildRowContent>
                <NoRecordsContent>
                    <MudText Color="Color.Secondary">
                        @(_filter switch
                        {
                            SheetFilter.Active => L["No open sheets."],
                            SheetFilter.Discharged => L["No sheets discharged in the last {0} days.", CLOSED_DAYS],
                            _ => L["No sheets yet."]
                        })
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        }
    </MudPaper>
</MudContainer>

@code {
    private const int CLOSED_DAYS = 30;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary>
    /// Which sheets the list shows. The active ones include a discharged sheet that still owes stock, until it is settled:
    /// it has work pending, so it mustn't drop out of the daily view.
    /// </summary>
    private enum SheetFilter { Active, Discharged, All }

    private List<ConsumptionSheetSummaryDto>? _sheets;
    private SheetFilter _filter;

    private IEnumerable<ConsumptionSheetSummaryDto> Shown
        => _filter == SheetFilter.Discharged ? _sheets!.Where(s => s.ClosedAtUtc is not null) : _sheets!;
    private bool _registered;
    private int? _petId;
    private string? _petName;
    private string? _patientName;
    private string? _ownerName;
    private string? _notes;
    private bool _busy;
    private string? _error;
    private bool _canRecord;

    /// <summary>The rows opened for a quick use, with their sheet as last loaded (null while it loads).</summary>
    private readonly Dictionary<int, ConsumptionSheetDto?> _expanded = [];

    /// <summary>The quantity ready to record for each item of an opened row, until changed: one unit, or the patient's last dose in mL.</summary>
    private readonly Dictionary<(int Sheet, int Item), decimal?> _quantities = [];

    /// <summary>Uses being recorded, so a second click doesn't record them twice.</summary>
    private readonly HashSet<(int Sheet, int Item)> _saving = [];

    private bool CanOpen => _registered ? _petName is not null : !string.IsNullOrWhiteSpace(_patientName);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
            _canRecord = (await Authorization.AuthorizeAsync((await AuthState).User, "Consumption.Record")).Succeeded;
        await LoadAsync();
    }

    private async Task LoadAsync() => _sheets = await Api.ListAsync(_filter == SheetFilter.Active ? 0 : CLOSED_DAYS);

    private async Task FilterAsync(SheetFilter filter)
    {
        _filter = filter;
        await LoadAsync();
    }

    private async Task OnPetChangedAsync(int? petId)
    {
        _petId = petId;
        _petName = null;
        if (petId is not > 0)
            return;
        try
        {
            if (await ClientPetApi.GetPetByIdAsync(petId.Value) is { } pet)
            {
                var owner = await ClientPetApi.GetClientByIdAsync(pet.OwnerId);
                _petName = owner is null ? pet.Name : $"{pet.Name} · {owner.Name} {owner.LastName}".Trim();
            }
        }
        catch (HttpRequestException)
        {
        }
    }

    private async Task OnRowClickAsync(TableRowClickEventArgs<ConsumptionSheetSummaryDto> e)
    {
        if (e.Item is { } sheet)
            await ToggleAsync(sheet.Id);
    }

    private async Task ToggleAsync(int id)
    {
        if (_expanded.Remove(id))
        {
            foreach (var key in _quantities.Keys.Where(k => k.Sheet == id).ToList())
                _quantities.Remove(key);
            return;
        }
        _expanded[id] = null;
        await LoadSheetAsync(id);
    }

    /// <summary>Reads an opened row's sheet again, keeping any quantity already typed.</summary>
    private async Task LoadSheetAsync(int id)
    {
        var sheet = await Api.GetAsync(id);
        if (!_expanded.ContainsKey(id))
            return;
        if (sheet is null)
        {
            _expanded.Remove(id);
            Snackbar.Add(L["The sheet was not found."], Severity.Warning);
            return;
        }
        _expanded[id] = sheet;
        foreach (var item in QuickItems(sheet))
            _quantities.TryAdd((id, item.ItemId), LastDose(sheet, item));
    }

    /// <summary>One item of an opened row: what it used (a line) and what is left of its budget (a balance), either or both.</summary>
    private sealed record QuickItem(int ItemId, string ItemName, ConsumptionCharge Charge, ConsumptionLineDto? Line, ConsumptionBalanceDto? Balance);

    /// <summary>The items used and the items budgeted, so an approved drug can be given from the list before its first use.</summary>
    private static List<QuickItem> QuickItems(ConsumptionSheetDto sheet)
        => [.. sheet.Lines.Select(l => l.ItemId).Union(sheet.Balances.Select(b => b.ItemId))
            .Select(id =>
            {
                var line = sheet.Lines.FirstOrDefault(l => l.ItemId == id);
                var balance = sheet.Balances.FirstOrDefault(b => b.ItemId == id);
                return new QuickItem(id, line?.ItemName ?? balance!.ItemName, line?.Charge ?? balance!.Charge, line, balance);
            })
            .OrderBy(i => i.ItemName, StringComparer.CurrentCultureIgnoreCase)];

    /// <summary>
    /// One unit for items charged per unit (a use recorded as a batch is no dose to repeat); for the rest, the mL of the
    /// patient's last dose, since doses repeat.
    /// </summary>
    private static decimal? LastDose(ConsumptionSheetDto sheet, QuickItem item)
        => item.Charge == ConsumptionCharge.Unit ? 1 : sheet.Entries.FirstOrDefault(e => e.ItemId == item.ItemId && !e.Discarded)?.Quantity;

    private async Task RecordAsync(ConsumptionSheetDto sheet, QuickItem line)
    {
        var key = (sheet.Id, line.ItemId);
        if (_quantities.GetValueOrDefault(key) is not { } quantity || quantity <= 0 || !_saving.Add(key))
            return;
        var result = await Api.AddEntryAsync(sheet.Id, new AddConsumptionEntryRequest { ItemId = line.ItemId, Quantity = quantity });
        _saving.Remove(key);
        if (!result.Ok)
        {
            Snackbar.Add(result.Error ?? L["The use could not be recorded."], Severity.Error);
            return;
        }

        var entryId = result.Id;
        Snackbar.Add(L["Recorded {0} {1} of {2} for {3}.", Qty(quantity), UnitText(line.Charge), line.ItemName, sheet.PatientName], Severity.Success, config =>
        {
            if (entryId is not int id)
                return;
            config.Action = L["Undo"];
            config.ActionColor = Color.Primary;
            config.RequireInteraction = false;
            config.VisibleStateDuration = 8000;
            // Closed at once, so the same use can't be undone twice.
            config.OnClick = message =>
            {
                Snackbar.Remove(message);
                return UndoAsync(sheet.Id, id);
            };
        });
        await RefreshAsync(sheet.Id);
    }

    /// <summary>Removes a use just recorded by mistake, from the message that confirmed it.</summary>
    private async Task UndoAsync(int sheetId, int entryId)
    {
        var result = await Api.RemoveEntryAsync(sheetId, entryId);
        if (result.Ok)
            Snackbar.Add(L["Use removed."], Severity.Info);
        else
            Snackbar.Add(result.Error ?? L["The use could not be removed."], Severity.Error);
        await RefreshAsync(sheetId);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>The list's totals and the opened row, after a use was recorded or removed.</summary>
    private async Task RefreshAsync(int sheetId)
    {
        await LoadAsync();
        if (_expanded.ContainsKey(sheetId))
            await LoadSheetAsync(sheetId);
    }

    /// <summary>What is left of its budget, or, without one, what is left in the open container or what was used.</summary>
    private string State(ConsumptionSheetDto sheet, QuickItem item)
        => item.Balance is { } balance ? BudgetText(balance) : Remaining(sheet, item.Line!);

    /// <summary>"3 of 5 left" in the budget's unit, with the mL still in an open container; or how far over the budget it went.</summary>
    private string BudgetText(ConsumptionBalanceDto balance)
    {
        var unit = balance.Charge switch
        {
            ConsumptionCharge.Container => L["containers"].Value,
            ConsumptionCharge.Unit => L["u."].Value,
            _ => "mL"
        };
        string text = balance.Left >= 0
            ? L["{0} of {1} {2} left", Qty(balance.Left), Qty(balance.Budgeted), unit]
            : L["{0} {1} over the budget of {2}", Qty(-balance.Left), unit, Qty(balance.Budgeted)];
        return balance.LeftMl > 0 ? $"{text} · {L["{0} mL in the open one", Qty(balance.LeftMl)]}" : text;
    }

    /// <summary>What is left in the open container, or what was used for items that don't come in one.</summary>
    private string Remaining(ConsumptionSheetDto sheet, ConsumptionLineDto line) => line.Charge switch
    {
        ConsumptionCharge.Container when sheet.ClosedAtUtc is null => line.LeftMl > 0 ? L["{0} mL left", Qty(line.LeftMl)] : L["No open container"],
        ConsumptionCharge.Unit => L["{0} u. used", Qty(line.Given)],
        _ => L["{0} mL used", Qty(line.Given)]
    };

    private static string Qty(decimal value) => value.ToString("0.##");

    private string UnitText(ConsumptionCharge charge) => charge == ConsumptionCharge.Unit ? L["u."] : "mL";

    private async Task OpenAsync()
    {
        _busy = true;
        var result = await Api.OpenAsync(new OpenConsumptionSheetRequest
        {
            PetId = _registered ? _petId : null,
            PatientName = _registered ? null : _patientName,
            OwnerName = _registered ? null : _ownerName,
            Notes = _notes
        });
        _busy = false;
        if (!result.Ok)
        {
            _error = result.Error;
            return;
        }
        Navigation.NavigateTo($"consumption/{result.Id}");
    }
}

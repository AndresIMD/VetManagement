@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

@* A session opened with a temporary password only shows the page that changes it: the API refuses the rest (403).
   Read from the session's token, so it holds after a reload too. *@
@if (_allowed)
{
    @ChildContent
}

@code {
    // The API's SystemClaims: claim type and value of a session opened with a temporary password.
    public const string ClaimType = "sys";
    public const string MustChangePassword = "must-change-password";
    public const string Page = "force-change-password";

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _allowed;

    /// <summary>
    /// Whether the session was opened with a temporary password. Read from the stored token rather than the cascaded
    /// state, which right after the change can still be the previous token's.
    /// </summary>
    public static async Task<bool> MustChangeAsync(AuthenticationStateProvider auth)
        => (await auth.GetAuthenticationStateAsync()).User.HasClaim(ClaimType, MustChangePassword);

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override async Task OnParametersSetAsync() => await CheckAsync();

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await CheckAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CheckAsync()
    {
        var onPage = Nav.ToBaseRelativePath(Nav.Uri).StartsWith(Page, StringComparison.OrdinalIgnoreCase);
        _allowed = onPage || !await MustChangeAsync(AuthStateProvider);
        if (!_allowed)
            Nav.NavigateTo(Page);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

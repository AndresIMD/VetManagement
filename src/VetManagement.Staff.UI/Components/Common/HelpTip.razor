@* A (?) icon that shows an explanation on hover, focus or tap: for descriptions that would otherwise fill the screen. *@
<MudTooltip Arrow="true" Placement="Placement.Top" ShowOnHover="true" ShowOnFocus="true" ShowOnClick="true" Inline="true">
    <ChildContent>
        <MudIconButton Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" Color="Color.Default" Class="pa-0 ml-1"
                       aria-label="@Text" Style="opacity:.7" />
    </ChildContent>
    <TooltipContent>
        <div style="max-width:340px;text-align:left;white-space:pre-line">@Text</div>
    </TooltipContent>
</MudTooltip>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
}

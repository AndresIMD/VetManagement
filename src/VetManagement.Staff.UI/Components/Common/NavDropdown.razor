@using MudBlazor
@inherits ComponentBase

<div class="nav-dropdown @(_chosen ? "chosen" : null)" @onmouseenter="() => _chosen = false" @onfocusin="() => _chosen = false">
    <MudButton Color="Color.Inherit" Variant="Variant.Text" Class="nav-dropdown-btn">
        @Title
    </MudButton>
    <MudPaper Class="nav-dropdown-menu py-1">
        @foreach (var it in Items)
        {
            <a class="nav-dropdown-item" href="@it.Href" @onclick="() => _chosen = true">@it.Title</a>
        }
    </MudPaper>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public IEnumerable<(string Title, string? Href)> Items { get; set; } = Array.Empty<(string, string?)>();

    // After a link, the menu closes even though the mouse or the focus is still on it.
    private bool _chosen;
}

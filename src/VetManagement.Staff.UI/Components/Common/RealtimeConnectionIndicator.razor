@using VetManagement.Staff.UI.Services.Realtime
@using Microsoft.AspNetCore.Components.Authorization
@inject RealtimeService RealtimeService
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

@* Follows the connection as it is lost and comes back: the service keeps retrying and says when its state changes. *@
@switch (RealtimeService.State)
{
    case RealtimeState.Connected:
        <MudChip T="string" Icon="@Icons.Material.Filled.CloudDone" Color="Color.Success" Size="Size.Small">@L["Live"]</MudChip>
        break;
    case RealtimeState.Connecting:
        <MudChip T="string" Icon="@Icons.Material.Filled.CloudSync" Color="Color.Warning" Size="Size.Small">@L["Connecting..."]</MudChip>
        break;
    default:
        <MudChip T="string" Icon="@Icons.Material.Filled.CloudOff" Color="Color.Error" Size="Size.Small">@L["Offline"]</MudChip>
        break;
}

@code {
    protected override async Task OnInitializedAsync()
    {
        RealtimeService.OnStateChanged += OnStateChanged;
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        await ConnectOrDisconnectAsync();
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private async void OnAuthStateChanged(Task<AuthenticationState> task) => await ConnectOrDisconnectAsync();

    /// <summary>Signed in: connect (once; the service keeps the connection). Signed out: close it.</summary>
    private async Task ConnectOrDisconnectAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        try
        {
            if (user.Identity?.IsAuthenticated == true)
                await RealtimeService.InitializeAsync();
            else
                await RealtimeService.DisconnectAsync();
        }
        catch (Exception)
        {
            // The chip shows the state either way; the service retries on its own.
        }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        RealtimeService.OnStateChanged -= OnStateChanged;
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}

@if (Chips.Any())
{
    <MudStack Row="true" Spacing="1" Class="mt-2">
        @foreach (var chip in Chips)
        {
            <MudChip T="string"
                     Color="@chip.Color"
                     OnClose="@((MudChip<string> _) => ClearAsync(chip))">
                @chip.Label
            </MudChip>
        }
    </MudStack>
}

@code {
    [Parameter] public IEnumerable<FilterChipModel> Chips { get; set; } = Enumerable.Empty<FilterChipModel>();

    /// <summary>
    /// Runs after a chip clears its filter. The chips, the filter fields and the list are the page's, so the page passes its
    /// StateHasChanged here: a handler in this component only redraws this component.
    /// </summary>
    [Parameter, EditorRequired] public EventCallback Changed { get; set; }

    private Task ClearAsync(FilterChipModel chip)
    {
        chip.OnClear?.Invoke();
        return Changed.InvokeAsync();
    }
}

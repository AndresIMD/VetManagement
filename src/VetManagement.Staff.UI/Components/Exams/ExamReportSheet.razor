@using System.Globalization
@using VetManagement.Contracts.Exams
@using VetManagement.Domain.Exams
@inject IJSRuntime Js
@inject NavigationManager Navigation
@* The report as printed pages. Styles are inline (not app.css) so the element prints the same on its own (print.js). *@

<div id="@ElementId" class="xr-doc" style="font-family:'@Settings.FontFamily', Arial, sans-serif">
    <style>
        @BundledFontFaces
        @@page { size: @PageSize(Settings); margin: 0; }
        .xr-page { position: relative; overflow: hidden; background: #fff; color: #222; font-size: 10.5pt; line-height: 1.35; box-sizing: border-box; break-after: page; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .xr-page:last-child { break-after: auto; }
        @@media screen { .xr-page { box-shadow: 0 2px 12px rgba(0,0,0,.25); margin-bottom: 8mm; } }
        .xr-page * { box-sizing: border-box; }
        .xr-bg { position: absolute; z-index: 0; max-width: none; }
        .xr-content { position: relative; z-index: 1; height: 100%; display: flex; flex-direction: column; gap: 5mm; }
        .xr-header { display: flex; align-items: center; gap: 6mm; min-height: 18mm; }
        .xr-logo { flex-shrink: 0; }
        .xr-header-lines div:first-child { font-size: 15pt; font-weight: 700; letter-spacing: .5px; }
        .xr-box { border: 0.6mm solid; border-radius: 1mm; background: rgba(255,255,255,.82); }
        .xr-results-box { position: relative; overflow: hidden; flex: 1; display: flex; flex-direction: column; }
        .xr-results-box > .xr-bar, .xr-results-box > .xr-results { position: relative; z-index: 1; }
        .xr-bar { color: #fff; font-weight: 700; text-align: center; padding: 1.6mm; font-size: 11.5pt; letter-spacing: .4px; }
        /* Two columns that grow on their own: a long value wraps beside its label without pushing the other column down. */
        .xr-patient { display: grid; grid-template-columns: 1fr 1fr; gap: 0 8mm; padding: 3mm 8mm; text-transform: uppercase; }
        .xr-patient-col { display: flex; flex-direction: column; gap: 1mm; min-width: 0; }
        .xr-field { display: flex; align-items: baseline; gap: 1.5mm; }
        .xr-field b { white-space: nowrap; }
        .xr-field span { min-width: 0; overflow-wrap: anywhere; }
        /* Later pages: who the report is about, in a slim box like the patient one. */
        .xr-continued { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1mm 8mm; padding: 2mm 8mm; text-transform: uppercase; }
        /* A hair shorter than the paper when printing, so rounding never pushes the footer onto an extra page. */
        @@media print { .xr-page { height: @(Mm(PageHeight - 0.6))mm !important; } }
        .xr-results { padding: 3mm 6mm 5mm; flex: 1; display: flex; flex-direction: column; }
        .xr-table { width: 100%; align-self: stretch; table-layout: fixed; border-collapse: collapse; }
        /* A header word is never cut in half: a column at its header's estimated width may be a hair short of it. */
        .xr-table th { text-align: @ColumnTextAlign; vertical-align: bottom; font-size: .86em; text-transform: uppercase; padding: 2mm 1.5mm; border-bottom: 0.4mm solid #ccc; overflow-wrap: normal; hyphens: auto; }
        .xr-table td { text-align: @ColumnTextAlign; padding: 1.6mm 1.5mm; vertical-align: top; border-bottom: 0.2mm solid #eee; overflow-wrap: anywhere; }
        /* Bands one per line, or a written reference's own line breaks. */
        .xr-table td.xr-ref { white-space: pre-line; }
        /* The parameter names always align left; the other columns as the design says (centered unless chosen). */
        .xr-table th:first-child, .xr-table tr:not(.xr-section) > td:first-child { text-align: left; }
        .xr-flag { font-weight: 700; color: #C62828; }
        .xr-previous { color: #555; }
        .xr-table th.xr-previous { white-space: nowrap; }
        .xr-qual-row { display: flex; align-items: center; gap: 4mm; padding: 2mm 1.5mm; border-bottom: 0.2mm solid #eee; }
        .xr-qual-name { flex: 1; font-weight: 600; }
        /* Section titles over the parameters that follow them, in the section colour (the patient bar's unless chosen), across the
           whole box like its bars:
           over the results area's side padding (6 mm), the table cell with a strip on each side (the box clips any excess). */
        /* A notch under the main bars (11.5 pt), so they read as subsections of the exam: smaller text, slimmer band. */
        .xr-section td, .xr-qual-section { color: #fff; font-weight: 700; text-align: center; text-transform: uppercase; letter-spacing: .3px; font-size: min(.9em, 10.5pt); padding: 1mm 1.5mm; border-bottom: 0; }
        .xr-section td { position: relative; }
        .xr-section td::before, .xr-section td::after { content: ''; position: absolute; top: 0; bottom: 0; width: 7mm; background: inherit; }
        .xr-section td::before { right: calc(100% - 0.2mm); }
        .xr-section td::after { left: calc(100% - 0.2mm); }
        .xr-qual-section { margin: 2mm -6mm 0; }
        .xr-qual-previous { font-size: .86em; }
        .xr-pill { min-width: 34mm; padding: 1.2mm 4mm; border: 0.5mm solid; border-radius: 3mm; text-align: center; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; }
        /* The bar in its own column under "Reference value", as tall as a line of text (centred on the first one), so a line
           with a bar is no taller than one without. */
        .xr-gauge { display: flex; align-items: center; width: @(Mm(GAUGE_MM))mm; height: 1.35em; margin: 0 @(Settings.ColumnAlign == ColumnAlign.Center ? "auto" : "0"); }
        .xr-gauge-box { position: relative; flex: 1; height: .8em; border: 0.2mm solid #333; }
        .xr-gauge-tick { position: absolute; top: 0; bottom: 0; width: 0.2mm; background: #333; }
        .xr-gauge-mark { position: absolute; top: -0.2mm; bottom: -0.2mm; width: 0.8mm; margin-left: -0.4mm; background: #111; }
        .xr-gauge-mark.out { background: #C62828; }
        /* Arrows drawn as CSS triangles so they sit exactly in the middle of the bar, whatever the font. */
        .xr-gauge-edge { position: absolute; top: 50%; width: 0; height: 0; transform: translateY(-50%); border-top: .25em solid transparent; border-bottom: .25em solid transparent; }
        .xr-gauge-edge.low { left: 0.3mm; border-right: .36em solid #C62828; }
        .xr-gauge-edge.high { right: 0.3mm; border-left: .36em solid #C62828; }
        /* Legend, interpretation, criteria, signature and method: they fill the rest of the box, the method at its foot. */
        .xr-closing { flex: 1; display: flex; flex-direction: column; }
        /* At the foot of the page: the space opens under the results instead, and the method follows the block. */
        .xr-at-foot > .xr-conclusion { margin-top: auto; }
        .xr-at-foot > .xr-method { margin-top: 4mm; }
        .xr-interpretation { margin-top: 5mm; white-space: pre-line; }
        .xr-interpretation b { margin-right: 2.5mm; }
        .xr-method { align-self: center; margin-top: auto; padding: 1.4mm 6mm; border-radius: 3mm; color: #fff; font-weight: 700; }
        .xr-signed { margin-top: 4mm; text-align: right; font-size: .9em; }
        .xr-footer { text-align: center; font-size: 9.5pt; }
        /* An empty line of the footer keeps its height, so it prints as a gap. */
        .xr-footer-line { min-height: 1.35em; }
        .xr-disclaimer { margin-top: 1.5mm; }
        .xr-pageno { margin-top: 1.5mm; text-align: right; font-size: 8.5pt; color: #555; }
        .xr-note { font-size: .76em; color: #666; margin-top: 1mm; }
        .xr-criteria { margin-top: 5mm; font-size: .81em; }
        .xr-criteria-title { font-weight: 700; margin-bottom: 1.5mm; }
        .xr-criteria table { width: 100%; table-layout: fixed; border-collapse: collapse; }
        .xr-criteria th { color: #fff; font-weight: 600; padding: 1.2mm 1.5mm; }
        .xr-criteria th, .xr-criteria td { text-align: center; vertical-align: middle; white-space: pre-line; overflow-wrap: anywhere; }
        .xr-criteria td { padding: 1mm 1.5mm; border-bottom: 0.2mm solid #ccc; }
        /* Headings down the first column: a white line between them keeps each row apart. */
        .xr-criteria th[scope=row] { padding: 1mm 1.5mm; }
        .xr-criteria tr + tr > th[scope=row] { border-top: 0.2mm solid #fff; }
        /* More than 6 columns: equal ones would cut words in half; each takes the room its text needs. */
        .xr-criteria table.xr-wide { table-layout: auto; }
        .xr-criteria table.xr-wide th, .xr-criteria table.xr-wide td { overflow-wrap: break-word; }
    </style>

    @{ var pages = Paginate(); }
    @for (var i = 0; i < pages.Count; i++)
    {
        var rows = pages[i].Select(index => Report.Results[index]).ToList();
        var first = i == 0;
        var last = i == pages.Count - 1;
        <div class="xr-page" style="width:@(Mm(PageWidth))mm;height:@(Mm(PageHeight))mm">
            @if (Settings.BackgroundArea == BackgroundArea.Page)
            {
                @Background
            }

            <div class="xr-content" style="padding:@(Settings.MarginsMm.Top)mm @(Settings.MarginsMm.Right)mm @(Settings.MarginsMm.Bottom)mm @(Settings.MarginsMm.Left)mm">
                @if (HasHeader)
                {
                    <div class="xr-header">
                        @if (LogoUrl is not null)
                        {
                            <img class="xr-logo" src="@LogoUrl" alt="Logo" style="@LogoStyle" />
                        }
                        <div class="xr-header-lines">
                            @foreach (var line in Settings.HeaderLines)
                            {
                                <div>@line</div>
                            }
                        </div>
                    </div>
                }

                @if (first && Report.Sections.PatientData)
                {
                    <div class="xr-box xr-patient-box" style="border-color:@Settings.HeaderColor">
                        <div class="xr-bar" style="background:@Settings.HeaderColor">@L["PET AND OWNER DATA"]</div>
                        <div class="xr-patient" style="font-size:@(Mm(Settings.PatientFontPt))pt">
                            <div class="xr-patient-col">
                                <div class="xr-field"><b>@L["PATIENT:"]</b><span>@Report.PetName</span></div>
                                <div class="xr-field"><b>@L["SPECIES:"]</b><span>@(Placeholder ? L["SPECIES – BREED"] : SpeciesAndBreed)</span></div>
                                <div class="xr-field"><b>@L["AGE:"]</b><span>@(Placeholder ? Upper(L["Age"]) : Age)</span></div>
                                <div class="xr-field"><b>@L["SEX:"]</b><span>@(Placeholder ? Upper(L["Sex"]) : SexName)</span></div>
                            </div>
                            <div class="xr-patient-col">
                                <div class="xr-field"><b>@L["OWNER:"]</b><span>@Report.OwnerName</span></div>
                                <div class="xr-field"><b>@L["REFERRING VET:"]</b><span>@Report.ReferringVet</span></div>
                                <div class="xr-field"><b>@L["RECEIVED ON:"]</b><span>@ReceivedOn</span></div>
                            </div>
                        </div>
                    </div>
                }
                else if (!first && Settings.PatientDataOnLaterPages)
                {
                    @* Later pages: the patient box's bar over who the report is about, spread across the box. *@
                    <div class="xr-box xr-continued-box" style="border-color:@Settings.HeaderColor">
                        <div class="xr-bar" style="background:@Settings.HeaderColor">@L["PET AND OWNER DATA"]</div>
                        <div class="xr-continued" style="font-size:@(Mm(Settings.PatientFontPt))pt">
                            <div class="xr-field"><b>@L["PATIENT:"]</b><span>@Report.PetName</span></div>
                            @if (!string.IsNullOrWhiteSpace(Report.OwnerName))
                            {
                                <div class="xr-field"><b>@L["OWNER:"]</b><span>@Report.OwnerName</span></div>
                            }
                            <div class="xr-field"><b>@L["RECEIVED ON:"]</b><span>@ReceivedOn</span></div>
                        </div>
                    </div>
                }

                <div class="xr-box xr-results-box" style="border-color:@Settings.AccentColor">
                    @if (Settings.BackgroundArea == BackgroundArea.ResultsBox)
                    {
                        @Background
                    }
                    <div class="xr-bar" style="background:@Settings.AccentColor">@ReportText.Title(Report.Title)</div>
                    <div class="xr-results" style="font-size:@(Mm(Settings.ResultsFontPt))pt">
                        @if (rows.Count > 0 && Qualitative)
                        {
                            <div>
                                @foreach (var line in rows)
                                {
                                    @if (line.Kind == ReportParameterKind.PageBreak)
                                    {
                                        continue;
                                    }
                                    @if (line.Kind == ReportParameterKind.Section)
                                    {
                                        <div class="xr-qual-section" style="background:@Settings.SectionBarColor;color:@Settings.SectionTextColor" data-row="@RowIndex(line)">@line.Name</div>
                                        continue;
                                    }
                                    <div class="xr-qual-row" data-row="@RowIndex(line)">
                                        <span class="xr-qual-name">@line.Name</span>
                                        @if (HasPrevious && !string.IsNullOrEmpty(line.PreviousValue))
                                        {
                                            <span class="xr-previous xr-qual-previous">@PreviousHeader: @line.PreviousValue</span>
                                        }
                                        <span class="xr-pill" style="@PillStyle(line)">@line.Value</span>
                                    </div>
                                }
                            </div>
                        }
                        else if (rows.Count > 0)
                        {
                            <table class="xr-table">
                                <colgroup>
                                    @foreach (var width in _columns.Percents)
                                    {
                                        <col style="width:@(Mm(Math.Round(width, 3)))%" />
                                    }
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>@L["Parameter"]</th><th>@L["Result"]</th><th>@L["Unit"]</th>
                                        @if (HasReference)
                                        {
                                            @* Over the range and, when the report has bars, their column too. *@
                                            <th colspan="@ReferenceColumns">@L["Reference value"]</th>
                                        }
                                        @if (HasPrevious)
                                        {
                                            <th class="xr-previous">@PreviousHeader</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in rows)
                                    {
                                        @if (line.Kind == ReportParameterKind.PageBreak)
                                        {
                                            continue;
                                        }
                                        @if (line.Kind == ReportParameterKind.Section)
                                        {
                                            <tr class="xr-section" data-row="@RowIndex(line)"><td colspan="@_columns.Percents.Length" style="background:@Settings.SectionBarColor;color:@Settings.SectionTextColor">@line.Name</td></tr>
                                            continue;
                                        }
                                        <tr data-row="@RowIndex(line)">
                                            <td>@line.Name</td>
                                            <td class="@(line.Abnormal ? "xr-flag" : null)">@line.Value @Mark(line)</td>
                                            <td>@line.Unit</td>
                                            @if (HasReference && HasBar(line))
                                            {
                                                <td class="xr-ref">@line.Reference</td>
                                                <td>@Gauge(line)</td>
                                            }
                                            else if (HasReference)
                                            {
                                                @* A line without a bar writes its reference across the bars' column too. *@
                                                <td class="xr-ref" colspan="@ReferenceColumns">@line.Reference</td>
                                            }
                                            @if (HasPrevious)
                                            {
                                                <td class="xr-previous">@line.PreviousValue</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        @if (last)
                        {
                            <div class="xr-closing @(Report.Sections.InterpretationAtFoot ? "xr-at-foot" : null)">
                            @if (Legend is { } legend)
                            {
                                <div class="xr-note">@legend</div>
                            }
                            @if (HasConclusion)
                            {
                                @* The interpretation reads first, then the table behind it and the signature: one block, so it can sit at the foot. *@
                                <div class="xr-conclusion">
                                    @if (ShowsInterpretation)
                                    {
                                        <div class="xr-interpretation"><b>@L["INTERPRETATION:"]</b> @Report.Interpretation</div>
                                    }
                                    @if (Report.Criteria is { Columns.Count: > 0 } criteria)
                                    {
                                        <div class="xr-criteria">
                                            @if (!string.IsNullOrWhiteSpace(criteria.Title))
                                            {
                                                <div class="xr-criteria-title">@criteria.Title</div>
                                            }
                                            <table class="@(criteria.Columns.Count > 6 ? "xr-wide" : null)">
                                                <tr>
                                                    @for (var c = 0; c < criteria.Columns.Count; c++)
                                                    {
                                                        @CriteriaCell(criteria, criteria.Columns[c], firstRow: true, c)
                                                    }
                                                </tr>
                                                @foreach (var row in criteria.Rows)
                                                {
                                                    <tr>
                                                        @for (var c = 0; c < row.Count; c++)
                                                        {
                                                            @CriteriaCell(criteria, row[c], firstRow: false, c)
                                                        }
                                                    </tr>
                                                }
                                            </table>
                                        </div>
                                    }
                                    @if (Report.Sections.ReportedBy)
                                    {
                                        <div class="xr-signed">@L["Reported by: {0}", Report.CreatedBy ?? ""]</div>
                                    }
                                </div>
                            }
                            @if (MethodLine is { } methodLine)
                            {
                                <div class="xr-method" style="background:@Settings.HeaderColor">@methodLine</div>
                            }
                            </div>
                        }
                    </div>
                </div>

                <div class="xr-footer">
                    @foreach (var footerLine in ReportText.Lines(Settings.Footer))
                    {
                        <div class="xr-footer-line">@foreach (var span in ReportText.Spans(footerLine)) { if (span.Bold) { <b>@span.Text</b> } else { <text>@span.Text</text> } }</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Settings.Disclaimer))
                    {
                        <div class="xr-disclaimer">@Settings.Disclaimer</div>
                    }
                    <div class="xr-pageno">@L["Page {0} of {1}", i + 1, pages.Count]</div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    public const string ElementId = "exam-report-sheet";

    [Parameter, EditorRequired] public ExamReportSettings Settings { get; set; } = new();
    [Parameter, EditorRequired] public ExamReportDto Report { get; set; } = new();
    /// <summary>Patient block shows field names instead of data (design previews).</summary>
    [Parameter] public bool Placeholder { get; set; }
    [Parameter] public string? LogoUrl { get; set; }
    [Parameter] public string? BackgroundUrl { get; set; }

    /// <summary>A report made of field names, for previews: pass results to show a real template's lines.</summary>
    public static ExamReportDto PlaceholderReport(string? title = null, string? method = null, List<ExamReportResultDto>? results = null,
        string? interpretation = null, ExamReportSectionsDto? sections = null) => new()
    {
        Title = string.IsNullOrWhiteSpace(title) ? Strings.T("EXAM TITLE") : title,
        Method = method ?? Strings.T("Brand - Machine"),
        PetName = Strings.T("Patient name"),
        OwnerName = Strings.T("Owner name"),
        ReferringVet = Strings.T("Referring vet"),
        CreatedBy = Strings.T("Responsible"),
        Interpretation = interpretation ?? (results is null ? Strings.T("Interpretation of the result.") : null),
        Sections = sections ?? new ExamReportSectionsDto { PatientData = true, Method = true, Interpretation = true },
        Results = results ??
        [
            new ExamReportResultDto { Name = Strings.T("Parameter"), Value = Strings.T("Result"), Unit = Strings.T("Unit"), Reference = Strings.T("Reference value") },
            new ExamReportResultDto { Name = Strings.T("Parameter with bar"), Value = "4.1", Unit = Strings.T("Unit"), Reference = "3.5 - 5.8", BarMin = 3.5m, BarMax = 5.8m },
            new ExamReportResultDto { Name = Strings.T("Out of range"), Value = "6.4", Unit = Strings.T("Unit"), Reference = "3.5 - 5.8", BarMin = 3.5m, BarMax = 5.8m, Abnormal = true, Direction = ResultDirection.High }
        ]
    };

    /// <summary>
    /// The PDF name the print dialog suggests: INFORME-EXAMEN_MASCOTA-APELLIDO_dd-MM-aaaa (no characters Windows rejects).
    /// </summary>
    public static string FileName(ExamReportDto report)
    {
        static string Part(string? text) => string.Join("-", (text ?? string.Empty).ToUpperInvariant()
            .Split([' ', '/', '\\', ':', '*', '?', '"', '<', '>', '|', '.'], StringSplitOptions.RemoveEmptyEntries));
        var patient = string.Join("-", new[] { Part(report.PetName), Part(report.OwnerLastName) }.Where(p => p.Length > 0));
        return $"{Part(Strings.T("REPORT"))}-{Part(report.ExamName ?? report.Title)}_{patient}_{report.ReceivedOn:dd-MM-yyyy}";
    }

    /// <summary>The paper as a CSS @page size, so the print dialog uses exactly the sheet's paper.</summary>
    public static string PageSize(ExamReportSettings settings) => settings.Paper == PaperSize.A4 ? "210mm 297mm" : "215.9mm 279.4mm";

    private double PageWidth => Settings.Paper == PaperSize.A4 ? 210 : 215.9;
    private double PageHeight => Settings.Paper == PaperSize.A4 ? 297 : 279.4;
    private static string Mm(double value) => value.ToString(CultureInfo.InvariantCulture);
    private string ReceivedOn => Placeholder ? Upper(L["dd/mm/yyyy"]) : Report.ReceivedOn.ToString("dd/MM/yyyy");
    /// <summary>Printed labels and values are upper case: the same texts as the screens, upper-cased.</summary>
    private static string Upper(string text) => text.ToUpper(CultureInfo.CurrentCulture);
    private bool HasHeader => LogoUrl is not null || Settings.HeaderLines.Count > 0;
    /// <summary>
    /// The line draws a bar: its range has both limits and the value is a number ("No medible" has nothing to mark). The
    /// template's preview shows the bars of its empty values, to lay out the design.
    /// </summary>
    private bool HasBar(ExamReportResultDto line)
        => line is { BarMin: { } min, BarMax: { } max } && max > min && (Placeholder || ReportParameter.ParseNumber(line.Value) is not null);
    private bool HasPrevious => Report.Sections.PreviousResult && (Report.PreviousReceivedOn is not null || Placeholder);
    private string PreviousHeader => Report.PreviousReceivedOn?.ToString("dd/MM/yyyy") ?? Upper(L["dd/mm/yyyy"]);
    /// <summary>Exams read without a reference (e.g. cortisol samples judged together by the rules) drop the column.</summary>
    private bool HasReference => Report.Results.Any(r => !string.IsNullOrWhiteSpace(r.Reference) || HasBar(r));
    /// <summary>The report draws bars: they get a column of their own under "Reference value", next to the ranges.</summary>
    private bool HasBars => Values.Any(HasBar);
    /// <summary>Columns under "Reference value": the range, and the bars when there are any.</summary>
    private int ReferenceColumns => HasBars ? 2 : 1;
    private string ColumnTextAlign => Settings.ColumnAlign == ColumnAlign.Left ? "left" : "center";

    /// <summary>
    /// The table's columns: parameter, result, unit, [reference: range, bars], [previous result]; each as wide as this
    /// report's widest text in it, the room left shared out evenly (see <see cref="ReportColumns"/>).
    /// </summary>
    private ReportColumns.Layout _columns = new([100], [0]);

    /// <summary>
    /// Works the columns out from the texts of the report, each at least as wide as its header. Names wrap past 40 % of the
    /// table and written references past 45 %, rather than crowd the other columns. "Reference value" spans the ranges and
    /// the bars: a reference without a bar, and the header, may use both.
    /// </summary>
    private void LayOutColumns()
    {
        var values = Values.ToList();
        // A text on several lines (bands one per line) is as wide as its widest line.
        double Widest(IEnumerable<string?> texts, bool bold = false)
            => texts.SelectMany(t => (t ?? string.Empty).Split('\n')).Select(t => TextMm(t, bold: bold)).DefaultIfEmpty(0).Max();
        double Header(string text) => TextMm(Upper(text), HEADER_EM, bold: true);
        var widest = new List<double>
        {
            Math.Min(Widest(values.Select(r => r.Name)), ContentWidth * .4),
            Widest(values.Select(r => $"{r.Value} {Mark(r)}"), bold: true),
            Widest(values.Select(r => r.Unit))
        };
        var headers = new List<double> { Header(L["Parameter"]), Header(L["Result"]), Header(L["Unit"]) };
        if (HasReference)
        {
            var spanning = Math.Max(Widest(values.Where(r => !HasBar(r)).Select(r => r.Reference)), Header(L["Reference value"]));
            if (HasBars)
            {
                var barCell = GAUGE_MM + CELL_PADDING_MM;
                widest.AddRange([Math.Min(Math.Max(Widest(values.Where(HasBar).Select(r => r.Reference)), spanning - barCell), ContentWidth * .45), GAUGE_MM]);
                headers.AddRange([0, 0]);
            }
            else
            {
                widest.Add(Math.Min(spanning, ContentWidth * .45));
                headers.Add(Header(L["Reference value"]));
            }
        }
        if (HasPrevious)
        {
            widest.Add(Widest(values.Select(r => r.PreviousValue)));
            headers.Add(TextMm(PreviousHeader, HEADER_EM, bold: true));
        }
        _columns = ReportColumns.Lay(widest, headers, ContentWidth, CELL_PADDING_MM, centered: Settings.ColumnAlign == ColumnAlign.Center);
    }

    /// <summary>
    /// Rough width of a text in mm at the results size (times <paramref name="size"/>), on the generous side like the other
    /// estimates: narrow letters count less, wide and capital ones more (within 3 % of Segoe UI), times how wide the font
    /// runs; 4 % more, or 10 % for bold.
    /// </summary>
    private double TextMm(string? text, double size = 1, bool bold = false)
    {
        var (figures, letters) = FontWidths.GetValueOrDefault(Settings.FontFamily, (1.2, 1.2));
        return (text ?? string.Empty).Sum(c => c switch
        {
            ' ' or '.' or ',' or ':' or ';' or '\'' or '|' or '!' or 'i' or 'l' or 'j' or 'I' => 0.3,
            'f' or 't' or 'r' or '(' or ')' or '[' or ']' or '/' or '-' => 0.4,
            'm' or 'w' or 'M' or 'W' or '%' or '@' => 0.85,
            _ when char.IsUpper(c) => 0.65,
            _ => 0.55
        } * (char.IsDigit(c) ? figures : letters)) * Settings.ResultsFontPt * MM_PER_PT * size * (bold ? 1.1 : 1.04);
    }

    /// <summary>
    /// How wide each report font runs next to Segoe UI, for figures (zero-heavy ranges such as "200000 - 500000" count) and
    /// for letters, measured on typical report texts. Century Gothic wasn't installed where they were measured and counts as
    /// wide, like any font not listed.
    /// </summary>
    private static readonly Dictionary<string, (double Figures, double Letters)> FontWidths = new()
    {
        ["Segoe UI"] = (1, 1), ["Arial"] = (1.03, 1.02), ["Calibri"] = (.94, .92), ["Verdana"] = (1.2, 1.13),
        ["Tahoma"] = (1.03, 1), ["Trebuchet MS"] = (1.01, .99), ["Century Gothic"] = (1.2, 1.2), ["Georgia"] = (1.06, 1.03),
        ["Cambria"] = (1.01, .97), ["Times New Roman"] = (.93, .95), ["Inter"] = (1.11, 1.07), ["Figtree"] = (1.1, 1.02),
        ["Jost"] = (1.05, .97)
    };

    /// <summary>Only text results (Positivo / Negativo, blood types): each prints as a highlighted result, no table.</summary>
    private bool Qualitative => Values.Any() && Values.All(r => r.Kind == ReportParameterKind.Text);

    /// <summary>The results without section titles and page breaks.</summary>
    private IEnumerable<ExamReportResultDto> Values => Report.Results.Where(r => r.Kind.TakesValue());

    /// <summary>Abnormal results in solid red; the others outlined in the clinic's result colour.</summary>
    private string PillStyle(ExamReportResultDto line) => line.Abnormal
        ? "background:#C62828;border-color:#C62828;color:#fff"
        : $"border-color:{Settings.AccentColor};color:{Settings.AccentColor}";

    private RenderFragment Background => __builder =>
    {
        if (BackgroundUrl is null)
            return;
        <img class="xr-bg" src="@BackgroundUrl" alt="" style="@BackgroundStyle" />
    };

    /// <summary>
    /// Stretched over the whole area, or keeping its proportions: filling the width (aligned top / centre / bottom) or the
    /// height (aligned left / centre / right); the area clips what overflows.
    /// </summary>
    private string BackgroundStyle
    {
        get
        {
            var opacity = $"opacity:{Settings.BackgroundOpacity.ToString(CultureInfo.InvariantCulture)};";
            if (!Settings.BackgroundKeepRatio)
                return opacity + "inset:0;width:100%;height:100%;object-fit:fill";
            var (side, across, size) = Settings.BackgroundFit == ImageFit.Width
                ? ("left:0;", "top", "width:100%;height:auto;")
                : ("top:0;", "left", "height:100%;width:auto;");
            var place = Settings.BackgroundAlign switch
            {
                ImageAlign.Start => $"{across}:0;",
                ImageAlign.End => $"{(across == "top" ? "bottom" : "right")}:0;",
                _ => $"{across}:50%;transform:translate{(across == "top" ? "Y" : "X")}(-50%);"
            };
            return opacity + side + size + place;
        }
    }

    /// <summary>The chosen height; the width follows the proportions, or is the chosen width when they aren't kept.</summary>
    private string LogoStyle => Settings.LogoKeepRatio
        ? $"height:{Settings.LogoHeightMm}mm;width:auto;max-width:150mm"
        : $"height:{Settings.LogoHeightMm}mm;width:{Settings.LogoWidthMm}mm;object-fit:fill";

    /// <summary>Height of the header row: the logo or the header lines, whichever is taller.</summary>
    private double HeaderMm => Math.Max(LogoUrl is null ? 0 : Settings.LogoHeightMm, Math.Max(18, Settings.HeaderLines.Count * 6));

    /// <summary>↑ / ↓ when the template prints arrows; "*" marks the other flagged values (abnormal band, outside every band).</summary>
    private string? Mark(ExamReportResultDto line) => line switch
    {
        { Direction: ResultDirection.High } when Report.Sections.DirectionArrows => "↑",
        { Direction: ResultDirection.Low } when Report.Sections.DirectionArrows => "↓",
        { Direction: ResultDirection.None, Abnormal: true } => "*",
        _ => null
    };

    /// <summary>Explains only the marks this report prints.</summary>
    private string? Legend
    {
        get
        {
            if (Qualitative)
                return null; // the red result speaks for itself
            var marks = Report.Results.Select(Mark).ToHashSet();
            var parts = new[]
            {
                marks.Contains("↑") ? L["↑ Above the range"].Value : null,
                marks.Contains("↓") ? L["↓ Below the range"].Value : null,
                marks.Contains("*") ? L["* Outside the reference"].Value : null,
                Report.Results.Any(r => r.Abnormal) ? L["In red: abnormal result"].Value : null
            }.OfType<string>().ToList();
            return parts.Count == 0 ? null : string.Join(" · ", parts);
        }
    }

    /// <summary>Width of the bar, in mm.</summary>
    private const double GAUGE_MM = 25;

    /// <summary>
    /// IDEXX-style bar, beside the reference: the normal range is the middle third; the mark sits where the value falls,
    /// and a value beyond the bar shows as an arrow at its edge.
    /// </summary>
    private RenderFragment Gauge(ExamReportResultDto line) => __builder =>
    {
        if (!HasBar(line))
            return;
        var (min, max) = (line.BarMin!.Value, line.BarMax!.Value);
        var value = ReportParameter.ParseNumber(line.Value);
        var position = value is { } v ? (double)(1m / 3 + (v - min) / (max - min) / 3) : (double?)null;
        <div class="xr-gauge">
            <div class="xr-gauge-box">
                <div class="xr-gauge-tick" style="left:33.33%"></div>
                <div class="xr-gauge-tick" style="left:66.67%"></div>
                @if (position is < 0)
                {
                    <span class="xr-gauge-edge low"></span>
                }
                else if (position is > 1)
                {
                    <span class="xr-gauge-edge high"></span>
                }
                else if (position is { } p)
                {
                    <div class="xr-gauge-mark @(line.Abnormal ? "out" : null)" style="left:@Mm(p * 100)%"></div>
                }
            </div>
        </div>
    };

    /// <summary>A criteria table cell: a heading in the header colour where the table's headers go, plain otherwise.</summary>
    private RenderFragment CriteriaCell(CriteriaTableDto table, string? text, bool firstRow, int column) => __builder =>
    {
        var scope = firstRow && table.Headers.InFirstRow() ? "col" : column == 0 && table.Headers.InFirstColumn() ? "row" : null;
        if (scope is null)
        {
            <td>@text</td>
        }
        else
        {
            <th scope="@scope" style="background:@Settings.HeaderColor">@text</th>
        }
    };

    // Estimates in mm, deliberately on the high side: a page holds a little less than it could rather than clip a row.
    // They lay out the sheet until it is measured (report-sheet.js), and stand in when it can't be (e.g. hidden).
    private const double LINE_MM = 5.0;
    private const double CHAR_MM = 1.95;
    private const double GAP_MM = 5;
    private const double MM_PER_PT = 0.3528;
    /// <summary>A table cell's padding, left and right together.</summary>
    private const double CELL_PADDING_MM = 3;
    /// <summary>The table headers' text size, relative to the results'.</summary>
    private const double HEADER_EM = .86;
    /// <summary>Kept free on each page of a measured sheet, against rounding and the browser's print layout.</summary>
    private const double SAFETY_MM = 2;

    /// <summary>The rendered sheet's sizes in mm (see report-sheet.js).</summary>
    private sealed record SheetMeasures(double FirstRoom, double? NextRoom, double PatientBox, double? Continued, double Header, double Closing,
        double[] Rows);

    private SheetMeasures? _measures;
    private string? _measuredFor;
    private string? _layout;

    /// <summary>What the page layout depends on; when it changes, the sheet is measured again.</summary>
    private string Layout() => System.Text.Json.JsonSerializer.Serialize(new
    {
        Report, Placeholder, Logo = LogoUrl?.Length, Settings.Paper, Settings.MarginsMm, Settings.FontFamily, Settings.PatientFontPt,
        Settings.ResultsFontPt, Settings.PatientDataOnLaterPages, Settings.HeaderLines, Settings.Footer, Settings.Disclaimer,
        Settings.LogoHeightMm, Settings.LogoWidthMm, Settings.LogoKeepRatio, Settings.ColumnAlign
    });

    protected override void OnParametersSet()
    {
        LayOutColumns();
        _layout = Layout();
        if (_layout != _measuredFor)
            _measures = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_measures is not null || _layout is null || _layout == _measuredFor)
            return;
        var layout = _layout;
        var measures = await Js.InvokeAsync<SheetMeasures?>("appReportSheet.measure", ElementId, PageHeight);
        _measuredFor = layout;
        if (measures is null || layout != _layout)
            return;
        _measures = measures;
        StateHasChanged();
    }

    private int RowIndex(ExamReportResultDto line) => Report.Results.IndexOf(line);

    /// <summary>
    /// The fonts shipped with the app (wwwroot/fonts), by absolute address so the copy printed on its own finds them too. A
    /// browser only downloads the one in use.
    /// </summary>
    private string BundledFontFaces => string.Concat(ExamReportSettings.BundledFonts.SelectMany(font =>
    {
        var file = font.ToLowerInvariant();
        return new[]
        {
            ("latin", "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD"),
            ("latin-ext", "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF")
        }.Select(subset => $"@font-face {{ font-family: '{font}'; font-weight: 100 900; font-display: block; " +
                            $"src: url('{Navigation.BaseUri}_content/VetManagement.Staff.UI/fonts/{file}/{file}-{subset.Item1}-wght-normal.woff2') format('woff2'); " +
                            $"unicode-range: {subset.Item2}; }}\n");
    }));

    /// <summary>Splits the result lines into pages (indexes into the results); the closing blocks go on the last one.</summary>
    private List<List<int>> Paginate()
    {
        var sections = Report.Results.Select(r => r.Kind == ReportParameterKind.Section).ToList();
        var pageBreaks = Report.Results.Select(r => r.Kind == ReportParameterKind.PageBreak).ToList();
        if (_measures is { } m && m.Rows.Length == Report.Results.Count)
        {
            var header = Qualitative ? 0 : m.Header;
            // A later page has the slim patient box instead of the first page's one, or none when the design leaves it out.
            var laterBox = Settings.PatientDataOnLaterPages ? m.Continued ?? 16 : 0;
            var next = m.NextRoom ?? ReportPagination.LaterRoom(m.FirstRoom, m.PatientBox, laterBox, GAP_MM);
            return ReportPagination.Split(m.Rows, sections, m.FirstRoom - header - SAFETY_MM, next - header - SAFETY_MM, m.Closing, pageBreaks);
        }
        var (first, later, closing) = Estimates();
        return ReportPagination.Split(Report.Results.Select(RowMm).ToList(), sections, first, later, closing, pageBreaks);
    }

    /// <summary>Room for lines on the first and later pages, and the closing blocks' height, estimated.</summary>
    private (double First, double Next, double Closing) Estimates()
    {
        var disclaimerLines = string.IsNullOrWhiteSpace(Settings.Disclaimer) ? 0 : Lines(Settings.Disclaimer, ContentWidth);
        var footerMm = ReportText.Lines(Settings.Footer).Length * LINE_MM + disclaimerLines * LINE_MM + 8;
        var frameMm = PageHeight - Settings.MarginsMm.Top - Settings.MarginsMm.Bottom
            - (HasHeader ? HeaderMm + 2 + GAP_MM : 0) - footerMm - GAP_MM
            - 26; // result bar, table header and box padding
        // Patient box: its bar and padding, plus four lines of data at the chosen size.
        var firstMm = frameMm - (Report.Sections.PatientData ? 16 + 22 * Settings.PatientFontPt / ExamReportSettings.DefaultFontPt + GAP_MM : 0);
        // The slim patient box of later pages, unless the design leaves it out.
        var nextMm = frameMm - (Settings.PatientDataOnLaterPages ? 18 * Settings.PatientFontPt / ExamReportSettings.DefaultFontPt + GAP_MM : 0);

        var closingMm = 6.0
            + (ShowsInterpretation ? 5 + (Report.Interpretation!.Split('\n').Sum(l => ResultLines(l, ContentWidth)) + 0.5) * ResultLineMm : 0)
            + (Report.Sections.ReportedBy ? 9 : 0)
            + (MethodLine is null ? 0 : 12 + (Report.Sections.InterpretationAtFoot ? 4 : 0))
            + CriteriaMm();

        return (firstMm, nextMm, closingMm);
    }

    private double ContentWidth => PageWidth - Settings.MarginsMm.Left - Settings.MarginsMm.Right - 14;

    private double RowMm(ExamReportResultDto line)
    {
        if (line.Kind == ReportParameterKind.PageBreak)
            return 0;
        var widths = _columns.Text;
        if (line.Kind == ReportParameterKind.Section)
            return ResultLines(line.Name, ContentWidth) * ResultLineMm + (Qualitative ? 5 : 3);
        if (Qualitative)
            return Math.Max(1, ResultLines(line.Name, ContentWidth - 80)) * ResultLineMm + 6;
        // A range next to its bar wraps in its own column; a reference without a bar also has the bars' column.
        var reference = !HasReference || string.IsNullOrEmpty(line.Reference) ? 0
            : ResultLines(line.Reference, HasBars && !HasBar(line) ? widths[3] + widths[4] + CELL_PADDING_MM : widths[3]);
        var previous = HasPrevious ? ResultLines(line.PreviousValue, widths[^1]) : 1;
        var lines = new[] { ResultLines(line.Name, widths[0]), ResultLines($"{line.Value} *", widths[1]), ResultLines(line.Unit, widths[2]), reference, previous }.Max();
        return lines * ResultLineMm + 3.6;
    }

    private bool ShowsInterpretation => Report.Sections.Interpretation && !string.IsNullOrWhiteSpace(Report.Interpretation);

    /// <summary>The interpretation, the criteria table or the signature: the block that can sit at the foot of the page.</summary>
    private bool HasConclusion => ShowsInterpretation || Report.Criteria is { Columns.Count: > 0 } || Report.Sections.ReportedBy;

    /// <summary>The criteria table: title, header and each row as tall as its fullest cell (smaller print, ~0.85 of a line).</summary>
    private double CriteriaMm()
    {
        if (Report.Criteria is not { Columns.Count: > 0 } table)
            return 0;
        var width = ContentWidth / table.Columns.Count - 3;
        double RowLines(IEnumerable<string?> cells) => cells.Max(c => (c ?? string.Empty).Split('\n').Sum(l => ResultLines(l, width)));
        var lines = RowLines(table.Columns) + table.Rows.Sum(r => r.Count == 0 ? 1 : RowLines(r));
        return 5 + (string.IsNullOrWhiteSpace(table.Title) ? 0 : ResultLineMm + 1.5) + lines * ResultLineMm * 0.85 + (table.Rows.Count + 1) * 2.4;
    }

    /// <summary>Results print at their own size: lines are taller and hold fewer characters as it grows.</summary>
    private double ResultScale => Settings.ResultsFontPt / ExamReportSettings.DefaultFontPt;
    private double ResultLineMm => LINE_MM * ResultScale;
    /// <summary>Lines a text takes at the results' size; each of its own lines wraps on its own.</summary>
    private int ResultLines(string? text, double widthMm) => (text ?? string.Empty).Split('\n').Sum(line => Lines(line, widthMm / ResultScale));

    private static int Lines(string? text, double widthMm)
        => string.IsNullOrEmpty(text) ? 1 : Math.Max(1, (int)Math.Ceiling(text.Length * CHAR_MM / Math.Max(widthMm, 10)));

    private string SpeciesAndBreed
    {
        get
        {
            var species = Report.Species switch
            {
                Species.Dog => L["Canine"],
                Species.Cat => L["Feline"],
                Species.Bird => L["Bird"],
                Species.Fish => L["Fish"],
                Species.Reptile => L["Reptile"],
                Species.Unknown => null,
                _ => Report.Species.ToText()
            };
            return string.Join(" – ", new[] { species, Report.Breed }.Where(s => !string.IsNullOrWhiteSpace(s))).ToUpperInvariant();
        }
    }

    /// <summary>Method bar: "Vcheck - BIONOTE · LOTE: A123". The lot prints whenever it was given, even without a method.</summary>
    private string? MethodLine
    {
        get
        {
            var method = Report.Sections.Method && !string.IsNullOrWhiteSpace(Report.Method) ? Report.Method : null;
            var lot = !string.IsNullOrWhiteSpace(Report.LotNumber) ? L["LOT: {0}", Report.LotNumber].Value
                : Placeholder && Report.Sections.LotNumber ? L["LOT: LOT NUMBER"].Value : null;
            return method is null && lot is null ? null : string.Join(" · ", new[] { method, lot }.Where(s => s is not null));
        }
    }

    private string? SexName => Report.Sex switch
    {
        Sex.Female => Upper(L["Female"]),
        Sex.Male => Upper(L["Male"]),
        _ => null
    };

    /// <summary>Age on the reception date: "4 AÑOS Y 11 MESES", "10 MESES".</summary>
    private string? Age
    {
        get
        {
            if (Report.Birthdate is not { } born)
                return null;
            var on = Report.ReceivedOn.ToDateTime(TimeOnly.MinValue);
            var months = (on.Year - born.Year) * 12 + on.Month - born.Month - (on.Day < born.Day ? 1 : 0);
            if (months < 0)
                return null;
            var (years, rest) = (months / 12, months % 12);
            var yearsText = years == 1 ? L["1 YEAR"].Value : L["{0} YEARS", years].Value;
            var monthsText = rest == 1 ? L["1 MONTH"].Value : Upper(L["{0} months", rest]);
            return (years, rest) switch
            {
                (0, _) => monthsText,
                (_, 0) => yearsText,
                _ => L["{0} AND {1}", yearsText, monthsText].Value
            };
        }
    }
}

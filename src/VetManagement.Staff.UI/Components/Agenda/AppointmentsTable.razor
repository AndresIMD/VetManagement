@using VetManagement.Contracts.Scheduling
@using VetManagement.Domain.Enums

@if (Items.Count == 0)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">@EmptyText</MudText>
}
else
{
    <MudTable Items="Items" Dense="true" Hover="true" Elevation="0">
        <HeaderContent>
            <MudTh>@(ShowDate ? L["Date"] : L["Time"])</MudTh>
            <MudTh>@L["Service"]</MudTh>
            <MudTh>@L["Vet / room"]</MudTh>
            <MudTh>@L["Owner · pet"]</MudTh>
            <MudTh>@L["Status"]</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.StartUtc.ToLocalTime().ToString(ShowDate ? "dd MMM HH:mm" : "HH:mm")–@context.EndUtc.ToLocalTime().ToString("HH:mm")</MudTd>
            <MudTd>@Catalog.ServiceName(context.ServiceCode)</MudTd>
            <MudTd>@Catalog.ResourceName(context.ResourceCode)</MudTd>
            <MudTd>
                @context.OwnerName@(string.IsNullOrWhiteSpace(context.PetName) ? "" : $" · {context.PetName}")
                @if (!string.IsNullOrWhiteSpace(context.OwnerPhone))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.OwnerPhone</MudText>
                }
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@context.Status.ToText()</MudChip>
                @if (context.IsOverbooked)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@L["Overbooked"]</MudChip>
                }
                @if (context.Source == AppointmentSource.Online)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@L["Online"]</MudChip>
                }
            </MudTd>
            <MudTd Style="white-space: nowrap;">
                @if (context.PetId is int petId)
                {
                    <MudTooltip Text="@L["Clinical record"]">
                        <MudIconButton Icon="@Icons.Material.Filled.MedicalInformation" Size="Size.Small" Color="Color.Primary"
                                       Href="@($"clinical/pets/{petId}?appointment={context.Id}&reason={Uri.EscapeDataString(Catalog.ServiceName(context.ServiceCode))}")" />
                    </MudTooltip>
                }
                @if (CanCharge && context.Status is AppointmentStatus.Confirmed or AppointmentStatus.Completed)
                {
                    <MudTooltip Text="@L["Charge"]">
                        <MudIconButton Icon="@Icons.Material.Filled.PointOfSale" Size="Size.Small" Color="Color.Success" OnClick="() => OnCharge.InvokeAsync(context)" />
                    </MudTooltip>
                }
                @if (CanBook && context.Status is AppointmentStatus.Confirmed or AppointmentStatus.NeedsReschedule)
                {
                    <MudTooltip Text="@L["Reschedule"]">
                        <MudIconButton Icon="@Icons.Material.Filled.EditCalendar" Size="Size.Small" OnClick="() => OnReschedule.InvokeAsync(context)" />
                    </MudTooltip>
                }
                @if (CanBook && context.Status is AppointmentStatus.Confirmed or AppointmentStatus.NeedsReschedule or AppointmentStatus.PendingPayment)
                {
                    <MudTooltip Text="@L["Cancel"]">
                        <MudIconButton Icon="@Icons.Material.Filled.EventBusy" Size="Size.Small" Color="Color.Error" OnClick="() => OnCancel.InvokeAsync(context)" />
                    </MudTooltip>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter] public List<AppointmentDto> Items { get; set; } = [];
    [Parameter] public AgendaCatalog Catalog { get; set; } = default!;
    [Parameter] public bool CanBook { get; set; }
    [Parameter] public bool ShowDate { get; set; }
    [Parameter] public string EmptyText { get; set; } = Strings.T("No appointments.");
    [Parameter] public EventCallback<AppointmentDto> OnReschedule { get; set; }
    [Parameter] public EventCallback<AppointmentDto> OnCancel { get; set; }
    /// <summary>Shows the charge button (opens the appointment's sale).</summary>
    [Parameter] public bool CanCharge { get; set; }
    [Parameter] public EventCallback<AppointmentDto> OnCharge { get; set; }

    private static Color StatusColor(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Confirmed => Color.Success,
        AppointmentStatus.PendingPayment => Color.Info,
        AppointmentStatus.NeedsReschedule => Color.Warning,
        AppointmentStatus.Cancelled or AppointmentStatus.NoShow => Color.Error,
        _ => Color.Default
    };
}

@using VetManagement.Contracts.Inventory
@inherits ModalBase<object>
@inject InventoryMovementApiService InventoryService
@inject IDialogService DialogService

<ModalShell Title="@Title"
            TitleIcon="@TitleIcon"
            TitleColor="@TitleColor"
            IsLoading="@isLoading"
            IsValid="@isValid"
            PrimaryText="@L["Save"]"
            PrimaryLoadingText="@L["Saving..."]"
            PrimaryDisabled="@(AdjustAmount == 0 || (ChoosesWarehouse && _warehouseId is null))"
            OnPrimaryClick="OnSave"
            OnCancelClick="OnCancelRequested">
    <MudForm @ref="_form" @bind-IsValid="isValid">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Adjust stock of"] <b>@Item?.Name</b></MudText>
            @if (ChoosesWarehouse)
            {
                @* No default: a purchase must land in the warehouse it belongs to (e.g. the locked one), not the daily-use one. *@
                <MudSelect T="int?" Value="_warehouseId" ValueChanged="OnWarehouseChanged" Label="@L["Warehouse"]" Variant="Variant.Outlined" Required="true">
                    @foreach (var warehouse in Warehouses)
                    {
                        <MudSelectItem T="int?" Value="@warehouse.Id">@warehouse.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            @if (!ChoosesWarehouse || _warehouseId is not null)
            {
                <NumericStepper Value="@AdjustAmount" ValueChanged="OnAdjustAmountChanged" Min="@(-Current)" Max="100" Step="1" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Current stock: {0}", Current]</MudText>
            }
            <MudTextField Label="@L["Reason (optional)"]" @bind-Value="AdjustReason" Variant="Variant.Outlined" MaxLength="200"/>
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </MudForm>
</ModalShell>

@code {
    [Parameter] public InventoryItemDTO? Item { get; set; }

    /// <summary>The warehouses the user may move stock in (not archived); with more than one, the user picks.</summary>
    [Parameter] public List<WarehouseDto> Warehouses { get; set; } = [];

    private MudForm? _form;
    private int AdjustAmount { get; set; } = 0;
    private string AdjustReason { get; set; } = "";
    private int? _warehouseId;
    private string? _error;

    private bool ChoosesWarehouse => Warehouses.Count > 1;

    /// <summary>Units in the chosen warehouse (the user's only one otherwise).</summary>
    private int Current => !ChoosesWarehouse
        ? Item?.Stock ?? 0
        : Item?.Warehouses.FirstOrDefault(w => w.WarehouseId == _warehouseId)?.Quantity ?? 0;

    private void OnWarehouseChanged(int? value)
    {
        _warehouseId = value;
        AdjustAmount = Math.Max(AdjustAmount, -Current);
    }

    private async Task OnSave()
    {
        var itemId = Item?.Id;
        if (itemId is null || itemId == 0 || AdjustAmount == 0)
            return;
        isLoading = true;
        try
        {
            if (_form is not null)
            {
                await _form.ValidateAsync();
                if (!_form.IsValid)
                {
                    isLoading = false;
                    return;
                }
            }

            var result = await InventoryService.AdjustStockAsync(itemId.Value, AdjustAmount, AdjustReason,
                ChoosesWarehouse ? _warehouseId : Warehouses.FirstOrDefault()?.Id);
            if (!result.Ok)
            {
                _error = result.Error;
                return;
            }
            Snackbar.Add(L["Stock adjusted."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Error adjusting stock: {0}", ex.Message], Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task OnAdjustAmountChanged(int value)
    {
        AdjustAmount = value;
        return Task.CompletedTask;
    }

    private async Task OnCancelRequested()
    {
        if (AdjustAmount == 0 && string.IsNullOrWhiteSpace(AdjustReason))
        {
            OnCancel();
            return;
        }

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = false };
        var parameters = new DialogParameters<Components.Modals.Common.ConfirmModal>
        {
            { x => x.Title, L["Discard changes"].Value },
            { x => x.Message, L["There are unsaved changes. Do you want to exit without saving?"].Value },
            { x => x.ButtonConfirmText, L["Exit"].Value },
            { x => x.ButtonCancelText, L["Keep editing"].Value },
            { x => x.TitleIcon, Icons.Material.Filled.Warning },
            { x => x.TitleColor, Color.Warning }
        };
        var dialog = await DialogService.ShowAsync<Components.Modals.Common.ConfirmModal>(null, parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: true })
            return;
        OnCancel();
    }
}

@inherits ModalBase<object>
@inject InventoryMovementApiService InventoryService

<ModalShell Title="@Title"
            TitleIcon="@TitleIcon"
            TitleColor="@TitleColor"
            IsLoading="false"
            IsValid="true"
            FooterContent="@Footer">
    <MudStack Spacing="2">
        @if (IsLoading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText>@L["Loading history..."]</MudText>
        }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1" Class="mb-2">
                <MudText Typo="Typo.h6">@Item?.Name</MudText>
            </MudStack>
            <MudTable Items="Movements" Dense="true" Hover="true" Class="mt-2">
                <HeaderContent>
                    <MudTh>@L["Date"]</MudTh>
                    <MudTh>@L["Type"]</MudTh>
                    @if (ShowsWarehouse)
                    {
                        <MudTh>@L["Warehouse"]</MudTh>
                    }
                    <MudTh>@L["Quantity"]</MudTh>
                    <MudTh>@L["Reason"]</MudTh>
                    <MudTh>@L["Responsible"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Date"]">@context.Date.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="@L["Type"]">@context.Type.ToText()</MudTd>
                    @if (ShowsWarehouse)
                    {
                        <MudTd DataLabel="@L["Warehouse"]">@context.WarehouseName</MudTd>
                    }
                    <MudTd DataLabel="@L["Quantity"]">@context.Quantity</MudTd>
                    <MudTd DataLabel="@L["Reason"]">@context.Reason</MudTd>
                    <MudTd DataLabel="@L["Responsible"]">@context.Responsible</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudTd Class="text-center">@L["No movements recorded."]</MudTd>
                </NoRecordsContent>
            </MudTable>
        }
    </MudStack>
</ModalShell>

@code {
    [Parameter] public InventoryItemDTO? Item { get; set; }

    private List<InventoryMovement> Movements { get; set; } = new();
    private bool IsLoading { get; set; } = true;

    // Only the movements of warehouses the user sees come; one warehouse needs no column.
    private bool ShowsWarehouse => Movements.Select(m => m.WarehouseId).Distinct().Count() > 1;

    private RenderFragment Footer => __builder =>
    {
        <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="OnCancel">@L["Close"]</MudButton>;
    };

    protected override async Task OnInitializedAsync()
    {
        if (Item != null)
            Movements = await InventoryService.GetMovementsByItemIdAsync(Item.Id);
        IsLoading = false;
    }
}

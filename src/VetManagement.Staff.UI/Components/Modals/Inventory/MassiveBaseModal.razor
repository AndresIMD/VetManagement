@using VetManagement.Staff.UI.Components.Modals.Base
@using VetManagement.Staff.UI.Services.Api
@using VetManagement.Contracts.Inventory
@using VetManagement.Staff.UI.Helpers
@using VetManagement.Domain.Enums
@typeparam TItem
@inherits ModalBase<TItem>
@using System.Text.Json

<ModalShell Title="@Title"
            TitleIcon="@TitleIcon"
            TitleColor="@TitleColor"
            IsLoading="@isLoading"
            IsValid="true"
            PrimaryText="@ConfirmButtonText"
            PrimaryDisabled="@(items.Count == 0)"
            OnPrimaryClick="Confirm"
            OnCancelClick="OnCancelRequested">
    <MudStack Spacing="2">
        @if (ChoosesWarehouse)
        {
            @* Chosen first, and fixed once items are listed: their units are the chosen warehouse's. *@
            <MudGrid>
                <MudItem xs="12" md="@(IsTransfer ? 6 : 12)">
                    <MudSelect T="int?" @bind-Value="warehouseId" Label="@(IsTransfer ? L["From warehouse"] : L["Warehouse"])"
                               Variant="Variant.Outlined" Disabled="@(items.Count > 0)" Required="true"
                               HelperText="@(items.Count > 0 ? L["Remove the items to change it."].Value : null)">
                        @foreach (var warehouse in Warehouses)
                        {
                            <MudSelectItem T="int?" Value="@warehouse.Id">@warehouse.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @if (IsTransfer)
                {
                    <MudItem xs="12" md="6">
                        <MudSelect T="int?" @bind-Value="toWarehouseId" Label="@L["To warehouse"]" Variant="Variant.Outlined" Required="true">
                            @foreach (var warehouse in Warehouses.Where(w => w.Id != warehouseId))
                            {
                                <MudSelectItem T="int?" Value="@warehouse.Id">@warehouse.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
            </MudGrid>
        }
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @ref="barcodeInput"
                              Disabled="@WaitsForWarehouse"
                              Label="@BarcodeLabel"
                              @bind-Value="currentBarcode"
                              Immediate="true"
                              OnKeyDown="OnBarcodeKeyDown"
                              Variant="Variant.Outlined"
                              AutoFocus="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.QrCodeScanner" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextDropdownField T="Item"
                                      @ref="itemAutocomplete"
                                      Disabled="@WaitsForWarehouse"
                                      @bind-SelectedItem="selectedItem"
                                      Label="@L["Search item by name or compound"]"
                                      SearchFunc="SearchItemsNormalizedAsync"
                                      ToStringFunc="@(i => i is null ? string.Empty : i.Name)"
                                      LoadingText="@L["Searching items..."]"
                                      NoItemsText="@L["No items found"]"
                                      EmptyText="@L["Type at least 2 characters to search"]"
                                      MinCharacters="2">
                    <ItemTemplate>
                        @if (context is Drug d)
                        {
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2">@d.Name (@d.Brand)</MudText>
                                @if (!string.IsNullOrWhiteSpace(d.Compound))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Compound: {0}", d.Compound]</MudText>
                                }
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.caption" Color="Color.Tertiary">@L["Code: {0}", d.Barcode ?? ""]</MudText>
                                    <MudChip T="string" Color="@GetStockColor(d.Stock)" Variant="Variant.Outlined" Class="ml-2">@L["Stock: {0}", d.Stock]</MudChip>
                                </MudStack>
                            </MudStack>
                        }
                        else
                        {
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2">@context.Name (@context.Brand)</MudText>
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.caption" Color="Color.Tertiary">@L["Code: {0}", context.Barcode ?? ""]</MudText>
                                    <MudChip T="string" Color="@GetStockColor(context.Stock)" Variant="Variant.Outlined" Class="ml-2">@L["Stock: {0}", context.Stock]</MudChip>
                                </MudStack>
                            </MudStack>
                        }
                    </ItemTemplate>
                </MudTextDropdownField>
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@errorMessage</MudAlert>
        }

        <MudTable Items="items" Class="mt-2" Hover="true" Bordered="true" Striped="true" Dense="true">
            <HeaderContent>
                <MudTh>@L["Name"]</MudTh>
                <MudTh>@L["Stock"]</MudTh>
                <MudTh>@L["Quantity"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Name"]">@GetName(context)</MudTd>
                <MudTd DataLabel="@L["Stock"]">
                    @{
                        var stock = GetStock(context);
                    }
                    @if (stock.HasValue)
                    {
                        <MudChip T="string" Color="@GetStockColor(stock.Value)" Variant="Variant.Outlined">@stock</MudChip>
                    }
                    else
                    {
                        <MudText Color="Color.Tertiary">-</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="@L["Quantity"]">
                    @if (GetQuantity(context) <= 0)
                    {
                        <MudText Color="Color.Error">@L["Removed"]</MudText>
                    }
                    else
                    {
                        var stockVal = GetStock(context);
                        var tip = stockVal.HasValue ? L["Available stock: {0}", stockVal.Value].Value : L["Quantity"].Value;
                        <MudTooltip Text="@tip">
                            <NumericStepper Value="@GetQuantity(context)" ValueChanged="@(v => SetQuantity(context, v))" />
                        </MudTooltip>
                    }
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveItem(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudStack>
</ModalShell>

@code {
    [Inject] public ItemsApiService ItemsService { get; set; } = default!;
    [Inject] public IDialogService DialogService { get; set; } = default!;
    [Inject] public IJSRuntime JS { get; set; } = default!;

    protected MudTextField<string>? barcodeInput;
    protected MudTextDropdownField<Item>? itemAutocomplete;

    protected string currentBarcode = string.Empty;
    protected List<TItem> items = new();
    protected bool shouldFocusBarcode = true;
    protected string? errorMessage;

    private List<Item> _cachedItems = new();
    private bool _itemsLoaded;
    private Item? _selectedItem;
    private string _initialSnapshot = string.Empty;

    protected Item? selectedItem
    {
        get => _selectedItem;
        set
        {
            _selectedItem = value;
            if (value is not null)
            {
                AddEntity(value);
            }
        }
    }

    [Parameter] public string BarcodeLabel { get; set; } = Strings.T("Scan the barcode here");
    [Parameter] public string ConfirmButtonText { get; set; } = Strings.T("Confirm");

    /// <summary>The warehouses the user may move stock in (not archived). With more than one, the user picks one, never a default.</summary>
    [Parameter] public List<WarehouseDto> Warehouses { get; set; } = [];

    /// <summary>Units go from one warehouse to another: a destination is chosen too.</summary>
    protected virtual bool IsTransfer => false;

    protected bool ChoosesWarehouse => Warehouses.Count > 1;
    protected bool WaitsForWarehouse => ChoosesWarehouse && warehouseId is null;

    /// <summary>The warehouse the units come from, or go into; the only one when the user sees a single warehouse.</summary>
    protected int? warehouseId;
    protected int? toWarehouseId;

    /// <summary>Items added, by id, for their units per warehouse.</summary>
    protected readonly Dictionary<int, Item> knownItems = [];

    /// <summary>Units of an item in the chosen warehouse; null while it's unknown.</summary>
    protected int? UnitsInChosen(int itemId)
    {
        if (!knownItems.TryGetValue(itemId, out var item))
            return null;
        if (!ChoosesWarehouse)
            return item.Stock;
        return warehouseId is int id ? item.Warehouses.FirstOrDefault(w => w.WarehouseId == id)?.Quantity ?? 0 : null;
    }

    protected void Remember(Item? item)
    {
        if (item is not null)
            knownItems[item.Id] = item;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (!ChoosesWarehouse)
            warehouseId = Warehouses.FirstOrDefault()?.Id;
        _initialSnapshot = JsonSerializer.Serialize(items);
    }

    protected virtual async Task OnBarcodeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ProcessBarcodeAsync();
        }
    }

    private void AddEntity(object entity)
    {
        if (!CanAddItem(entity, out var reason))
        {
            errorMessage = reason;
            shouldFocusBarcode = true;
            StateHasChanged();
            return;
        }

        var newItem = CreateNewItem(entity);
        var id = GetItemId(newItem);
        TItem? existing = default;
        if (id > 0)
        {
            existing = items.FirstOrDefault(x => GetItemId(x) == id);
        }
        else
        {
            var newBarcode = GetBarcode(newItem);
            existing = items.FirstOrDefault(x => GetBarcode(x) == newBarcode);
        }
        if (existing is not null)
            SetQuantity(existing, GetQuantity(existing) + 1);
        else
            items.Add(newItem);

        _selectedItem = null;
        errorMessage = null;
        shouldFocusBarcode = true;
        StateHasChanged();
    }

    protected virtual bool CanAddItem(object entity, out string? reason)
    {
        reason = null;
        return true;
    }

    protected async Task ProcessBarcodeAsync()
    {
        if (!string.IsNullOrWhiteSpace(currentBarcode))
        {
            var entity = await GetItemByBarcode(currentBarcode);
            if (entity != null)
            {
                AddEntity(entity);
            }
            else
            {
                errorMessage = L["No item was found with the barcode '{0}'.", currentBarcode];

                shouldFocusBarcode = true;
                StateHasChanged();
            }
            currentBarcode = string.Empty;
        }
    }

    protected virtual async Task<IEnumerable<Item>> SearchItemsNormalizedAsync(string? value, CancellationToken cancellationToken)
    {
        if (!_itemsLoaded)
        {
            _cachedItems = await ItemsService.GetAllItemsAsync() ?? new List<Item>();
            _itemsLoaded = true;
        }

        if (string.IsNullOrWhiteSpace(value))
            return Array.Empty<Item>();

        return _cachedItems.Where(i =>
            (!string.IsNullOrWhiteSpace(i.Name) && StringExtensions.ContainsIgnoringAccents(i.Name, value)) ||
            (i is Drug d && !string.IsNullOrWhiteSpace(d.Compound) && StringExtensions.ContainsIgnoringAccents(d.Compound, value)) ||
            (!string.IsNullOrWhiteSpace(i.Barcode) && StringExtensions.ContainsIgnoringAccents(i.Barcode, value)) ||
            (!string.IsNullOrWhiteSpace(i.BrandBarcode) && StringExtensions.ContainsIgnoringAccents(i.BrandBarcode, value))
        ).OrderBy(i => i.Name).Take(20);
    }

    private Color GetStockColor(int stock) => stock <= 0 ? Color.Error : (stock < 10 ? Color.Warning : Color.Success);

    protected virtual Task<object?> GetItemByBarcode(string barcode) => Task.FromResult<object?>(null);
    protected virtual TItem CreateNewItem(object item) => default!;
    protected virtual string GetName(TItem item) => string.Empty;
    protected virtual string GetBarcode(TItem item) => string.Empty;
    protected virtual int GetQuantity(TItem item) => 1;
    protected virtual void SetQuantity(TItem item, int value) { }
    protected virtual int? GetStock(TItem item) => null;
    protected virtual int GetItemId(TItem item) => 0;
    protected void RemoveItem(TItem item) => items.Remove(item);

    protected async Task Confirm()
    {
        var filtered = items.Where(i => GetQuantity(i) > 0).ToList();
        if (filtered.Count == 0)
        {
            var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = false };
            await DialogService.ShowAsync<Components.Modals.Common.ConfirmModal>(
                L["No items"],
                new DialogParameters<Components.Modals.Common.ConfirmModal>
                {
                    { x => x.Title, L["No items"].Value },
                    { x => x.Message, L["There are no items with quantity greater than 0 to process."].Value },
                    { x => x.ButtonConfirmText, L["OK"].Value },
                    { x => x.ButtonCancelText, string.Empty }
                },
                options
            );
            return;
        }
        if (ChoosesWarehouse && (warehouseId is null || (IsTransfer && (toWarehouseId is null || toWarehouseId == warehouseId))))
        {
            errorMessage = IsTransfer ? L["Choose the two warehouses."] : L["Choose the warehouse."];
            return;
        }
        items = filtered;
        MudDialog.Close(DialogResult.Ok(new MassiveSelection<TItem>(items, warehouseId, toWarehouseId)));
    }

    protected async Task OnCancelRequested()
    {
        var current = JsonSerializer.Serialize(items);
        if (!string.Equals(current, _initialSnapshot, StringComparison.Ordinal))
        {
            var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = false };
            var parameters = new DialogParameters<Components.Modals.Common.ConfirmModal>
            {
                { x => x.Title, L["Discard changes"].Value },
                { x => x.Message, L["There are unsaved changes. Do you want to exit without saving?"].Value },
                { x => x.ButtonConfirmText, L["Exit"].Value },
                { x => x.ButtonCancelText, L["Keep editing"].Value },
                { x => x.TitleIcon, Icons.Material.Filled.Warning },
                { x => x.TitleColor, Color.Warning }
            };
            var dialog = await DialogService.ShowAsync<Components.Modals.Common.ConfirmModal>(null, parameters, options);
            var result = await dialog.Result;
            if (result is { Canceled: true })
                return;
        }
        OnCancel();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldFocusBarcode && barcodeInput is not null)
        {
            shouldFocusBarcode = false;
            await Task.Delay(50);
            await barcodeInput.FocusAsync();
        }
    }
    protected async Task BlurBarcodeInputAsync()
    {
        await JS.InvokeVoidAsync("eval", "document.activeElement && document.activeElement.blur()");
    }
}

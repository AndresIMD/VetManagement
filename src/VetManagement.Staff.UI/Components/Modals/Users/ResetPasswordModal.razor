@using VetManagement.Contracts.Accounts
@using VetManagement.Staff.UI.Helpers
@using VetManagement.Staff.UI.Services.Api
@inject ISnackbar Snackbar
@inject UserManagementApiService UserManagementService

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            @L["Give this temporary password to {0}: they will have to change it the next time they sign in.", User.UserName]
        </MudAlert>
        <MudForm @ref="form" @bind-IsValid="valid">
            <MudTextField @bind-Value="password" Label="@L["Temporary password"]" InputType="@InputType" Required="true"
                          HelperText="@PasswordRules.Hint" Validation="@(new Func<string, IEnumerable<string>>(PasswordRules.Check))"
                          Adornment="Adornment.End" AdornmentIcon="@VisibilityIcon" OnAdornmentClick="() => show = !show"
                          AdornmentAriaLabel="@L["Show/Hide password"]" Class="mb-2" />
            <MudTextField @bind-Value="repeat" Label="@L["Repeat password"]" InputType="@InputType" Required="true"
                          RequiredError="@L["Repeat the password."]" Validation="@(new Func<string, string?>(Matches))" Class="mb-2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Secondary" OnClick="() => MudDialog.Cancel()" Disabled="@saving">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="@(!valid || saving)">@L["Reset password"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public UserDto User { get; set; } = new();

    private MudForm? form;
    private string password = string.Empty;
    private string repeat = string.Empty;
    private bool valid;
    private bool saving;
    private bool show;

    private InputType InputType => show ? InputType.Text : InputType.Password;
    private string VisibilityIcon => show ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;

    private string? Matches(string value) => value == password ? null : L["Passwords do not match."];

    private async Task SaveAsync()
    {
        await form!.ValidateAsync();
        if (!form.IsValid)
            return;
        saving = true;
        var result = await UserManagementService.ResetPasswordAsync(User.Id, new ResetPasswordRequest { NewPassword = password });
        saving = false;
        if (result.Ok)
        {
            Snackbar.Add(L["Password of '{0}' reset.", User.UserName], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
            Snackbar.Add(L["Could not reset the password: {0}", result.Error ?? ""], Severity.Error);
    }
}

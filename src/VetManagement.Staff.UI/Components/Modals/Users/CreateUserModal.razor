@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using MudBlazor
@using VetManagement.Contracts.Accounts
@using VetManagement.Staff.UI.Services.Api
@inject ISnackbar Snackbar
@inject UserManagementApiService UserManagementService

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">@L["Create new user"]</MudText>
        <MudForm @ref="form" @bind-IsValid="success" @bind-Errors="errors">
            <MudTextField @bind-Value="model.UserName" Label="@L["Username"]" Required="true" RequiredError="@L["Username is required."]" Class="mb-2" />
            <MudTextField @bind-Value="model.Email" Label="@L["Email"]" Required="true" RequiredError="@L["Email is required."]" Validation="@(new Func<string, string>(ValidateEmail))" Class="mb-2" />
            <MudTextField @bind-Value="model.Password" Label="@L["Password"]"
                          InputType="@PasswordInput"
                          Required="true"
                          RequiredError="@L["Password is required"]"
                          HelperText="@L["Must be at least 8 characters, with uppercase, lowercase, and a number."]"
                          Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))"
                          Class="mb-2"
                          Adornment="Adornment.End"
                          AdornmentIcon="@PasswordInputIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          AdornmentAriaLabel="@L["Show/Hide password"]" />
            <MudTextField @bind-Value="repeatPassword" Label="@L["Repeat password"]"
                          InputType="@PasswordInput"
                          Required="true"
                          RequiredError="@L["Repeat the password."]"
                          HelperText="@L["Repeat the password."]"
                          Validation="@(new Func<string, string>(PasswordMatch))"
                          Class="mb-2"
                          Adornment="Adornment.End"
                          AdornmentIcon="@PasswordInputIcon"
                          OnAdornmentClick="TogglePasswordVisibility"
                          AdornmentAriaLabel="@L["Show/Hide password"]" />
            <MudSelect T="string"
                       SelectedValues="@model.Roles"
                       SelectedValuesChanged="@(v => OnRolesChanged(v))"
                       Label="@L["Roles"]" Required="true" MultiSelection="true" Class="mb-2">
                @foreach (var role in Roles)
                {
                    <MudSelectItem Value="@role">@L[role]</MudSelectItem>
                }
            </MudSelect>
        </MudForm>
        <MudText Typo="Typo.subtitle2" Class="mt-2" Style="color: #d32f2f;" >@errorSummary</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="CreateUserAsync" Disabled="@(!success || loading)">
            @if (loading)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                <span>@L["Creating..."]</span>
            }
            else
            {
                <span>@L["Create"]</span>
            }
        </MudButton>
        <MudButton Color="Color.Secondary" OnClick="Cancel" Disabled="@loading">@L["Cancel"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<string> Roles { get; set; } = new();
    
    private MudForm? form;
    private CreateUserRequest model = new();
    private string repeatPassword = string.Empty;
    private bool success;
    private string[] errors = { };
    private bool loading = false;
    private string errorSummary => errors != null && errors.Length > 0 ? string.Join("\n", errors) : string.Empty;

    private bool isShow = false;
    private InputType PasswordInput = InputType.Password;
    private string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        if (isShow)
        {
            isShow = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            isShow = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }

    private IEnumerable<string> PasswordStrength(string pw)
    {
        if (string.IsNullOrWhiteSpace(pw))
        {
            yield return L["Password is required"];
            yield break;
        }
        if (pw.Length < 8)
            yield return L["Password must be at least 8 characters long."];
        if (!Regex.IsMatch(pw, @"[A-Z]"))
            yield return L["Password must contain at least one uppercase letter."];
        if (!Regex.IsMatch(pw, @"[a-z]"))
            yield return L["Password must contain at least one lowercase letter."];
        if (!Regex.IsMatch(pw, @"[0-9]"))
            yield return L["Password must contain at least one number."];
    }

    private string PasswordMatch(string arg)
    {
        if (model.Password != arg)
            return L["Passwords do not match."];
        return string.Empty;
    }

    private string ValidateEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return L["Email is required."];
        
        var attr = new EmailAddressAttribute();
        if (!attr.IsValid(email))
            return L["Invalid email format."];
        
        return string.Empty;
    }

    private async Task CreateUserAsync()
    {
        if (form != null)
        {
            await form.ValidateAsync();
            if (!form.IsValid)
            {
                return;
            }
            loading = true;
        }
        StateHasChanged();

        (bool successResult, string? error) = await UserManagementService.CreateUserAsync(model);
        loading = false;

        if (successResult)
        {
            Snackbar.Add(L["User '{0}' created successfully.", model.UserName], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add(L["Error creating user: {0}", error ?? ""], Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void OnRolesChanged(IEnumerable<string> selected)
    {
        model.Roles = selected.ToList();
    }
}

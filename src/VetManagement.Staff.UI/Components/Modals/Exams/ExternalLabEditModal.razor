@using System.Text.Json
@using VetManagement.Staff.UI.Models.Exams
@inherits ModalBase<ExternalLab>
@inject ExternalLabsApiService LabsService
@inject IDialogService DialogService

<ModalShell Title="@Title"
            TitleIcon="@TitleIcon"
            TitleColor="@TitleColor"
            IsLoading="@isLoading"
            IsValid="true"
            PrimaryText="@L["Save"]"
            PrimaryLoadingText="@L["Saving..."]"
            OnPrimaryClick="SaveAsync"
            OnCancelClick="OnCancelRequested">
    @if (_dataLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-4">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Color="Color.Secondary" Class="mt-2">Loading data...</MudText>
        </MudStack>
    }
    else
    {
        <MudForm @ref="form" Model="_current">
            <MudGrid>
                <MudItem xs="12" sm="6"><MudTextField Label="@L["Name"]" @bind-Value="_current.Name" Required="true" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField Label="@L["Contact"]" @bind-Value="_current.ContactName" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField Label="@L["Phone"]" @bind-Value="_current.Phone" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField Label="@L["Email"]" @bind-Value="_current.Email" /></MudItem>
                <MudItem xs="12"><MudTextField Label="@L["Address"]" @bind-Value="_current.Address" /></MudItem>
                <MudItem xs="12"><MudTextField Label="@L["Notes"]" @bind-Value="_current.Notes" /></MudItem>
                <MudItem xs="12" sm="6"><MudNumericField T="int?" Label="@L["Default turnaround (days)"]" @bind-Value="_current.DefaultTurnaroundDays" /></MudItem>
            </MudGrid>
        </MudForm>
    }
</ModalShell>

@code {
    [Parameter] public ExternalLab? Initial { get; set; }

    private ExternalLab _current = new();
    private MudForm? form;
    private bool _dataLoading = true;
    private string _initialSnapshot = string.Empty;

    protected override Task OnInitializedAsync()
    {
        _current = Initial is null
            ? new ExternalLab()
            : new ExternalLab
            {
                Id = Initial.Id,
                Name = Initial.Name,
                ContactName = Initial.ContactName,
                Phone = Initial.Phone,
                Email = Initial.Email,
                Address = Initial.Address,
                Notes = Initial.Notes,
                DefaultTurnaroundDays = Initial.DefaultTurnaroundDays
            };
        _initialSnapshot = JsonSerializer.Serialize(_current);
        _dataLoading = false;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        try
        {
            isLoading = true;
            if (_current.Id == 0)
            {
                await LabsService.AddAsync(_current);
                Snackbar.Add(L["Laboratory created."], Severity.Success);
            }
            else
            {
                await LabsService.UpdateAsync(_current);
                Snackbar.Add(L["Laboratory updated."], Severity.Success);
            }
            MudDialog.Close(DialogResult.Ok(_current));
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Error saving the laboratory: {0}", ex.Message], Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnCancelRequested()
    {
        var current = JsonSerializer.Serialize(_current);
        if (!string.Equals(current, _initialSnapshot, StringComparison.Ordinal))
        {
            var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = false };
            var parameters = new DialogParameters<Components.Modals.Common.ConfirmModal>
            {
                { x => x.Title, L["Discard changes"].Value },
                { x => x.Message, L["There are unsaved changes. Do you want to exit without saving?"].Value },
                { x => x.ButtonConfirmText, L["Exit"].Value },
                { x => x.ButtonCancelText, L["Keep editing"].Value },
                { x => x.TitleIcon, Icons.Material.Filled.Warning },
                { x => x.TitleColor, Color.Warning }
            };
            var dialog = await DialogService.ShowAsync<Components.Modals.Common.ConfirmModal>(null, parameters, options);
            var result = await dialog.Result;
            if (result is { Canceled: true })
                return;
        }
        OnCancel();
    }
}

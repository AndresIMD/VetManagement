@inherits ModalBase<Exam>
@inject ExamApiService ExamService
@inject IDialogService DialogService
@using System.Text.Json
@using VetManagement.Contracts.Exams
@using VetManagement.Staff.UI.Models.Exams

<ModalShell Title="@Title"
            TitleIcon="@TitleIcon"
            TitleColor="@TitleColor"
            IsLoading="@isLoading"
            IsValid="true"
            PrimaryText="@L["Save"]"
            PrimaryLoadingText="@L["Saving..."]"
            OnPrimaryClick="HandleValidSubmit"
            OnCancelClick="OnCancelRequested">
    @if (_machinesLoaded && _machines.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
            @L["There are no lab machines yet."] <MudLink Href="lab-machines" Typo="Typo.body2">@L["Add them in Lab Machines."]</MudLink>
        </MudAlert>
    }
    <ExamForm @ref="_form"
              ExamModel="ExamModel"
              Brands="@BrandOptions()"
              Machines="@machinesList"
              OnBrandChangedCallback="OnBrandChanged"
              OnDirtyChanged="OnFormDirtyChanged" />
</ModalShell>

@code {
    [Parameter] public Exam? Initial { get; set; }

    private ExamForm? _form;
    private Exam ExamModel = new();
    private bool _isFormDirty;

    // The brands and models come from Lab Machines.
    private List<LabMachineDto> _machines = [];
    private bool _machinesLoaded;
    private List<string> machinesList = new();

    protected override async Task OnInitializedAsync()
    {
        if (Initial is not null)
        {
            ExamModel = new Exam
            {
                Id = Initial.Id,
                Name = Initial.Name,
                Brand = Initial.Brand,
                Machine = Initial.Machine,
                SampleType = Initial.SampleType,
                SampleContainer = Initial.SampleContainer,
                BuyPrice = Initial.BuyPrice,
                SellPrice = Initial.SellPrice,
                ItemId = Initial.ItemId,
                ItemName = Initial.ItemName,
                ItemQuantity = Initial.ItemQuantity,
                // Copies, so cancelling the form leaves the list as it was.
                SpeciesItems = [.. Initial.SpeciesItems.Select(s => new ExamSpeciesItemDto { Species = s.Species, ItemId = s.ItemId, ItemName = s.ItemName, Quantity = s.Quantity })]
            };
        }
        else
        {
            ExamModel = new Exam();
        }
        _machines = await ExamService.GetLabMachinesAsync();
        _machinesLoaded = true;
        // The list's spelling of the same brand and model, so the selects show them.
        ExamModel.Brand = BrandOptions().FirstOrDefault(b => Same(b, ExamModel.Brand)) ?? ExamModel.Brand;
        machinesList = ModelsFor(ExamModel.Brand);
        ExamModel.Machine = machinesList.FirstOrDefault(m => Same(m, ExamModel.Machine)) ?? ExamModel.Machine;
    }

    private List<string> BrandOptions()
    {
        var brands = _machines.Select(m => m.Brand).Distinct(StringComparer.OrdinalIgnoreCase).Order().ToList();
        if (!string.IsNullOrWhiteSpace(Initial?.Brand) && !brands.Any(b => Same(b, Initial.Brand)))
            brands.Add(Initial.Brand);
        return brands;
    }

    private List<string> ModelsFor(string? brand)
    {
        var models = _machines.Where(m => Same(m.Brand, brand)).Select(m => m.Model).Order().ToList();
        // An exam saved with a machine that isn't on the list keeps it as an option, so editing the exam doesn't drop it.
        if (Initial is not null && Same(Initial.Brand, brand) && !string.IsNullOrWhiteSpace(Initial.Machine) && !models.Any(m => Same(m, Initial.Machine)))
            models.Add(Initial.Machine);
        return models;
    }

    private static bool Same(string? a, string? b) => string.Equals(a?.Trim(), b?.Trim(), StringComparison.OrdinalIgnoreCase);

    private async Task HandleValidSubmit()
    {
        if (_form != null && !await _form.ValidateAsync())
            return;
        try
        {
            if (ExamModel.Id == 0)
            {
                await ExamService.AddExamAsync(ExamModel);
                Snackbar.Add(L["Exam created."], Severity.Success);
            }
            else
            {
                await ExamService.UpdateExamAsync(ExamModel);
                Snackbar.Add(L["Exam updated."], Severity.Success);
            }
            MudDialog.Close(DialogResult.Ok(ExamModel));
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Error saving exam: {0}", ex.Message], Severity.Error);
        }
    }

    private Task OnBrandChanged(string value)
    {
        ExamModel.Brand = value;
        machinesList = ModelsFor(value);
        if (!machinesList.Contains(ExamModel.Machine))
            ExamModel.Machine = machinesList.Count == 1 ? machinesList[0] : string.Empty;
        return Task.CompletedTask;
    }

    private async Task OnCancelRequested()
    {
        if (_isFormDirty)
        {
            var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = false };
            var parameters = new DialogParameters<Components.Modals.Common.ConfirmModal>
            {
                { x => x.Title, L["Discard changes"].Value },
                { x => x.Message, L["There are unsaved changes. Do you want to exit without saving?"].Value },
                { x => x.ButtonConfirmText, L["Exit"].Value },
                { x => x.ButtonCancelText, L["Keep editing"].Value },
                { x => x.TitleIcon, Icons.Material.Filled.Warning },
                { x => x.TitleColor, Color.Warning }
            };
            var dialog = await DialogService.ShowAsync<Components.Modals.Common.ConfirmModal>(null, parameters, options);
            var result = await dialog.Result;
            if (result is { Canceled: true })
                return;
        }
        OnCancel();
    }

    private Task OnFormDirtyChanged(bool dirty)
    {
        _isFormDirty = dirty;
        return Task.CompletedTask;
    }
}

@using VetManagement.Contracts.Scheduling
@inherits ModalBase<CreateAppointmentRequest>
@inject SchedulingApiService SchedulingApi

<ModalShell Title="@Title"
            TitleIcon="@Icons.Material.Filled.EventAvailable"
            TitleColor="@(Slot is null ? Color.Warning : Color.Primary)"
            IsLoading="@isLoading"
            IsValid="@CanSave"
            PrimaryText="Book"
            PrimaryLoadingText="Booking..."
            OnPrimaryClick="BookAsync"
            OnCancelClick="OnCancel">
    <MudGrid>
        <MudItem xs="12">
            <MudText Typo="Typo.subtitle2">@Catalog.ServiceName(ServiceCode)</MudText>
            @if (Slot is not null)
            {
                <MudText Typo="Typo.body2">
                    @Catalog.ResourceName(Slot.ResourceCode) · @Slot.StartUtc.ToLocalTime().ToString("dddd dd MMM yyyy, HH:mm")
                    @if (Slot.IsOverflow)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2">Overflow block</MudChip>
                    }
                </MudText>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">
                    Overbooking: books this time even if the resource is full or outside its hours.
                </MudAlert>
            }
        </MudItem>

        @if (Slot is null)
        {
            <MudItem xs="12" sm="4">
                <MudSelect T="string" Label="Vet / room" @bind-Value="_resourceCode" Required="true">
                    @foreach (var resource in ServiceResources)
                    {
                        <MudSelectItem Value="@resource">@Catalog.ResourceName(resource)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="4"><MudDatePicker Label="Date" @bind-Date="_date" Required="true" /></MudItem>
            <MudItem xs="6" sm="4"><MudTimePicker Label="Time" @bind-Time="_time" AmPm="false" Required="true" /></MudItem>
        }

        <MudItem xs="12" sm="6"><MudTextField Label="Owner name" @bind-Value="_ownerName" Required="true" Immediate="true" /></MudItem>
        <MudItem xs="12" sm="6"><MudTextField Label="Pet name" @bind-Value="_petName" /></MudItem>
        <MudItem xs="12" sm="4"><MudTextField Label="RUT" @bind-Value="_ownerTaxId" /></MudItem>
        <MudItem xs="12" sm="4"><MudTextField Label="Phone" @bind-Value="_ownerPhone" /></MudItem>
        <MudItem xs="12" sm="4"><MudTextField Label="Email" @bind-Value="_ownerEmail" /></MudItem>
        <MudItem xs="12"><MudTextField Label="Notes" @bind-Value="_notes" Lines="2" /></MudItem>
    </MudGrid>
</ModalShell>

@code {
    [Parameter] public AgendaCatalog Catalog { get; set; } = default!;
    [Parameter] public string ServiceCode { get; set; } = string.Empty;
    /// <summary>The free slot to book; null opens manual overbooking.</summary>
    [Parameter] public AvailableSlotDto? Slot { get; set; }

    private string? _resourceCode;
    private DateTime? _date = DateTime.Today;
    private TimeSpan? _time;
    private string _ownerName = string.Empty;
    private string? _petName, _ownerTaxId, _ownerPhone, _ownerEmail, _notes;

    private IReadOnlyList<string> ServiceResources =>
        Catalog.Services.FirstOrDefault(s => s.Code == ServiceCode)?.ResourceCodes ?? [];

    private bool CanSave => !string.IsNullOrWhiteSpace(_ownerName)
        && (Slot is not null || (_resourceCode is not null && _date is not null && _time is not null));

    protected override void OnInitialized()
    {
        Title = Slot is null ? "Overbook appointment" : "Book appointment";
        _resourceCode = ServiceResources.FirstOrDefault();
    }

    private async Task BookAsync()
    {
        isLoading = true;
        try
        {
            var startUtc = Slot?.StartUtc ?? (_date!.Value.Date + _time!.Value).ToUniversalTime();
            var result = await SchedulingApi.BookAsync(new CreateAppointmentRequest
            {
                ServiceCode = ServiceCode,
                ResourceCode = Slot?.ResourceCode ?? _resourceCode!,
                StartUtc = startUtc,
                Overbook = Slot is null,
                OwnerName = _ownerName,
                PetName = _petName,
                OwnerTaxId = _ownerTaxId,
                OwnerPhone = _ownerPhone,
                OwnerEmail = string.IsNullOrWhiteSpace(_ownerEmail) ? null : _ownerEmail,
                Notes = _notes
            });

            if (!result.Ok)
            {
                Snackbar.Add(result.Error!, Severity.Error);
                return;
            }
            Snackbar.Add("Appointment booked.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(result.Id));
        }
        finally
        {
            isLoading = false;
        }
    }
}

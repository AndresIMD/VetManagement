@using System.Text.Json
@using VetManagement.Domain.Enums
@using VetManagement.Staff.UI.Models.Exams
@using VetManagement.Staff.UI.Models.Medical
@using VetManagement.Staff.UI.Services.Api
@inherits ModalBase<MedicalVisit>
@inject MedicalVisitApiService VisitsService
@inject ExamApiService ExamService
@inject IDialogService DialogService

<ModalShell Title="@Title"
            TitleIcon="@TitleIcon"
            TitleColor="@TitleColor"
            IsLoading="@isLoading"
            IsValid="true"
            PrimaryText="@L["Save"]"
            PrimaryLoadingText="@L["Saving..."]"
            OnPrimaryClick="SaveAsync"
            OnCancelClick="OnCancelRequested">
    @if (_dataLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-4">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Color="Color.Secondary" Class="mt-2">@L["Loading data..."]</MudText>
        </MudStack>
    }
    else
    {
        <MudStack Spacing="2">
            <MudGrid Class="mb-2">
                <MudItem xs="12" sm="6"><MudDatePicker @bind-Date="CurrentDate" Label="@L["Date"]" /></MudItem>
                <MudItem xs="12" sm="6"><MudNumericField T="int" Label="@L["Pet ID"]" @bind-Value="Model.PatientId" Immediate="true" Required="true" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField Label="@L["Patient name"]" @bind-Value="Model.PatientName" Required="true" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField Label="@L["Record number"]" @bind-Value="Model.RecordNumber" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField Label="@L["Location"]" @bind-Value="Model.Location" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField Label="@L["Budget number"]" @bind-Value="Model.BudgetNumber" /></MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle1">@L["Clinical record"]</MudText>
            <MudGrid Class="mb-2">
                <MudItem xs="12"><MudTextField Label="@L["Reason for visit"]" @bind-Value="Model.Reason" MaxLength="500" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField Culture="CultureInfo.CurrentCulture" T="decimal?" Label="@L["Weight (kg)"]" @bind-Value="Model.WeightKg" Min="0" Step="0.1m" /></MudItem>
                <MudItem xs="6" sm="3"><MudNumericField Culture="CultureInfo.CurrentCulture" T="decimal?" Label="@L["Temperature (°C)"]" @bind-Value="Model.TemperatureC" Min="25" Max="45" Step="0.1m" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField Label="@L["Diagnosis"]" @bind-Value="Model.Diagnosis" MaxLength="2000" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField Label="@L["Anamnesis"]" @bind-Value="Model.Anamnesis" Lines="3" MaxLength="4000" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField Label="@L["Physical examination"]" @bind-Value="Model.Examination" Lines="3" MaxLength="4000" /></MudItem>
                <MudItem xs="12"><MudTextField Label="@L["Treatment / indications"]" @bind-Value="Model.Treatment" Lines="3" MaxLength="4000" /></MudItem>
            </MudGrid>

            <MudPaper Class="pa-3">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudSelect T="int" Label="@L["Add exam"]" ValueChanged="AddProcedureFromExam">
                        <MudSelectItem Value="0">@L["Select..."]</MudSelectItem>
                        @foreach (var ex in _catalog)
                        {
                            <MudSelectItem Value="@ex.Id">@ex.Name (@ex.Brand - @ex.Machine) - @Money.Clp(ex.SellPrice)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudText Color="Color.Secondary">@L["Procedures: {0}", Model.Procedures.Count]</MudText>
                    <MudText Color="Color.Secondary">@L["Total: {0} · charged from the clinical record (\"Charge visit\")", Money.Clp(Model.TotalValue)]</MudText>
                </MudStack>
            </MudPaper>

            <MudTable Items="@Model.Procedures" Dense="true" Hover="true" Bordered="true" Striped="true">
                <HeaderContent>
                    <MudTh>@L["Name"]</MudTh>
                    <MudTh>@L["Price"]</MudTh>
                    <MudTh>@L["Notes"]</MudTh>
                    <MudTh style="width:80px; text-align:right;">@L["Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate Context="p">
                    <MudTd DataLabel="@L["Name"]">@p.Name</MudTd>
                    <MudTd DataLabel="@L["Price"]"><MudNumericField T="int" @bind-Value="p.Price" @bind-Value:after="@RecalculateTotal" /></MudTd>
                    <MudTd DataLabel="@L["Notes"]"><MudTextField @bind-Value="p.Notes" /></MudTd>
                    <MudTd DataLabel="@L["Actions"]" Class="text-end">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveProcedure(p))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudStack>
    }
</ModalShell>

@code {
    [Parameter] public MedicalVisit Visit { get; set; } = new();

    private List<Exam> _catalog = new();
    private bool _dataLoading = true;
    private string _initialSnapshot = string.Empty;

    private DateTime? CurrentDate
    {
        get => Model.Date;
        set { Model.Date = value ?? Model.Date; }
    }

    protected override async Task OnInitializedAsync()
    {
        Model = new MedicalVisit
        {
            Id = Visit.Id,
            Date = Visit.Date,
            PatientId = Visit.PatientId,
            PatientName = Visit.PatientName,
            RecordNumber = Visit.RecordNumber,
            Responsible = Visit.Responsible,
            Location = Visit.Location,
            BudgetNumber = Visit.BudgetNumber,
            PaymentStatus = Visit.PaymentStatus,
            PaymentMethod = Visit.PaymentMethod,
            TotalValue = Visit.TotalValue,
            AppointmentId = Visit.AppointmentId,
            Reason = Visit.Reason,
            Anamnesis = Visit.Anamnesis,
            Examination = Visit.Examination,
            Diagnosis = Visit.Diagnosis,
            Treatment = Visit.Treatment,
            WeightKg = Visit.WeightKg,
            TemperatureC = Visit.TemperatureC,
            Procedures = Visit.Procedures?.Select(x => new VisitProcedure
            {
                Id = x.Id,
                ExamId = x.ExamId,
                Name = x.Name,
                Price = x.Price,
                Notes = x.Notes
            }).ToList() ?? new List<VisitProcedure>()
        };

        _catalog = await ExamService.GetAllExamsAsync() ?? new();
        RecalculateTotal();
        _initialSnapshot = System.Text.Json.JsonSerializer.Serialize(Model);
        _dataLoading = false;
    }

    private async Task SaveAsync()
    {
        isLoading = true;
        try
        {
            RecalculateTotal();
            if (Model.Id == 0)
                await VisitsService.AddAsync(Model);
            else
                await VisitsService.UpdateAsync(Model);

            Snackbar.Add(L["Visit saved."], Severity.Success);
            MudDialog.Close(DialogResult.Ok(Model));
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Error while saving: {0}", ex.Message], Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnCancelRequested()
    {
        var current = System.Text.Json.JsonSerializer.Serialize(Model);
        if (!string.Equals(current, _initialSnapshot, StringComparison.Ordinal))
        {
            var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = false };
            var parameters = new DialogParameters<Components.Modals.Common.ConfirmModal>
            {
                { x => x.Title, L["Discard changes"].Value },
                { x => x.Message, L["There are unsaved changes. Do you want to exit without saving?"].Value },
                { x => x.ButtonConfirmText, L["Exit"].Value },
                { x => x.ButtonCancelText, L["Keep editing"].Value },
                { x => x.TitleIcon, Icons.Material.Filled.Warning },
                { x => x.TitleColor, Color.Warning }
            };
            var dialog = await DialogService.ShowAsync<Components.Modals.Common.ConfirmModal>(null, parameters, options);
            var result = await dialog.Result;
            if (result is { Canceled: true })
                return;
        }
        OnCancel();
    }

    private async Task AddProcedureFromExam(int examId)
    {
        if (examId <= 0) return;
        var ex = _catalog.FirstOrDefault(e => e.Id == examId);
        if (ex is null) return;
        Model.Procedures.Add(new VisitProcedure
        {
            ExamId = ex.Id,
            Name = ex.Name,
            Price = ex.SellPrice
        });
        RecalculateTotal();
        await InvokeAsync(StateHasChanged);
    }

    private void RemoveProcedure(VisitProcedure p)
    {
        Model.Procedures.Remove(p);
        RecalculateTotal();
    }

    private void RecalculateTotal()
    {
        Model.TotalValue = Model.Procedures?.Sum(p => p.Price) ?? 0;
    }
}

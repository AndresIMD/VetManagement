<MudChip T="string" Size="Size.Small" Color="@Color" Variant="@(Status == PreventiveStatus.Superseded ? Variant.Outlined : Variant.Filled)">@Label</MudChip>

@code {
    [Parameter] public PreventiveStatus Status { get; set; }

    private Color Color => Status switch
    {
        PreventiveStatus.Overdue => Color.Error,
        PreventiveStatus.DueSoon => Color.Warning,
        PreventiveStatus.UpToDate => Color.Success,
        _ => Color.Default
    };

    private string Label => Status switch
    {
        PreventiveStatus.NoRepeat => L["Single dose"],
        PreventiveStatus.Superseded => L["Replaced"],
        _ => Status.ToText()
    };
}

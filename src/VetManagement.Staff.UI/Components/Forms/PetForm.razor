@using VetManagement.Staff.UI.Models.Core

<MudForm @ref="mudForm">
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudTextField Label="@L["Name"]" @bind-Value="PetModel.Name" For="@(() => PetModel.Name)" Required="true" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudNumericField T="int" Label="@L["Owner (ID)"]" @bind-Value="PetModel.OwnerId" ReadOnly="true" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="Sex" Label="@L["Sex"]" @bind-Value="PetModel.Sex" Required="true">
                @foreach (Sex sex in Enum.GetValues(typeof(Sex)))
                {
                    <MudSelectItem Value="@sex">@sex.ToText()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="Species" Label="@L["Species"]" @bind-Value="PetModel.Species" Required="true">
                @foreach (Species species in Enum.GetValues(typeof(Species)))
                {
                    <MudSelectItem Value="@species">@species.ToText()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="string" Label="@L["Breed"]" @bind-Value="PetModel.Breed" Disabled="@(!Breeds?.Any() ?? true)" Required="true">
                @if (Breeds?.Any() != true)
                {
                    <MudSelectItem Value="string.Empty">@L["Select a species first"]</MudSelectItem>
                }
                else
                {
                    @foreach (var breed in Breeds)
                    {
                        <MudSelectItem Value="@breed">@breed</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudDatePicker Label="@L["Birth date"]" Date="PetModel.Birthdate" DateChanged="@(d => PetModel.Birthdate = d ?? default)" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudNumericField T="int" Label="@L["Age"]" @bind-Value="PetModel.Age" For="@(() => PetModel.Age)" Required="true" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudNumericField Culture="CultureInfo.CurrentCulture" T="float" Label="@L["Weight (kg)"]" @bind-Value="PetModel.Weight" For="@(() => PetModel.Weight)" Required="true" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="ReproductiveStatus" Label="@L["Reproductive status"]" @bind-Value="PetModel.ReproductiveStatus" Required="true">
                @foreach (ReproductiveStatus state in Enum.GetValues(typeof(ReproductiveStatus)))
                {
                    <MudSelectItem Value="@state">@state.ToText()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudNumericField T="int" Label="@L["Chip ID"]" @bind-Value="PetModel.ChipId" />
        </MudItem>
        <MudItem xs="12">
            <MudStack Row="true" Spacing="2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">@L["Save"]</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="OnCancel">@L["Cancel"]</MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
    @if (mudForm != null && mudForm.Errors.Any())
    {
        <MudAlert Severity="Severity.Error" Class="pa-2 mb-2">
            <ul>
                @foreach (var error in mudForm.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </MudAlert>
    }
</MudForm>

@code {
    [Parameter] public Pet PetModel { get; set; } = new Pet { Name = string.Empty, Breed = string.Empty };
    [Parameter] public List<string> Breeds { get; set; } = new();
    [Parameter] public EventCallback<List<string>> BreedsChanged { get; set; }
    [Parameter] public EventCallback OnValidSubmitCallback { get; set; }
    [Parameter] public EventCallback OnCancelCallback { get; set; }

    private MudForm? mudForm;
    private EditContext? editContext;
    private async Task HandleValidSubmit() => await OnValidSubmitCallback.InvokeAsync();
    private async Task OnCancel() => await OnCancelCallback.InvokeAsync();

    private void OnBirthdateChanged(DateTime date)
    {
        PetModel.Birthdate = date;
    }

    protected override void OnInitialized()
    {
        editContext = new EditContext(PetModel);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (PetModel.Species != default && (Breeds == null || !Breeds.SequenceEqual(Pet.GetBreedsBySpecies(PetModel.Species))))
        {
            var newBreeds = Pet.GetBreedsBySpecies(PetModel.Species);
            await BreedsChanged.InvokeAsync(newBreeds);
        }
    }

    protected override void OnParametersSet()
    {
        StateHasChanged();
    }
}

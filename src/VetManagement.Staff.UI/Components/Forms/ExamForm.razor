@using VetManagement.Domain.Enums
@using VetManagement.Staff.UI.Models.Exams
@using VetManagement.Staff.UI.Models.Medical

<MudForm @ref="_mudForm" Model="ExamModel" @bind-IsValid="IsValid" FieldChanged="OnFormFieldChanged">
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudTextField Label="@L["Name"]" @bind-Value="ExamModel.Name" For="@(() => ExamModel.Name)" Required="true" RequiredError="@L["This field is required."]" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="string" Label="@L["Brand"]" Value="ExamModel.Brand" ValueChanged="OnBrandChangedMud" Required="true" RequiredError="@L["This field is required."]">
                @foreach (var brand in Brands)
                {
                    <MudSelectItem Value="@brand">@brand</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="string" Label="@L["Machine"]" @bind-Value="ExamModel.Machine" Required="true" RequiredError="@L["This field is required."]">
                @foreach (var machine in Machines)
                {
                    <MudSelectItem Value="@machine">@machine</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="SampleType" Label="@L["Sample type"]" @bind-Value="ExamModel.SampleType" Required="true" RequiredError="@L["This field is required."]"
                       ToStringFunc="@(v => v == SampleType.None ? string.Empty : v.ToText())" Validation="@(new Func<SampleType, string?>(v => v == SampleType.None ? L["This field is required."] : null))">
                @foreach (var value in Enum.GetValues<SampleType>())
                {
                    if (value == SampleType.None) { continue; }
                    <MudSelectItem Value="@value">@value.ToText()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="SampleContainer" Label="@L["Container"]" @bind-Value="ExamModel.SampleContainer" Required="true" RequiredError="@L["This field is required."]"
                       ToStringFunc="@(v => v == SampleContainer.None ? string.Empty : v.ToText())" Validation="@(new Func<SampleContainer, string?>(v => v == SampleContainer.None ? L["This field is required."] : null))">
                @foreach (var value in Enum.GetValues<SampleContainer>())
                {
                    if (value == SampleContainer.None) { continue; }
                    <MudSelectItem Value="@value">@value.ToText()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudNumericField T="int" Label="@L["Cost (buy)"]" @bind-Value="ExamModel.BuyPrice" For="@(() => ExamModel.BuyPrice)" Step="1000" Required="true" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudNumericField T="int" Label="@L["Price (sell)"]" @bind-Value="ExamModel.SellPrice" For="@(() => ExamModel.SellPrice)" Step="1000" Required="true" />
        </MudItem>
    </MudGrid>
    @if (_mudForm != null && _mudForm.Errors?.Any() == true)
    {
        <MudAlert Severity="Severity.Error" Class="pa-2 mb-2">
            <ul>
                @foreach (var error in _mudForm.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </MudAlert>
    }
</MudForm>

@code {
    [Parameter] public Exam ExamModel { get; set; } = new Exam();
    [Parameter] public List<string> Brands { get; set; } = new();
    [Parameter] public List<string> Machines { get; set; } = new();
    [Parameter] public EventCallback<string> OnBrandChangedCallback { get; set; }
    [Parameter] public EventCallback<bool> OnDirtyChanged { get; set; }

    private MudForm? _mudForm;
    public bool IsValid { get; set; }

    private bool _isDirty;
    public bool IsDirty
    {
        get => _isDirty;
        set
        {
            if (_isDirty == value) return;
            _isDirty = value;
            OnDirtyChanged.InvokeAsync(_isDirty);
        }
    }

    /// <summary>Validates the fields; the modal holding the form saves (its footer has the Save and Cancel buttons).</summary>
    public async Task<bool> ValidateAsync()
    {
        if (_mudForm is null)
            return true;
        await _mudForm.ValidateAsync();
        return _mudForm.IsValid;
    }

    private async Task OnBrandChangedMud(string value)
    {
        ExamModel.Brand = value;
        await OnBrandChangedCallback.InvokeAsync(value);
        IsDirty = true;
    }

    private Task OnFormFieldChanged(object _)
    {
        IsDirty = true;
        return Task.CompletedTask;
    }
}

<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Public booking portal: one deployment per clinic, branded from the clinic's agenda settings. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VetManagement.Booking.Web</RootNamespace>
    <AssemblyName>VetManagement.Booking.Web</AssemblyName>
    <!-- Spanish dates for clients (es-CL); time zones to show the clinic's local time. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Required to switch to es-CL at startup (Program.cs). -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VetManagement.Contracts\VetManagement.Contracts.csproj" />
  </ItemGroup>

</Project>

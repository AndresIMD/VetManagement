@using System.Security.Claims
@using VetManagement.Shared.Services.Api
@inject AccountApiService AccountService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ThemeService ThemeService

<AuthorizeView>
    <Authorized>
        <MudAppBar Elevation="4" Class="mud-appbar-fixed appbar-elevated">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width:100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="ml-2">
                    <MudHidden Breakpoint="Breakpoint.MdAndUp">
                        <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Color="Color.Inherit" Dense="true">
                            <ActivatorContent Context="menuContext">
                                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" />
                            </ActivatorContent>
                            <ChildContent>
                                @foreach (var item in MenuItems)
                                {
                                    if (item.Visible(UserPerm))
                                    {
                                        if (item.Children != null && item.Children.Any(c => c.Visible(UserPerm)))
                                        {
                                            <MudMenuItem Disabled="true">@item.Title</MudMenuItem>
                                            @foreach (var child in item.Children)
                                            {
                                                if (child.Visible(UserPerm))
                                                {
                                                    <MudMenuItem Href="@child.Href" Class="pl-4">@child.Title</MudMenuItem>
                                                }
                                            }
                                            <MudDivider />
                                        }
                                        else if (!string.IsNullOrEmpty(item.Href))
                                        {
                                            <MudMenuItem Href="@item.Href">@item.Title</MudMenuItem>
                                        }
                                    }
                                }
                            </ChildContent>
                        </MudMenu>
                    </MudHidden>
                    <MudNavLink Href="/" Style="display:inline-block;">
                        <img src="_content/VetManagement.Shared/images/logo_negativo_vet_clinic.png" style="height:32px; margin-right:10px;" />
                    </MudNavLink>
                </MudStack>

                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                        @foreach (var item in MenuItems)
                        {
                            if (item.Visible(UserPerm))
                            {
                                if (item.Children != null && item.Children.Any(c => c.Visible(UserPerm)))
                                {
                                    <NavDropdown Title="@item.Title" Icon="@item.Icon" Items="@item.Children!.Where(c => c.Visible(UserPerm)).Select(c => (c.Title, c.Href))" />
                                }
                                else if (!string.IsNullOrEmpty(item.Href))
                                {
                                    <MudNavLink Href="@item.Href" Icon="@item.Icon" Class="mx-2 mud-nav-link nav-item">@item.Title</MudNavLink>
                                }
                            }
                        }
                    </MudStack>
                </MudHidden>

                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="2" Class="ml-2">
                    <RealtimeConnectionIndicator />
                    <MudTooltip Text="Toggle light/dark theme">
                        <MudIconButton Icon="@(_isDark? Icons.Material.Filled.DarkMode : Icons.Material.Filled.WbSunny)" Color="Color.Inherit" OnClick="@(() => OnToggleDarkMode.InvokeAsync())" />
                    </MudTooltip>
                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.BottomRight" Color="Color.Inherit" Dense="true">
                        <ChildContent>
                            <MudMenuItem Disabled="true">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.body2">@user?.Identity?.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@PrimaryRole</MudText>
                                </MudStack>
                            </MudMenuItem>
                            <MudDivider />
                            <MudMenuItem OnClick="@LogoutAsync">Logout</MudMenuItem>
                        </ChildContent>
                        <ActivatorContent Context="userMenuContext">
                            <MudAvatar Color="Color.Tertiary" Style="cursor:pointer;">
                                @UserInitial
                            </MudAvatar>
                        </ActivatorContent>
                    </MudMenu>
                </MudStack>
            </MudStack>
        </MudAppBar>
    </Authorized>
    <NotAuthorized>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public EventCallback OnToggleDarkMode { get; set; }

    private ClaimsPrincipal? user;
    private string UserInitial => user?.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "?";
    private bool _isDark;

    public class MenuItem
    {
        public string Title { get; set; } = string.Empty;
        public string? Href { get; set; }
        public string? Icon { get; set; }
        public string[] RequiredPerms { get; set; } = Array.Empty<string>();
        public List<MenuItem>? Children { get; set; }
        public bool Visible(Func<string, bool> has) => RequiredPerms.Length == 0 || RequiredPerms.Any(has);
    }

    private static bool HasPerm(ClaimsPrincipal? u, string perm) => u?.HasClaim("perm", perm) == true;
    private Func<string, bool> UserPerm => (p) => HasPerm(user, p);

    private List<MenuItem> MenuItems = new()
    {
        new MenuItem
        {
            Title = "Inventory",
            Icon = Icons.Material.Filled.Inventory,
            RequiredPerms = new[] { "inventory.read" },
            Children = new List<MenuItem>
            {
                new MenuItem { Title = "Dashboard", Href = "inventory", RequiredPerms = new[] { "inventory.read" } },
                new MenuItem { Title = "Items", Href = "inventory-items", RequiredPerms = new[] { "inventory.read" } },
                new MenuItem { Title = "Audit", Href = "inventory-audit", RequiredPerms = new[] { "audit.read" } },
                new MenuItem { Title = "Metrics", Href = "inventory-metrics", RequiredPerms = new[] { "inventory.read" } },
                new MenuItem { Title = "Email Alerts", Href = "inventory-alerts", RequiredPerms = new[] { "inventory.update" } }
            }
        },
        new MenuItem
        {
            Title = "Exams",
            Icon = Icons.Material.Filled.Assignment,
            RequiredPerms = new[] { "exams.read", "examsperformed.read", "externallabs.read" },
            Children = new List<MenuItem>
            {
                new MenuItem { Title = "Exam Catalog", Href = "exams", RequiredPerms = new[] { "exams.read" } },
                new MenuItem { Title = "Requests", Href = "exam-requests", RequiredPerms = new[] { "examsperformed.read" } },
                new MenuItem { Title = "External Labs", Href = "external-labs", RequiredPerms = new[] { "externallabs.read" } },
                new MenuItem { Title = "Medical Visits", Href = "medical-visits", RequiredPerms = new[] { "medical.read" } }
            }
        },
        new MenuItem
        {
            Title = "Clients",
            Icon = Icons.Material.Filled.Assignment,
            RequiredPerms = new[] { "clientspets.read" },
            Children = new List<MenuItem>
            {
                new MenuItem { Title = "Search", Href = "client-search", Icon = Icons.Material.Filled.Search, RequiredPerms = new[] { "clientspets.read" } }
            }
        },
        new MenuItem
        {
            Title = "Administration",
            Icon = Icons.Material.Filled.AdminPanelSettings,
            RequiredPerms = new[] { "users.read", "audit.read" },
            Children = new List<MenuItem>
            {
                new MenuItem { Title = "Users", Href = "admin/users", Icon = Icons.Material.Filled.People, RequiredPerms = new[] { "users.read" } }
            }
        }
    };

    private AuthenticationStateChangedHandler? _authStateChangedHandler;

    protected override async Task OnInitializedAsync()
    {
        _authStateChangedHandler = (task) => { _ = OnAuthStateChanged(task); };
        AuthStateProvider.AuthenticationStateChanged += _authStateChangedHandler;
        var initialState = await AuthStateProvider.GetAuthenticationStateAsync();
        user = initialState.User;
        ThemeService.OnChange += OnThemeChanged;
        _isDark = ThemeService.IsDarkMode;
    }

    private void OnThemeChanged() { _isDark = ThemeService.IsDarkMode; InvokeAsync(StateHasChanged); }

    private async Task OnAuthStateChanged(Task<AuthenticationState> task)
    { var authState = await task; user = authState.User; StateHasChanged(); }

    public void Dispose()
    {
        if (_authStateChangedHandler != null)
            AuthStateProvider.AuthenticationStateChanged -= _authStateChangedHandler;
        ThemeService.OnChange -= OnThemeChanged;
    }

    private string PrimaryRole => user?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "User";

    private async Task LogoutAsync()
    {
        await AccountService.LogoutAsync();
        if (AuthStateProvider is JwtAuthenticationStateProvider jwtProvider)
            jwtProvider.NotifyUserLogout();
        Navigation.NavigateTo("/login", true);
    }
}

@inherits ModalBase<object>
@inject InventoryMovementApiService InventoryService
@inject IDialogService DialogService

<ModalShell Title="@Title"
            TitleIcon="@TitleIcon"
            TitleColor="@TitleColor"
            IsLoading="@isLoading"
            IsValid="@isValid"
            PrimaryText="Save"
            PrimaryLoadingText="Saving..."
            PrimaryDisabled="@(AdjustAmount == 0)"
            OnPrimaryClick="OnSave"
            OnCancelClick="OnCancelRequested">
    <MudForm @ref="_form" @bind-IsValid="isValid">
        <MudStack Spacing="2">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Adjust stock of <b>@Item?.Name</b></MudText>
            <NumericStepper Value="@AdjustAmount" ValueChanged="OnAdjustAmountChanged" Min="@(-(Item?.Stock ?? 0))" Max="100" Step="1" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">Current stock: @Item?.Stock</MudText>
            <MudTextField Label="Reason" @bind-Value="AdjustReason" Variant="Variant.Outlined"/>
        </MudStack>
    </MudForm>
</ModalShell>

@code {
    [Parameter] public InventoryItemDTO? Item { get; set; }

    private MudForm? _form;
    private int AdjustAmount { get; set; } = 0;
    private string AdjustReason { get; set; } = "";

    private async Task OnSave()
    {
        var itemId = Item?.Id;
        if (itemId is null || itemId == 0 || AdjustAmount == 0)
            return;
        isLoading = true;
        try
        {
            if (_form is not null)
            {
                await _form.ValidateAsync();
                if (!_form.IsValid)
                {
                    isLoading = false;
                    return;
                }
            }

            await InventoryService.AdjustStockAsync(itemId.Value, AdjustAmount, AdjustReason);
            Snackbar.Add("Stock adjusted.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adjusting stock: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task OnAdjustAmountChanged(int value)
    {
        AdjustAmount = value;
        return Task.CompletedTask;
    }

    private async Task OnCancelRequested()
    {
        if (AdjustAmount == 0 && string.IsNullOrWhiteSpace(AdjustReason))
        {
            OnCancel();
            return;
        }

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = false };
        var parameters = new DialogParameters<Components.Modals.Common.ConfirmModal>
        {
            { x => x.Title, "Discard changes" },
            { x => x.Message, "There are unsaved changes. Do you want to exit without saving?" },
            { x => x.ButtonConfirmText, "Exit" },
            { x => x.ButtonCancelText, "Continue editing" },
            { x => x.TitleIcon, Icons.Material.Filled.Warning },
            { x => x.TitleColor, Color.Warning }
        };
        var dialog = await DialogService.ShowAsync<Components.Modals.Common.ConfirmModal>(null, parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: true })
            return;
        OnCancel();
    }
}

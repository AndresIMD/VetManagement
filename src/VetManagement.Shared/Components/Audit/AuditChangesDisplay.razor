@using System.Text.Json
@using System.Text.RegularExpressions
@using MudBlazor

@if (_parsedChanges != null && _parsedChanges.Any())
{
    <MudStack Spacing="1">
        @foreach (var change in _parsedChanges)
        {
            <div class="audit-change-item">
                <div class="audit-field-name">@change.FieldName</div>
                <div class="audit-change-values">
                    @if (!string.IsNullOrEmpty(change.OldValue))
                    {
                        <span class="audit-old-value">@change.OldValue</span>
                        <span class="audit-arrow">→</span>
                    }
                    <span class="audit-new-value">@change.NewValue</span>
                </div>
            </div>
        }
    </MudStack>
}
else
{
    <MudText Typo="Typo.body2" Color="Color.Default">@RawChanges</MudText>
}

@code {
    [Parameter] public string? RawChanges { get; set; }

    private List<ChangeItem>? _parsedChanges;

    protected override void OnParametersSet()
    {
        _parsedChanges = ParseChanges(RawChanges);
    }

    private List<ChangeItem>? ParseChanges(string? changes)
    {
        if (string.IsNullOrWhiteSpace(changes))
            return null;

        try
        {
            var result = new List<ChangeItem>();

            if (changes.StartsWith("{") && changes.EndsWith("}"))
            {
                using var doc = JsonDocument.Parse(changes);
                var root = doc.RootElement;

                foreach (var prop in root.EnumerateObject())
                {
                    var fieldName = FormatFieldName(prop.Name);

                    if (prop.Value.ValueKind == JsonValueKind.Object)
                    {
                        var oldValue = prop.Value.TryGetProperty("old", out var oldProp) ? oldProp.ToString() : null;
                        var newValue = prop.Value.TryGetProperty("new", out var newProp) ? newProp.ToString() : null;

                        result.Add(new ChangeItem
                        {
                            FieldName = fieldName,
                            OldValue = oldValue,
                            NewValue = newValue ?? string.Empty
                        });
                    }
                    else
                    {
                        result.Add(new ChangeItem
                        {
                            FieldName = fieldName,
                            OldValue = null,
                            NewValue = prop.Value.ToString()
                        });
                    }
                }
            }
            else
            {
                var regex = new Regex(@"(\w+):\s*(.+?)(?:,\s*|$)", RegexOptions.Compiled);
                var matches = regex.Matches(changes);

                foreach (Match match in matches)
                {
                    if (match.Groups.Count >= 3)
                    {
                        result.Add(new ChangeItem
                        {
                            FieldName = FormatFieldName(match.Groups[1].Value),
                            OldValue = null,
                            NewValue = match.Groups[2].Value.Trim()
                        });
                    }
                }
            }

            return result.Any() ? result : null;
        }
        catch
        {
            return null;
        }
    }

    private string FormatFieldName(string fieldName)
    {
        return Regex.Replace(fieldName, "([a-z])([A-Z])", "$1 $2");
    }

    private class ChangeItem
    {
        public string FieldName { get; set; } = string.Empty;
        public string? OldValue { get; set; }
        public string NewValue { get; set; } = string.Empty;
    }
}
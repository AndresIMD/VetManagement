@using VetManagement.Shared.Helpers
@typeparam TEnum where TEnum : struct, Enum

<MudSelect T="TEnum" MultiSelection="true" SelectedValues="@(_selectedValues?.ToList() ?? [])"
    SelectedValuesChanged="HandleSelectionChanged" Label="@Label" Variant="@Variant" Clearable="@Clearable"
    Dense="@Dense" Disabled="@Disabled" FullWidth="@FullWidth" Class="@Class" Style="@Style" Adornment="@Adornment"
    AdornmentIcon="@AdornmentIcon" AdornmentColor="@AdornmentColor" MultiSelectionTextFunc="@GetMultiSelectionText"
    @attributes="@AdditionalAttributes">
    @foreach (var value in _availableValues)
    {
        <MudSelectItem T="TEnum" Value="@value">
            @value.GetDisplayString()
        </MudSelectItem>
    }
</MudSelect>

@code {
    [Parameter] public List<TEnum>? SelectedItems { get; set; }
    [Parameter] public EventCallback<List<TEnum>> SelectedItemsChanged { get; set; }
    [Parameter] public List<TEnum>? AllowedValues { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool Dense { get; set; } = false;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool FullWidth { get; set; } = true;
    [Parameter] public bool ExcludeNone { get; set; } = true;
    [Parameter] public Adornment Adornment { get; set; } = Adornment.Start;
    [Parameter] public string? AdornmentIcon { get; set; }
    [Parameter] public Color AdornmentColor { get; set; } = Color.Default;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private IEnumerable<TEnum> _selectedValues = [];
    private List<TEnum> _availableValues = [];

    protected override void OnInitialized()
    {
        SelectedItems ??= [];
        BuildAvailableValues();
        UpdateSelectedValues();
    }

    protected override void OnParametersSet()
    {
        BuildAvailableValues();
        UpdateSelectedValues();
    }

    private void BuildAvailableValues()
    {
        var allValues = Enum.GetValues<TEnum>();

        if (AllowedValues != null && AllowedValues.Any())
        {
            _availableValues = AllowedValues.ToList();
        }
        else
        {
            _availableValues = allValues.Where(v => !ExcludeNone || !IsNoneValue(v)).ToList();
        }
    }

    private void UpdateSelectedValues()
    {
        if (SelectedItems != null)
        {
            _selectedValues = SelectedItems.Where(s => _availableValues.Contains(s)).ToList();
        }
    }

    private async Task HandleSelectionChanged(IEnumerable<TEnum> values)
    {
        var filteredValues = values.Where(v => _availableValues.Contains(v)).ToList();
        SelectedItems = filteredValues;
        _selectedValues = filteredValues;
        await SelectedItemsChanged.InvokeAsync(filteredValues);
    }

    private string GetMultiSelectionText(IReadOnlyList<string> selectedTexts)
    {
        if (selectedTexts.Count == 0)
            return "All";

        if (selectedTexts.Count == 1)
            return selectedTexts[0];

        if (selectedTexts.Count == _availableValues.Count)
            return "All";

        return $"{selectedTexts.Count} selected";
    }

    private bool IsNoneValue(TEnum value)
    {
        var name = Enum.GetName(value);
        return name?.Equals("None", StringComparison.OrdinalIgnoreCase) == true ||
        Convert.ToInt32(value) == 0;
    }
}

@page "/external-labs"
@using VetManagement.Shared.Models.Exams
@inject ExternalLabsApiService LabsService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize(Policy = "ExternalLabs.Read")]

<PageTitle>External Labs</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto px-2 mt-8">
    <PageHeader Title="External Labs" Icon="@Icons.Material.Filled.Biotech" />

    <MudStack Row="true" Spacing="2" Class="mb-3" Justify="Justify.FlexEnd">
        <MudButton Color="Color.Success" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.AddBox" OnClick="ShowAddModal">New lab</MudButton>
    </MudStack>

    <MudTable Items="_labs" Dense="true" Hover="true" Bordered="true" Striped="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Contact</MudTh>
            <MudTh>Phone</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Default ETA</MudTh>
            <MudTh style="width:140px; text-align:right;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate Context="lab">
            <MudTd>@lab.Name</MudTd>
            <MudTd>@lab.ContactName</MudTd>
            <MudTd>@lab.Phone</MudTd>
            <MudTd>@lab.Email</MudTd>
            <MudTd>@lab.DefaultTurnaroundDays</MudTd>
            <MudTd Class="text-end">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => ShowEditModal(lab))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => ShowDeleteModal(lab))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@code {
    private List<ExternalLab> _labs = new();
    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _labs = await LabsService.GetAllAsync() ?? new();
    }

    private async Task ShowAddModal()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var parameters = new DialogParameters<Components.Modals.Exams.ExternalLabEditModal>
        {
            { x => x.Title, "New lab" },
            { x => x.TitleIcon, Icons.Material.Filled.Biotech },
            { x => x.TitleColor, Color.Success }
        };
        var dialog = await DialogService.ShowAsync<Components.Modals.Exams.ExternalLabEditModal>(null, parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task ShowEditModal(ExternalLab entity)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var parameters = new DialogParameters<Components.Modals.Exams.ExternalLabEditModal>
        {
            { x => x.Initial, entity },
            { x => x.Title, "Edit lab" },
            { x => x.TitleIcon, Icons.Material.Filled.Edit },
            { x => x.TitleColor, Color.Primary }
        };
        var dialog = await DialogService.ShowAsync<Components.Modals.Exams.ExternalLabEditModal>(null, parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await LoadAsync();
    }

    private async Task ShowDeleteModal(ExternalLab entity)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = false };
        var parameters = new DialogParameters<Components.Modals.Common.ConfirmModal>
        {
            { x => x.Title, "Delete lab" },
            { x => x.Message, $"Delete '{entity.Name}'?" },
            { x => x.ButtonConfirmText, "Delete" },
            { x => x.ButtonCancelText, "Cancel" },
            { x => x.TitleIcon, Icons.Material.Filled.Delete },
            { x => x.TitleColor, Color.Error }
        };
        var dialog = await DialogService.ShowAsync<Components.Modals.Common.ConfirmModal>(null, parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LabsService.DeleteAsync(entity.Id);
            Snackbar.Add("Lab deleted.", Severity.Success);
            await LoadAsync();
        }
    }
}

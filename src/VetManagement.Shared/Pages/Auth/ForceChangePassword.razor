@page "/force-change-password"
@inject AccountApiService AccountApi
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Change Password</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center justify-center" Style="min-height:80vh;">
    <MudPaper Elevation="6" Class="pa-6" Style="width:100%; max-width:480px;">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">Change your password</MudText>
        <MudForm @ref="_form">
            <MudTextField T="string" Label="Current password" InputType="InputType.Password" @bind-Value="_current" Required="true" Class="mb-3" />
            <MudTextField T="string" Label="New password" InputType="InputType.Password" @bind-Value="_new" Required="true" Class="mb-3" />
            <MudTextField T="string" Label="Confirm new password" InputType="InputType.Password" @bind-Value="_confirm" Required="true" Class="mb-4" />
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnSubmit" Disabled="_busy">Change password</MudButton>
            </MudStack>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private string _current = string.Empty;
    private string _new = string.Empty;
    private string _confirm = string.Empty;
    private bool _busy;

    protected override void OnInitialized()
    {
        // Redirect if flag is not set
        if (!AccountApi.MustChangePassword)
            Nav.NavigateTo("/");
    }

    private async Task OnSubmit()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid) return;
        if (string.IsNullOrWhiteSpace(_current) || string.IsNullOrWhiteSpace(_new) || _new != _confirm)
        {
            Snackbar.Add("Password mismatch or missing fields", Severity.Error);
            return;
        }
        _busy = true;
        try
        {
            var ok = await AccountApi.ChangePasswordAsync(new VetManagement.Shared.Models.DTOs.ChangePasswordRequest
            {
                CurrentPassword = _current,
                NewPassword = _new
            });
            if (ok)
            {
                Snackbar.Add("Password changed successfully", Severity.Success);
                Nav.NavigateTo("/");
            }
            else
                Snackbar.Add("Could not change password", Severity.Error);
        }
        finally { _busy = false; }
    }
}

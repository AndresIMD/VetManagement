@page "/inventory-metrics"
@inject ItemsApiService ItemsService
@inject VetManagement.Shared.Services.Api.InventoryMovementApiService MovementService
@attribute [Authorize(Roles = "Admin,Manager,Employee")]
@using System.Globalization
@using VetManagement.Shared.Components.Filters
@using VetManagement.Shared.Constants
@using VetManagement.Shared.Enums
@using VetManagement.Shared.Models.Core
@using VetManagement.Shared.Models.Inventory
@using VetManagement.Shared.Services.Api

<PageTitle>Inventory Metrics</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mx-auto px-2 mt-8">
    <PageHeader Title="Inventory Metrics" Icon="@Icons.Material.Filled.ShowChart" />

    <MudPaper Class="pa-6 mb-4 elevation-3 rounded-lg app-surface">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudAutocomplete T="Item"
                                 @ref="_itemSelector"
                                 Label="Select items"
                                 Variant="Variant.Outlined"
                                 Value="_tempSelectedItem"
                                 ValueChanged="OnItemPicked"
                                 Clearable="true"
                                 CoerceText="true"
                                 ResetValueOnEmptyText="true"
                                 ToStringFunc="@(i => i is null ? string.Empty : i.Name)"
                                 SearchFunc="SearchItems"
                                 Dense="false"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.Inventory2" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Date="_from" DateChanged="OnFromChanged" Label="From" Variant="Variant.Outlined" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Date="_to" DateChanged="OnToChanged" Label="To" Variant="Variant.Outlined" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="12" md="6">
                <MudStack Row="true" Spacing="1">
                    <MudButton Variant="Variant.Outlined" Color="@MudBlazor.Color.Primary" OnClick="@(() => SetPreset(Preset.Today))">Today</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="@MudBlazor.Color.Primary" OnClick="@(() => SetPreset(Preset.Last7))">7 days</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="@MudBlazor.Color.Primary" OnClick="@(() => SetPreset(Preset.Last30))">30 days</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="@MudBlazor.Color.Primary" OnClick="@(() => SetPreset(Preset.Last12Months))">12 months</MudButton>
                </MudStack>
            </MudItem>
            <MudItem xs="12" md="3" Class="d-flex align-center">
                <MudStack Row="true" Spacing="1">
                    <MudButton Color="@MudBlazor.Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadChartAsync">Refresh</MudButton>
                    <MudButton Color="@MudBlazor.Color.Info" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DoneAll" OnClick="SelectAllAndLoad">All</MudButton>
                </MudStack>
            </MudItem>

            <MudItem xs="12">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.subtitle2">Selected items</MudText>
                    <MudButton Color="Color.Error" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ClearAll" Disabled="@(!_selectedItems.Any())" OnClick="@ClearAllSelected">Clear all</MudButton>
                </MudStack>

                <ActiveFilterChips Chips="@BuildSelectedChips()" />
                @if (!_selectedItems.Any())
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">No items selected.</MudText>
                }
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_loading || _selectedItems.Count == 0)
    {
        <MudSkeleton Height="400px" Width="100%" Animation="Animation.Wave" />
    }
    else if (_series.Count == 0 || _xAxisLabels.Length == 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true">No data to display.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4 mb-4 elevation-1 app-surface w-100" Style="width:100%">
            <MudChart T="double"
                      ChartType="ChartType.Line"
                      ChartSeries="@_series"
                      @bind-SelectedIndex="_selectedSeriesIndex"
                      XAxisLabels="@_xAxisLabels"
                      Width="100%"
                      Height="400px"
                      ChartOptions="@_chartOptions"
                      CanHideSeries />
        </MudPaper>
    }
</MudContainer>

@code {
    private List<Item> _allItems = new();
    private HashSet<Item> _selectedItems = new(new ItemComparer());
    private DateTime? _from = DateTime.Today.AddDays(-7);
    private DateTime? _to = DateTime.Today;
    private Grouping _grouping = Grouping.Day;
    private bool _loading = false;

    // Chart config
    private List<ChartSeries<double>> _series = new();
    private string[] _xAxisLabels = Array.Empty<string>();
    private int _selectedSeriesIndex = -1;
    private ChartOptions _chartOptions = new();

    // Autocomplete helper
    private Item? _tempSelectedItem;
    private MudAutocomplete<Item>? _itemSelector;

    protected override async Task OnInitializedAsync()
    {
        _allItems = await ItemsService.GetAllItemsAsync() ?? new();
    }

    private Task<IEnumerable<Item>> SearchItems(string value, CancellationToken _)
    {
        if (string.IsNullOrWhiteSpace(value)) return Task.FromResult(_allItems.AsEnumerable());
        value = value.Trim();
        var filtered = _allItems.Where(i =>
            (!string.IsNullOrWhiteSpace(i.Name) && i.Name.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
            (i is Drug d && !string.IsNullOrWhiteSpace(d.Compound) && d.Compound.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(i.Barcode) && i.Barcode.Contains(value, StringComparison.OrdinalIgnoreCase))
        );
        return Task.FromResult(filtered);
    }

    private async Task OnItemPicked(Item item)
    {
        _tempSelectedItem = null;
        if (item is null) { await InvokeAsync(StateHasChanged); return; }
        if (!_selectedItems.Any(i => i.Id == item.Id)) _selectedItems.Add(item);
        await LoadChartIfReadyAsync();
        _ = _itemSelector?.FocusAsync();
    }

    private async Task OnFromChanged(DateTime? date)
    {
        _from = date; await LoadChartIfReadyAsync();
    }

    private async Task OnToChanged(DateTime? date)
    {
        _to = date; await LoadChartIfReadyAsync();
    }

    private async Task LoadChartIfReadyAsync()
    {
        if (_selectedItems.Count > 0)
            await LoadChartAsync();
        else
        {
            _series.Clear(); _xAxisLabels = Array.Empty<string>();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SetPreset(Preset preset)
    {
        var today = DateTime.Today;
        switch (preset)
        {
            case Preset.Today: _from = today; _to = today; _grouping = Grouping.Hour; break;
            case Preset.Last7: _to = today; _from = today.AddDays(-6); _grouping = Grouping.Day; break;
            case Preset.Last30: _to = today; _from = today.AddDays(-29); _grouping = Grouping.Day; break;
            case Preset.Last12Months: _to = today; _from = today.AddMonths(-11); _grouping = Grouping.Month; break;
        }
        await LoadChartIfReadyAsync();
    }

    private async Task LoadChartAsync()
    {
        _loading = true; StateHasChanged();
        try
        {
            if (_selectedItems.Count == 0) { _series.Clear(); _xAxisLabels = Array.Empty<string>(); return; }

            var fromLocal = _from?.Date; var toLocal = _to?.Date;
            DateTime? fromUtc = fromLocal.HasValue ? DateTime.SpecifyKind(fromLocal.Value, DateTimeKind.Local).ToUniversalTime() : null;
            DateTime? toUtc = toLocal.HasValue ? DateTime.SpecifyKind(toLocal.Value.AddDays(1).AddTicks(-1), DateTimeKind.Local).ToUniversalTime() : null;

            var movements = await MovementService.GetMovementsFilteredAsync(null, null, null, null, fromUtc, toUtc) ?? new List<InventoryMovement>();
            var filtered = movements.Where(m => _selectedItems.Any(si => si.Id == m.ItemId)).ToList();

            BuildTimeSeries(filtered, fromLocal, toLocal, _grouping);
        }
        finally { _loading = false; await InvokeAsync(StateHasChanged); }
    }

    private void BuildTimeSeries(List<InventoryMovement> data, DateTime? from, DateTime? to, Grouping grouping)
    {
        var selectedIds = _selectedItems.Select(i => i.Id).ToList();
        if (selectedIds.Count == 0) { _series.Clear(); _xAxisLabels = Array.Empty<string>(); return; }

        var (start, end) = GetDateRange(from, to, grouping);

        var buckets = new List<DateTime>();
        if (grouping == Grouping.Hour)
        {
            var hourStart = start.Date;
            var hourEnd = end.Date == DateTime.Today ? DateTime.Today.AddHours(DateTime.Now.Hour) : end.Date.AddHours(23);
            var cur = hourStart; while (cur <= hourEnd) { buckets.Add(cur); cur = cur.AddHours(1); }
        }
        else
        {
            var cursor = start; while (cursor <= end)
            {
                buckets.Add(cursor); cursor = grouping switch
                { Grouping.Day => cursor.AddDays(1), Grouping.Week => cursor.AddDays(7), Grouping.Month => cursor.AddMonths(1), Grouping.Year => cursor.AddYears(1), _ => cursor.AddDays(1) };
            }
        }

        _xAxisLabels = buckets.Select(b => grouping switch
        {
            Grouping.Hour => b.ToString("H") + ":00",
            Grouping.Day => $"{b:dd}/{GenericConstants.MONTH_ABBREVIATIONS_ES[b.Month - 1]}",
            Grouping.Week => $"W{ISOWeek.GetWeekOfYear(b)} {b:yy}",
            Grouping.Month => GenericConstants.MONTH_ABBREVIATIONS_ES[b.Month - 1],
            Grouping.Year => b.ToString("yyyy"),
            _ => $"{b:dd}/{GenericConstants.MONTH_ABBREVIATIONS_ES[b.Month - 1]}"
        }).ToArray();

        var perItem = selectedIds.ToDictionary(id => id, _ => new double[buckets.Count]);
        foreach (var m in data)
        {
            if (!perItem.ContainsKey(m.ItemId)) continue;
            var idx = GetBucketIndex(m.Date, start, grouping); if (idx < 0 || idx >= buckets.Count) continue;
            if (m.Type == InventoryMovementType.Egress)
                perItem[m.ItemId][idx] += m.Quantity;
        }

        var ordered = _selectedItems.OrderBy(i => i.Name).Select(i => i.Id).ToList();
        _series = ordered.Select(id => new ChartSeries<double>
        {
            Name = GetItemName(id),
            Data = perItem[id]
        }).ToList();

        _selectedSeriesIndex = -1;
    }

    private static (DateTime start, DateTime end) GetDateRange(DateTime? from, DateTime? to, Grouping grouping)
    {
        var start = from ?? DateTime.Today.AddDays(-6);
        var end = to ?? DateTime.Today;
        if (end < start) (start, end) = (end, start);
        start = new DateTime(start.Year, start.Month, start.Day);
        end = new DateTime(end.Year, end.Month, end.Day);
        if (grouping == Grouping.Week)
        {
            start = StartOfIsoWeek(start);
            end = EndOfIsoWeek(end);
        }
        return (start, end);
    }

    private static int GetBucketIndex(DateTime date, DateTime start, Grouping grouping)
    {
        date = grouping == Grouping.Hour ? new DateTime(date.Year, date.Month, date.Day, date.Hour, 0, 0) : new DateTime(date.Year, date.Month, date.Day);
        return grouping switch
        {
            Grouping.Hour => (int)(date - start).TotalHours,
            Grouping.Day => (int)(date - start).TotalDays,
            Grouping.Week => (int)Math.Floor((date - start).TotalDays / 7),
            Grouping.Month => ((date.Year - start.Year) * 12) + date.Month - start.Month,
            Grouping.Year => date.Year - start.Year,
            _ => (int)(date - start).TotalDays
        };
    }

    private static DateTime StartOfIsoWeek(DateTime date)
    {
        int diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;
        return date.AddDays(-diff);
    }

    private static DateTime EndOfIsoWeek(DateTime date) => StartOfIsoWeek(date).AddDays(6);

    private async Task SelectAllAndLoad()
    {
        _selectedItems = new HashSet<Item>(_allItems, new ItemComparer());
        await LoadChartAsync();
        _ = _itemSelector?.FocusAsync();
    }

    private async Task RemoveItemFromSelection(int id)
    {
        var toRemove = _selectedItems.FirstOrDefault(i => i.Id == id);
        if (toRemove is not null) _selectedItems.Remove(toRemove);
        await LoadChartIfReadyAsync();
    }

    private async Task ClearAllSelected()
    {
        _selectedItems.Clear();
        await LoadChartAsync();
    }

    private IEnumerable<FilterChipModel> BuildSelectedChips()
        => _selectedItems.OrderBy(i => i.Name).Select(it => new FilterChipModel
            {
                Label = it.Name,
                Color = Color.Default,
                OnClear = async () => { await RemoveItemFromSelection(it.Id); }
            });

    private string GetItemName(int id) => _selectedItems.FirstOrDefault(i => i.Id == id)?.Name ?? $"Item {id}";

    private class ItemComparer : IEqualityComparer<Item>
    {
        public bool Equals(Item? x, Item? y) => x?.Id == y?.Id;
        public int GetHashCode(Item obj) => obj.Id.GetHashCode();
    }

    private enum Grouping { Hour, Day, Week, Month, Year }

    private enum Preset { Today, Last7, Last30, Last12Months }
}

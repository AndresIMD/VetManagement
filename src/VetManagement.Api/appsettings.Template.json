{
  "ConnectionStrings": {
    "DefaultConnection": "Server=<SERVER_NAME>;Database=VetManagement;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Key": "<GENERATE_RANDOM_32_CHAR_KEY>",
    "Issuer": "VetManagement.Api",
    "Audience": "VetManagement.Client",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "AllowedOrigins": [
    "https://localhost:7237",
    "http://localhost:5237"
  ],
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "User": "<YOUR_EMAIL@gmail.com>",
    "Pass": "<YOUR_APP_PASSWORD>",
    "From": "<YOUR_EMAIL@gmail.com>",
    "EnableSsl": true
  },
  "SeedAdmin": {
    "Enabled": true,
    "UserName": "admin",
    "Email": "admin@vetmanagement.com",
    "Password": "<SECURE_PASSWORD_10+_CHARS>"
  },
  "SeedTest": {
    "Enabled": true,
    "Manager": {
      "UserName": "manager",
      "Email": "manager@vetmanagement.com",
      "Password": "<SECURE_PASSWORD_10+_CHARS>"
    },
    "Employee": {
      "UserName": "employee",
      "Email": "employee@vetmanagement.com",
      "Password": "<SECURE_PASSWORD_10+_CHARS>"
    }
  },
  "Security": {
    "EnableHttpsRedirection": true,
    "EnableHsts": true,
    "HstsMaxAgeDays": 365,
    "RequireHttpsMetadata": true
  }
}

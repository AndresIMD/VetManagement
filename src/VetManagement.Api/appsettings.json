{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information",
      "Microsoft.AspNetCore.Http.Connections": "Information"
    }
  },
  "AllowedHosts": "*",
  "Https": {
    "Port": 7240
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5064"
      },
      "Https": {
        "Url": "https://localhost:44395"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "<CONNECTION_STRING>"
  },
  "Jwt": {
    "Key": "<JWT_KEY>",
    "Issuer": "<JWT_ISSUER>",
    "Audience": "<JWT_AUDIENCE>",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "AllowedOrigins": [
    "https://localhost:7237",
    "http://localhost:5237"
  ],
  "Smtp": {
    "Host": "<SMTP_HOST>",
    "Port": 587,
    "User": "<SMTP_USER>",
    "Pass": "<SMTP_PASSWORD>",
    "From": "<SMTP_FROM>",
    "EnableSsl": true
  },
  "SeedAdmin": {
    "Enabled": true,
    "UserName": "<ADMIN_USERNAME>",
    "Email": "<ADMIN_EMAIL>",
    "Password": "<ADMIN_PASSWORD>"
  },
  "Security": {
    "EnableHttpsRedirection": true,
    "EnableHsts": true,
    "HstsMaxAgeDays": 365,
    "RequireHttpsMetadata": true
  }
}

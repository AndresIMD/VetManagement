@inherits ModalBase<ExamPerformed>
@inject ExamPerformedApiService RequestsService
@inject ExamApiService ExamsService
@inject ExternalLabsApiService LabsService
@inject IDialogService DialogService

@using System.Text.Json
@using VetManagement.Shared.Enums
@using VetManagement.Shared.Models.Exams

<ModalShell Title="@Title"
            TitleIcon="@TitleIcon"
            TitleColor="@TitleColor"
            IsLoading="@_isLoading"
            IsValid="@_isValid"
            PrimaryText="Save"
            PrimaryLoadingText="Saving..."
            OnPrimaryClick="SaveAsync"
            OnCancelClick="OnCancelRequested">
    @if (_dataLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-4">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Color="Color.Secondary" Class="mt-2">Loading data...</MudText>
        </MudStack>
    }
    else
    {
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudStack Spacing="2">
                <MudGrid Class="mb-2">
                    <MudItem xs="12" sm="6"><MudTextField Label="Responsible" @bind-Value="_current.Responsible" Required="true" RequiredError="Responsible is required." /></MudItem>
                    <MudItem xs="12" sm="6"><MudNumericField T="int" Label="Pet ID" @bind-Value="_current.PatientId" Required="true" RequiredError="Pet ID is required." /></MudItem>
                </MudGrid>

                <MudPaper Class="pa-3 mb-2">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudSelect T="int" Label="Add Exam" Value="_selectedExamId" ValueChanged="OnExamSelectedAsync" Clearable="true" Disabled="@_dataLoading">
                            <MudSelectItem Value="0">Select...</MudSelectItem>
                            @foreach (var ex in _catalog)
                            {
                                <MudSelectItem Value="@ex.Id">@ex.Name (@ex.Brand - @ex.Machine)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudText Color="Color.Secondary">Exams added: @_current.Items.Count</MudText>
                    </MudStack>
                </MudPaper>

                <MudTable Items="@_current.Items" Dense="true" Hover="true" Bordered="true" Striped="true">
                    <HeaderContent>
                        <MudTh>Exam</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>External</MudTh>
                        <MudTh>Laboratory</MudTh>
                        <MudTh>ETA</MudTh>
                        <MudTh>Notes</MudTh>
                        <MudTh style="width:80px; text-align:right;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="it">
                        <MudTd DataLabel="Exam">@GetExamName(it.ExamId)</MudTd>
                        <MudTd DataLabel="Status">
                            <MudSelect T="ExamItemStatus" @bind-Value="it.Status">
                                @foreach (var st in Enum.GetValues<ExamItemStatus>())
                                {
                                    if (st == ExamItemStatus.None) continue;
                                    <MudSelectItem Value="@st">@st.ToString()</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd DataLabel="External">
                            <MudSwitch T="bool" @bind-Checked="it.IsExternal" Color="Color.Primary" />
                        </MudTd>
                        <MudTd DataLabel="Laboratory">
                            <MudSelect T="int?" @bind-Value="it.ExternalLabId" Disabled="@(!it.IsExternal)">
                                <MudSelectItem T="int?" Value="@((int?)null)">-</MudSelectItem>
                                @foreach (var lab in _labs)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)lab.Id)">@lab.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd DataLabel="ETA">
                            <MudNumericField T="int?" @bind-Value="it.ExternalEstimatedDays" Disabled="@(!it.IsExternal)" />
                        </MudTd>
                        <MudTd DataLabel="Notes">
                            <MudTextField T="string"
                                          Value="@GetNotesBuffer(it.ExamId)"
                                          ValueChanged="@((string v) => SetNotesBuffer(it.ExamId, v))"
                                          Placeholder="key=value;..." Immediate="false"
                                          OnBlur="@(async _ => await ApplyNotesAsync(it))" />
                        </MudTd>
                        <MudTd DataLabel="Actions" Class="text-end">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveItem(it))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudStack>
        </MudForm>
    }
</ModalShell>

@code {
    [Parameter] public ExamPerformed? Initial { get; set; }

    private ExamPerformed _current = new() { Items = new() };
    private List<Exam> _catalog = new();
    private List<ExternalLab> _labs = new();

    private int _selectedExamId;
    private readonly Dictionary<int, string> _notesBuffers = new();
    private bool _dataLoading = true;
    private string _initialSnapshot = string.Empty;
    private MudForm? _form;
    private bool _isValid;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        _catalog = await ExamsService.GetAllExamsAsync() ?? new();
        _labs = await LabsService.GetAllAsync() ?? new();

        if (Initial != null)
        {
            _current = new ExamPerformed
            {
                Id = Initial.Id,
                PatientId = Initial.PatientId,
                Responsible = Initial.Responsible,
                Date = Initial.Date,
                Items = Initial.Items?.Select(x => new ExamRequestItem
                {
                    Id = x.Id,
                    ExamId = x.ExamId,
                    Status = x.Status,
                    IsExternal = x.IsExternal,
                    ExternalLabId = x.ExternalLabId,
                    ExternalEstimatedDays = x.ExternalEstimatedDays,
                    Attributes = new Dictionary<string, string>(x.Attributes)
                }).ToList() ?? new()
            };
        }
        else
        {
            _current = new ExamPerformed { Date = DateTime.UtcNow, Items = new() };
        }
        _initialSnapshot = JsonSerializer.Serialize(_current);
        _dataLoading = false;
    }

    private async Task SaveAsync()
    {
        try
        {
            _isLoading = true;
            if (_form != null)
            {
                await _form.Validate();
                if (!_form.IsValid)
                {
                    _isLoading = false;
                    return;
                }
            }
            foreach (var item in _current.Items)
            {
                if (!item.IsExternal || item.ExternalLabId != null) continue;
                Snackbar.Add("An external lab must be selected for external exams.", Severity.Warning);
                _isLoading = false;
                return;
            }

            if (_current.Id == 0)
            {
                await RequestsService.AddAsync(_current);
                Snackbar.Add("Request created.", Severity.Success);
            }
            else
            {
                await RequestsService.UpdateAsync(_current);
                Snackbar.Add("Request updated.", Severity.Success);
            }
            MudDialog.Close(DialogResult.Ok(_current));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving request: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnCancelRequested()
    {
        var hasItems = _current.Items?.Count > 0;
        var hasHeaderData = _current.PatientId != 0 || !string.IsNullOrWhiteSpace(_current.Responsible);
        if (!hasItems && !hasHeaderData)
        {
            OnCancel();
            return;
        }

        var current = JsonSerializer.Serialize(_current);
        if (!string.Equals(current, _initialSnapshot, StringComparison.Ordinal))
        {
            var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = false };
            var parameters = new DialogParameters<Components.Modals.Common.ConfirmModal>
            {
                { x => x.Title, "Discard Changes" },
                { x => x.Message, "There are unsaved changes. Do you want to exit without saving?" },
                { x => x.ButtonConfirmText, "Exit" },
                { x => x.ButtonCancelText, "Keep Editing" },
                { x => x.TitleIcon, Icons.Material.Filled.Warning },
                { x => x.TitleColor, Color.Warning }
            };
            var dialog = await DialogService.ShowAsync<Components.Modals.Common.ConfirmModal>(null, parameters, options);
            var result = await dialog.Result;
            if (result is { Canceled: true })
                return;
        }
        OnCancel();
    }

    private async Task OnExamSelectedAsync(int examId)
    {
        await AddExamItem(examId);
        _selectedExamId = 0;
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddExamItem(int examId)
    {
        if (examId <= 0) return;
        var exists = _current.Items.Any(i => i.ExamId == examId);
        if (!exists)
        {
            _current.Items.Add(new ExamRequestItem { ExamId = examId, Status = ExamItemStatus.Pending, Attributes = new Dictionary<string, string>() });
        }
        await InvokeAsync(StateHasChanged);
    }

    private void RemoveItem(ExamRequestItem it)
    {
        _current.Items.Remove(it);
        _notesBuffers.Remove(it.ExamId);
    }

    private string GetExamName(int id) => _catalog.FirstOrDefault(x => x.Id == id)?.Name ?? $"#{id}";

    private string GetNotesBuffer(int examId)
        => _notesBuffers.TryGetValue(examId, out var value) ? value : string.Empty;

    private void SetNotesBuffer(int examId, string value)
        => _notesBuffers[examId] = value;

    private async Task ApplyNotesAsync(ExamRequestItem it)
    {
        var examId = it.ExamId;
        if (_notesBuffers.TryGetValue(examId, out var buffer) && !string.IsNullOrWhiteSpace(buffer))
        {
            var pairs = buffer.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            foreach (var p in pairs)
            {
                var kv = p.Split('=', 2, StringSplitOptions.TrimEntries);
                if (kv.Length != 2) continue;
                it.Attributes[kv[0]] = kv[1];
            }
            _notesBuffers.Remove(examId);
        }
        await InvokeAsync(StateHasChanged);
    }
}

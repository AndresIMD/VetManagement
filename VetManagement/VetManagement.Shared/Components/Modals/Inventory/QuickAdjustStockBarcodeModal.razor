@using VetManagement.Shared.Services.Api
@inherits ModalBase<object>
@inject ItemsApiService ItemsApiService
@inject IDialogService DialogService

<ModalShell Title="@Title"
            TitleIcon="@TitleIcon"
            TitleColor="@TitleColor"
            IsLoading="false"
            IsValid="true"
            FooterContent="@Footer">
    <MudStack Spacing="2">
        <MudGrid>
            <MudItem xs="12" md="10">
                <MudTextField @ref="barcodeInput"
                              Label="Scan or enter the barcode"
                              @bind-Value="barcode"
                              Immediate="true"
                              OnKeyDown="OnBarcodeKeyDown"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.QrCodeScanner" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center justify-end">
                <MudTooltip Text="Clear">
                    <MudIconButton Icon="@Icons.Material.Filled.Clear" Color="Color.Secondary" Variant="Variant.Outlined" OnClick="Clear" Disabled="@string.IsNullOrEmpty(barcode)" />
                </MudTooltip>
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@errorMessage</MudAlert>
        }
    </MudStack>
</ModalShell>

@code {
    private MudTextField<string>? barcodeInput;
    private string barcode = string.Empty;
    private string? errorMessage;
    protected bool shouldFocusBarcode = true;

    private RenderFragment Footer => __builder =>
    {
        <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="OnCancelRequested">Cancel</MudButton>;
    };

    private async Task OnBarcodeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(barcode))
        {
            var item = await ItemsApiService.GetItemByBarcodeAsync(barcode);
            if (item == null)
            {
                errorMessage = $"No item found with the barcode '{barcode}'.";

                await Clear();
                return;
            }
            MudDialog.Close(DialogResult.Ok(item));
        }
    }

    private async Task Clear()
    {
        barcode = string.Empty;
        shouldFocusBarcode = true;
        StateHasChanged();
        await Task.Yield();
        if (barcodeInput is not null)
            await barcodeInput.FocusAsync();
    }

    private async Task OnCancelRequested()
    {
        if (string.IsNullOrWhiteSpace(barcode))
        {
            OnCancel();
            return;
        }

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = false };
        var parameters = new DialogParameters<Components.Modals.Common.ConfirmModal>
        {
            { x => x.Title, "Discard changes" },
            { x => x.Message, "There are unsaved changes. Do you want to exit without saving?" },
            { x => x.ButtonConfirmText, "Exit" },
            { x => x.ButtonCancelText, "Keep editing" },
            { x => x.TitleIcon, Icons.Material.Filled.Warning },
            { x => x.TitleColor, Color.Warning }
        };
        var dialog = await DialogService.ShowAsync<Components.Modals.Common.ConfirmModal>(null, parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: true })
            return;
        OnCancel();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldFocusBarcode && barcodeInput is not null)
        {
            shouldFocusBarcode = false;
            await barcodeInput.FocusAsync();
        }
    }
}

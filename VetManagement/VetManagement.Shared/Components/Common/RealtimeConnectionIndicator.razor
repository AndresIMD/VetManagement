@using VetManagement.Shared.Services.Realtime
@using Microsoft.AspNetCore.Components.Authorization
@inject RealtimeService RealtimeService
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

@if (_isConnected)
{
    <MudChip T="string" Icon="@Icons.Material.Filled.CloudDone" Color="Color.Success" Size="Size.Small">Live</MudChip>
}
else if (_isConnecting)
{
    <MudChip T="string" Icon="@Icons.Material.Filled.CloudSync" Color="Color.Warning" Size="Size.Small">Connecting...</MudChip>
}
else
{
    <MudChip T="string" Icon="@Icons.Material.Filled.CloudOff" Color="Color.Error" Size="Size.Small">Offline</MudChip>
}

@code {
    private bool _isConnected;
    private bool _isConnecting;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        await CheckAndConnectAsync();
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        await CheckAndConnectAsync();
    }

    private async Task CheckAndConnectAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated == true && !RealtimeService.IsConnected)
        {
            _isConnecting = true;
            await InvokeAsync(StateHasChanged);

            try
            {
                await RealtimeService.InitializeAsync();
                _isConnected = RealtimeService.IsConnected;
            }
            catch
            {
                _isConnected = false;
            }
            finally
            {
                _isConnecting = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        else if (user?.Identity?.IsAuthenticated != true)
        {
            await RealtimeService.DisconnectAsync();
            _isConnected = false;
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            _isConnected = RealtimeService.IsConnected;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}
